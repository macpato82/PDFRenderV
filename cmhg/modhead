title-string:  PDFRenderV

help-string:   PDFRenderV 1.00 Fast PDF page renderer

; *** PLACEHOLDER CHUNK *** - must be replaced with a SWI chunk
; allocated by RISC OS Open (see the allocating-resources skill)
; before any public release.  &5B740 is a guess and may collide.
swi-chunk-base-number:  &05B740

swi-handler-code:       mod_swi
; Offsets 0..4, matching SWIOFF_* in h/module.
swi-decoding-table:     PDFRenderV Open, Close, Info, PageSize, Render,
                        ExtractText

initialisation-code:    mod_init
finalisation-code:      mod_final

; Service_StartWimp (&49) is issued as the desktop starts, after the
; !Boot of every application has run.  We re-assert our filetype
; claims there because an app booted after us (ChangeFSI claims JPEG,
; for one) would otherwise silently take them back.
service-call-handler:   mod_service &49

; NOTE: the viewer is a separate absolute application (aif.Viewer,
; built from c/viewapp) started via Alias$@RunType_ADF.  It was
; originally in-module via module-is-runnable, but entering an RMA
; module as an application dies inside Wimp_Initialise on the Kinetic
; Box RO5.31 softload (a clean-room minimal module reproduces it), so
; the window/toolbar half lives in a plain application instead.

; *** PLACEHOLDER ERROR CHUNK *** - allocate with ROOL before release.
error-base:             &81B740
error-identifiers:      err_Already("PDFRenderV is already loaded - *RMKill PDFRenderV first"),
                        err_BadHandle("PDFRenderV: bad document handle"),
                        err_BadPage("PDFRenderV: no such page"),
                        err_NoMem("PDFRenderV: out of memory"),
                        err_BadPDF("PDFRenderV: not a valid PDF"),
                        err_Encrypted("PDFRenderV: this PDF needs a password"),
                        err_Unsup("PDFRenderV: PDF uses an unsupported feature"),
                        err_BadSWI("PDFRenderV: unknown SWI"),
                        err_Syntax("Syntax: *PDFToSprite <pdf> <page> <spritefile> [<width px>]")

command-keyword-table:  cmd_handler
        PDFInfo(min-args: 1, max-args: 1,
                help-text: "*PDFInfo reports the version, page count and page sizes of a PDF.\n",
                invalid-syntax: "Syntax: *PDFInfo <pdffile>"),
        PDFToSprite(min-args: 3, max-args: 4,
                help-text: "*PDFToSprite renders a PDF page into a new sprite file.\n",
                invalid-syntax: "Syntax: *PDFToSprite <pdf> <page> <spritefile> [<width px>]"),
        PDFText(min-args: 2, max-args: 3,
                help-text: "*PDFText extracts the text of a page to a file (or the screen).\n",
                invalid-syntax: "Syntax: *PDFText <pdf> <page> [<textfile>]"),
        PDFClaim(min-args: 0, max-args: 0,
                help-text: "*PDFClaim (re)claims the filetypes in PDFRenderV$Claim for the viewer. Useful when an application booted later has taken one back.\n"),
        PDFRenderVOpen(min-args: 1, max-args: 7,
                help-text: "*PDFRenderVOpen opens a PDF in the desktop viewer (the application named by PDFRenderV$Viewer). Double-clicking a PDF does this automatically once the module is loaded.\n",
                invalid-syntax: "Syntax: *PDFRenderVOpen <pdffile>")
