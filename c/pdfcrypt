/* --- little helpers --------------------------------------------------- */

static u32
rol32(u32 x, int n)
{
    return (x << n) | (x >> (32 - n));
}

static u32
ror32(u32 x, int n)
{
    return (x >> n) | (x << (32 - n));
}

static u64
ror64(u64 x, int n)
{
    return (x >> n) | (x << (64 - n));
}

static u32
ld32le(const u8 *p)
{
    return (u32) p[0] | ((u32) p[1] << 8) |
           ((u32) p[2] << 16) | ((u32) p[3] << 24);
}

static void
st32le(u8 *p, u32 v)
{
    p[0] = (u8) v;
    p[1] = (u8) (v >> 8);
    p[2] = (u8) (v >> 16);
    p[3] = (u8) (v >> 24);
}

static u32
ld32be(const u8 *p)
{
    return ((u32) p[0] << 24) | ((u32) p[1] << 16) |
           ((u32) p[2] << 8) | (u32) p[3];
}

static void
st32be(u8 *p, u32 v)
{
    p[0] = (u8) (v >> 24);
    p[1] = (u8) (v >> 16);
    p[2] = (u8) (v >> 8);
    p[3] = (u8) v;
}

static u64
ld64be(const u8 *p)
{
    return ((u64) ld32be(p) << 32) | (u64) ld32be(p + 4);
}

static void
st64be(u8 *p, u64 v)
{
    st32be(p, (u32) (v >> 32));
    st32be(p + 4, (u32) v);
}

/* constant-time-ish compare: no early exit on the first difference     */
static int
same(const u8 *a, const u8 *b, u32 n)
{
    u32 i;
    u8 diff = 0;

    for (i = 0; i < n; i++) {
        diff |= (u8) (a[i] ^ b[i]);
    }
    return diff == 0;
}

