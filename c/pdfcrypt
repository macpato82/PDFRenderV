/* The padding string from ISO 32000-1, Algorithm 2 step (a).         */
static const u8 pdf_pad[32] = {
    0x28, 0xBF, 0x4E, 0x5E, 0x4E, 0x75, 0x8A, 0x41,
    0x64, 0x00, 0x4E, 0x56, 0xFF, 0xFA, 0x01, 0x08,
    0x2E, 0x2E, 0x00, 0xB6, 0xD0, 0x68, 0x3E, 0x80,
    0x2F, 0x0C, 0xA9, 0xFE, 0x64, 0x53, 0x69, 0x7A
};

/* Algorithm 2: the file key for an empty user password, R2-4.        */
static void
key_r234(PdfCrypt *c, const u8 *o, s32 p, const u8 *id0, u32 id0len,
         int encrypt_metadata)
{
    PdfMd5Ctx md;
    u8 digest[16], pbuf[4];
    int i;

    pdfmd5_init(&md);
    pdfmd5_update(&md, pdf_pad, 32);        /* empty password padded  */
    pdfmd5_update(&md, o, 32);
    st32le(pbuf, (u32) p);
    pdfmd5_update(&md, pbuf, 4);
    if (id0len != 0) {
        pdfmd5_update(&md, id0, id0len);
    }
    if (c->r >= 4 && !encrypt_metadata) {
        static const u8 ff[4] = { 0xFF, 0xFF, 0xFF, 0xFF };

        pdfmd5_update(&md, ff, 4);
    }
    pdfmd5_final(&md, digest);
    if (c->r >= 3) {
        for (i = 0; i < 50; i++) {
            pdfmd5(digest, (u32) c->keylen, digest);
        }
    }
    memcpy(c->key, digest, (u32) c->keylen);
}

/* Algorithm 6 / 4 / 5: does the empty user password check out?       */
static int
check_user_r234(const PdfCrypt *c, const u8 *u, u32 ulen,
                const u8 *id0, u32 id0len)
{
    u8 want[32];

    if (c->r == 2) {
        pdfrc4(c->key, (u32) c->keylen, pdf_pad, 32, want);
        return ulen >= 32 && same(want, u, 32);
    } else {
        PdfMd5Ctx md;
        u8 digest[16];
        int i;

        pdfmd5_init(&md);
        pdfmd5_update(&md, pdf_pad, 32);
        if (id0len != 0) {
            pdfmd5_update(&md, id0, id0len);
        }
        pdfmd5_final(&md, digest);
        pdfrc4(c->key, (u32) c->keylen, digest, 16, want);
        for (i = 1; i <= 19; i++) {
            u8 k[16];
            int j;

            for (j = 0; j < c->keylen; j++) {
                k[j] = (u8) (c->key[j] ^ i);
            }
            pdfrc4(k, (u32) c->keylen, want, 16, want);
        }
        /* only the first 16 bytes are meaningful; the rest is padding */
        return ulen >= 16 && same(want, u, 16);
    }
}

/* Algorithm 2.B: the R6 hardened hash.  For R5 this degenerates to a
   single SHA-256, which the caller handles separately.              */
static int
hash_2b(const u8 *pwd, u32 pwdlen, const u8 *salt, u32 saltlen,
        const u8 *udata, u32 udatalen, u8 out[32])
{
    u8 k[64], e[64 * 64], k1[64 * 64];
    u32 klen = 32, k1len;
    int round, err;

    {
        PdfSha256Ctx sh;

        pdfsha256_init(&sh);
        pdfsha256_update(&sh, pwd, pwdlen);
        pdfsha256_update(&sh, salt, saltlen);
        if (udatalen != 0) {
            pdfsha256_update(&sh, udata, udatalen);
        }
        pdfsha256_final(&sh, k);
    }

    for (round = 0; ; round++) {
        u32 one = pwdlen + klen + udatalen;
        u32 i, sum = 0;

        if (one * 64 > sizeof k1) {
            return PDF_E_DATA;              /* absurd password length */
        }
        k1len = 0;
        for (i = 0; i < 64; i++) {
            memcpy(k1 + k1len, pwd, pwdlen);
            k1len += pwdlen;
            memcpy(k1 + k1len, k, klen);
            k1len += klen;
            if (udatalen != 0) {
                memcpy(k1 + k1len, udata, udatalen);
                k1len += udatalen;
            }
        }
        err = aes_cbc_encrypt_nopad(k, 16, k + 16, k1, k1len, e);
        if (err != PDF_OK) {
            return err;
        }
        for (i = 0; i < 16; i++) {
            sum += e[i];
        }
        switch (sum % 3) {
        case 0:
            pdfsha256(e, k1len, k);
            klen = 32;
            break;
        case 1:
            pdfsha384(e, k1len, k);
            klen = 48;
            break;
        default:
            pdfsha512(e, k1len, k);
            klen = 64;
            break;
        }
        /* at least 64 rounds, then stop once the last byte of E is
           no greater than round number - 32                         */
        if (round >= 63 && e[k1len - 1] <= (u8) (round + 1 - 32)) {
            break;
        }
    }
    memcpy(out, k, 32);
    return PDF_OK;
}

/* Algorithms 2.A / 2.B: AES-256, R5 and R6.                          */
static int
key_r56(PdfCrypt *c, const u8 *u, u32 ulen, const u8 *ue, u32 uelen)
{
    const u8 *vsalt = u + 32;
    const u8 *ksalt = u + 40;
    u8 hash[32], ikey[32], zero[16];
    int err;

    if (ulen < 48) {
        return PDF_E_DATA;
    }
    if (c->r == 5) {
        PdfSha256Ctx sh;

        pdfsha256_init(&sh);
        pdfsha256_update(&sh, vsalt, 8);    /* empty password first   */
        pdfsha256_final(&sh, hash);
    } else {
        err = hash_2b((const u8 *) "", 0, vsalt, 8, NULL, 0, hash);
        if (err != PDF_OK) {
            return err;
        }
    }
    if (!same(hash, u, 32)) {
        return PDF_E_ENCRYPTED;             /* a real password needed */
    }
    if (uelen < 32) {
        return PDF_E_DATA;
    }
    if (c->r == 5) {
        PdfSha256Ctx sh;

        pdfsha256_init(&sh);
        pdfsha256_update(&sh, ksalt, 8);
        pdfsha256_final(&sh, ikey);
    } else {
        err = hash_2b((const u8 *) "", 0, ksalt, 8, NULL, 0, ikey);
        if (err != PDF_OK) {
            return err;
        }
    }
    memset(zero, 0, sizeof zero);
    err = pdfaes_cbc_decrypt_nopad(ikey, 32, zero, ue, 32, c->key);
    if (err != PDF_OK) {
        return err;
    }
    c->keylen = 32;
    return PDF_OK;
}

int
pdfcrypt_setup(PdfCrypt *c, int v, int r, int length, int cfm,
               const u8 *o, u32 olen, const u8 *u, u32 ulen,
               const u8 *oe, u32 oelen, const u8 *ue, u32 uelen,
               s32 p, const u8 *id0, u32 id0len, int encrypt_metadata)
{
    (void) oe;
    (void) oelen;

    memset(c, 0, sizeof *c);
    c->v = v;
    c->r = r;
    c->metadata = encrypt_metadata;

    if (v == 5 || r == 5 || r == 6) {
        int err;

        if (r != 5 && r != 6) {
            return PDF_E_UNSUP;
        }
        c->aes = PDFCRYPT_CFM_AESV3;
        err = key_r56(c, u, ulen, ue, uelen);
        if (err != PDF_OK) {
            return err;
        }
        c->ok = 1;
        return PDF_OK;
    }

    if (r < 2 || r > 4) {
        return PDF_E_UNSUP;
    }
    if (v == 1) {
        c->keylen = 5;
        c->aes = PDFCRYPT_CFM_RC4;
    } else if (v == 2 || v == 4) {
        c->keylen = (length > 0) ? length / 8 : 5;
        if (c->keylen < 5 || c->keylen > 16) {
            return PDF_E_UNSUP;
        }
        c->aes = (v == 4) ? cfm : PDFCRYPT_CFM_RC4;
    } else {
        return PDF_E_UNSUP;                 /* /V 0 or 3              */
    }
    if (c->aes == PDFCRYPT_CFM_NONE || c->aes == PDFCRYPT_CFM_AESV3) {
        return PDF_E_UNSUP;
    }
    if (c->aes == PDFCRYPT_CFM_AESV2) {
        c->keylen = 16;                     /* AESV2 is always 128bit */
    }
    if (olen < 32 || ulen < 32) {
        return PDF_E_DATA;
    }
    key_r234(c, o, p, id0, id0len, encrypt_metadata);
    if (!check_user_r234(c, u, ulen, id0, id0len)) {
        return PDF_E_ENCRYPTED;
    }
    c->ok = 1;
    return PDF_OK;
}

/* Algorithm 1: the per-object key for R2-4.                          */
static void
object_key(const PdfCrypt *c, u32 objnum, u32 gennum, u8 *key, u32 *keylen)
{
    u8 buf[16 + 5 + 4], digest[16];
    u32 n = (u32) c->keylen;
    u32 len = 0;

    memcpy(buf, c->key, n);
    len = n;
    buf[len++] = (u8) objnum;
    buf[len++] = (u8) (objnum >> 8);
    buf[len++] = (u8) (objnum >> 16);
    buf[len++] = (u8) gennum;
    buf[len++] = (u8) (gennum >> 8);
    if (c->aes == PDFCRYPT_CFM_AESV2) {
        buf[len++] = 0x73;                  /* "sAlT"                 */
        buf[len++] = 0x41;
        buf[len++] = 0x6C;
        buf[len++] = 0x54;
    }
    pdfmd5(buf, len, digest);
    *keylen = (n + 5 > 16) ? 16 : n + 5;
    memcpy(key, digest, *keylen);
}

int
pdfcrypt_decrypt(const PdfCrypt *c, u32 objnum, u32 gennum,
                 const u8 *in, u32 len, u8 *out, u32 *outlen)
{
    u8 key[16];
    u32 keylen;

    *outlen = 0;
    if (c == NULL || !c->ok) {
        return PDF_E_DATA;
    }
    if (c->aes == PDFCRYPT_CFM_AESV3) {
        return pdfaes_cbc_decrypt(c->key, 32, in, len, out, outlen);
    }
    object_key(c, objnum, gennum, key, &keylen);
    if (c->aes == PDFCRYPT_CFM_AESV2) {
        return pdfaes_cbc_decrypt(key, keylen, in, len, out, outlen);
    }
    pdfrc4(key, keylen, in, len, out);
    *outlen = len;
    return PDF_OK;
}
