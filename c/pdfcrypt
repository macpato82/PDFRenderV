    0x6fa87e4fu, 0xfe2ce6e0u, 0xa3014314u, 0x4e0811a1u,
    0xf7537e82u, 0xbd3af235u, 0x2ad7d2bbu, 0xeb86d391u
};

static void
md5_block(PdfMd5Ctx *ctx, const u8 *p)
{
    u32 m[16], a = ctx->a, b = ctx->b, c = ctx->c, d = ctx->d;
    int i;

    for (i = 0; i < 16; i++) {
        m[i] = ld32le(p + i * 4);
    }
    for (i = 0; i < 64; i++) {
        u32 f;
        int g;

        if (i < 16) {
            f = (b & c) | (~b & d);
            g = i;
        } else if (i < 32) {
            f = (d & b) | (~d & c);
            g = (5 * i + 1) & 15;
        } else if (i < 48) {
            f = b ^ c ^ d;
            g = (3 * i + 5) & 15;
        } else {
            f = c ^ (b | ~d);
            g = (7 * i) & 15;
        }
        f += a + md5_k[i] + m[g];
        a = d;
        d = c;
        c = b;
        b += rol32(f, md5_s[i]);
    }
    ctx->a += a;
    ctx->b += b;
    ctx->c += c;
    ctx->d += d;
}

void
pdfmd5_init(PdfMd5Ctx *ctx)
{
    ctx->a = 0x67452301u;
    ctx->b = 0xefcdab89u;
    ctx->c = 0x98badcfeu;
    ctx->d = 0x10325476u;
    ctx->len = 0;
    ctx->buflen = 0;
}

void
pdfmd5_update(PdfMd5Ctx *ctx, const u8 *data, u32 len)
{
    ctx->len += len;
    if (ctx->buflen != 0) {
        u32 need = 64 - ctx->buflen;

        if (len < need) {
            memcpy(ctx->buf + ctx->buflen, data, len);
            ctx->buflen += len;
            return;
        }
        memcpy(ctx->buf + ctx->buflen, data, need);
        md5_block(ctx, ctx->buf);
        ctx->buflen = 0;
        data += need;
        len -= need;
    }
    while (len >= 64) {
        md5_block(ctx, data);
        data += 64;
        len -= 64;
    }
    if (len != 0) {
        memcpy(ctx->buf, data, len);
        ctx->buflen = len;
    }
}

void
pdfmd5_final(PdfMd5Ctx *ctx, u8 out[16])
{
    u64 bits = ctx->len * 8;
    u8 pad[72];
    u32 padlen;

    memset(pad, 0, sizeof pad);
    pad[0] = 0x80;
    padlen = (ctx->buflen < 56) ? (56 - ctx->buflen)
                                : (120 - ctx->buflen);
    st32le(pad + padlen, (u32) bits);
    st32le(pad + padlen + 4, (u32) (bits >> 32));
    pdfmd5_update(ctx, pad, padlen + 8);
    st32le(out, ctx->a);
    st32le(out + 4, ctx->b);
    st32le(out + 8, ctx->c);
    st32le(out + 12, ctx->d);
}

void
pdfmd5(const u8 *data, u32 len, u8 out[16])
{
    PdfMd5Ctx ctx;

    pdfmd5_init(&ctx);
    pdfmd5_update(&ctx, data, len);
    pdfmd5_final(&ctx, out);
}

