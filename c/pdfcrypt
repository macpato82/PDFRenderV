    pdfsha512_final(&ctx, out);
}

/* --- RC4 --------------------------------------------------------------- */

void
pdfrc4(const u8 *key, u32 keylen, const u8 *in, u32 len, u8 *out)
{
    u8 s[256];
    u32 i, x = 0, y = 0;

    if (keylen == 0) {
        if (out != in) {
            memcpy(out, in, len);
        }
        return;
    }
    for (i = 0; i < 256; i++) {
        s[i] = (u8) i;
    }
    for (i = 0; i < 256; i++) {
        u8 t;

        y = (y + s[i] + key[i % keylen]) & 0xFF;
        t = s[i];
        s[i] = s[y];
        s[y] = t;
    }
    x = 0;
    y = 0;
    for (i = 0; i < len; i++) {
        u8 t;

        x = (x + 1) & 0xFF;
        y = (y + s[x]) & 0xFF;
        t = s[x];
        s[x] = s[y];
        s[y] = t;
        out[i] = (u8) (in[i] ^ s[(s[x] + s[y]) & 0xFF]);
    }
}

