void
pdfsha512_update(PdfSha512Ctx *ctx, const u8 *data, u32 len)
{
    ctx->len += len;
    if (ctx->buflen != 0) {
        u32 need = 128 - ctx->buflen;

        if (len < need) {
            memcpy(ctx->buf + ctx->buflen, data, len);
            ctx->buflen += len;
            return;
        }
        memcpy(ctx->buf + ctx->buflen, data, need);
        sha512_block(ctx, ctx->buf);
        ctx->buflen = 0;
        data += need;
        len -= need;
    }
    while (len >= 128) {
        sha512_block(ctx, data);
        data += 128;
        len -= 128;
    }
    if (len != 0) {
        memcpy(ctx->buf, data, len);
        ctx->buflen = len;
    }
