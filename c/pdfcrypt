    0x00, 0x01, 0x02, 0x04, 0x08, 0x10, 0x20, 0x40, 0x80, 0x1B, 0x36
};

static u8
xtime(u8 x)
{
    return (u8) ((x << 1) ^ ((x & 0x80) ? 0x1B : 0x00));
}

/* multiply in GF(2^8) - only the small constants the cipher needs    */
static u8
gmul(u8 a, u8 b)
{
    u8 r = 0;
    int i;

    for (i = 0; i < 8; i++) {
        if (b & 1) {
            r ^= a;
        }
        a = xtime(a);
        b >>= 1;
    }
    return r;
}

int
pdfaes_setkey(PdfAesKey *ks, const u8 *key, u32 keylen)
{
    u32 nk, i, total;

    if (keylen == 16) {
        nk = 4; ks->nr = 10;
    } else if (keylen == 24) {
        nk = 6; ks->nr = 12;
    } else if (keylen == 32) {
        nk = 8; ks->nr = 14;
    } else {
        return PDF_E_UNSUP;
    }
    for (i = 0; i < nk; i++) {
        ks->rk[i] = ld32be(key + i * 4);
    }
    total = 4u * ((u32) ks->nr + 1u);
    for (i = nk; i < total; i++) {
        u32 t = ks->rk[i - 1];

        if (i % nk == 0) {
            t = (t << 8) | (t >> 24);           /* RotWord            */
            t = ((u32) aes_sbox[(t >> 24) & 0xFF] << 24) |
                ((u32) aes_sbox[(t >> 16) & 0xFF] << 16) |
                ((u32) aes_sbox[(t >> 8) & 0xFF] << 8) |
                ((u32) aes_sbox[t & 0xFF]);
            t ^= (u32) aes_rcon[i / nk] << 24;
        } else if (nk > 6 && i % nk == 4) {
            t = ((u32) aes_sbox[(t >> 24) & 0xFF] << 24) |
                ((u32) aes_sbox[(t >> 16) & 0xFF] << 16) |
                ((u32) aes_sbox[(t >> 8) & 0xFF] << 8) |
                ((u32) aes_sbox[t & 0xFF]);
        }
        ks->rk[i] = ks->rk[i - nk] ^ t;
    }
    return PDF_OK;
}

static void
add_round_key(u8 st[16], const u32 *rk)
{
    int c;

    for (c = 0; c < 4; c++) {
        u32 k = rk[c];

        st[c * 4 + 0] ^= (u8) (k >> 24);
        st[c * 4 + 1] ^= (u8) (k >> 16);
        st[c * 4 + 2] ^= (u8) (k >> 8);
        st[c * 4 + 3] ^= (u8) k;
    }
}

void
pdfaes_ecb_encrypt(const PdfAesKey *ks, const u8 in[16], u8 out[16])
{
    u8 st[16];
    int r, c, i;

    memcpy(st, in, 16);
    add_round_key(st, ks->rk);
    for (r = 1; r <= ks->nr; r++) {
        u8 t[16];

        for (i = 0; i < 16; i++) {
            st[i] = aes_sbox[st[i]];
        }
        /* ShiftRows: row n rotates left by n (column-major state)    */
        for (c = 0; c < 4; c++) {
            t[c * 4 + 0] = st[c * 4 + 0];
            t[c * 4 + 1] = st[((c + 1) & 3) * 4 + 1];
            t[c * 4 + 2] = st[((c + 2) & 3) * 4 + 2];
            t[c * 4 + 3] = st[((c + 3) & 3) * 4 + 3];
        }
        if (r != ks->nr) {
            for (c = 0; c < 4; c++) {
                u8 a0 = t[c * 4 + 0], a1 = t[c * 4 + 1];
                u8 a2 = t[c * 4 + 2], a3 = t[c * 4 + 3];

                st[c * 4 + 0] = (u8) (xtime(a0) ^ (xtime(a1) ^ a1) ^ a2 ^ a3);
                st[c * 4 + 1] = (u8) (a0 ^ xtime(a1) ^ (xtime(a2) ^ a2) ^ a3);
                st[c * 4 + 2] = (u8) (a0 ^ a1 ^ xtime(a2) ^ (xtime(a3) ^ a3));
                st[c * 4 + 3] = (u8) ((xtime(a0) ^ a0) ^ a1 ^ a2 ^ xtime(a3));
            }
        } else {
            memcpy(st, t, 16);
        }
        add_round_key(st, ks->rk + r * 4);
    }
    memcpy(out, st, 16);
}

void
pdfaes_ecb_decrypt(const PdfAesKey *ks, const u8 in[16], u8 out[16])
{
    u8 st[16];
    int r, c, i;

    memcpy(st, in, 16);
    add_round_key(st, ks->rk + ks->nr * 4);
    for (r = ks->nr; r >= 1; r--) {
        u8 t[16];

        /* InvShiftRows: row n rotates right by n                     */
        for (c = 0; c < 4; c++) {
            t[c * 4 + 0] = st[c * 4 + 0];
            t[((c + 1) & 3) * 4 + 1] = st[c * 4 + 1];
            t[((c + 2) & 3) * 4 + 2] = st[c * 4 + 2];
            t[((c + 3) & 3) * 4 + 3] = st[c * 4 + 3];
        }
        for (i = 0; i < 16; i++) {
            st[i] = aes_isbox[t[i]];
        }
        add_round_key(st, ks->rk + (r - 1) * 4);
        if (r != 1) {
            for (c = 0; c < 4; c++) {
                u8 a0 = st[c * 4 + 0], a1 = st[c * 4 + 1];
                u8 a2 = st[c * 4 + 2], a3 = st[c * 4 + 3];

                st[c * 4 + 0] = (u8) (gmul(a0, 14) ^ gmul(a1, 11) ^
                                      gmul(a2, 13) ^ gmul(a3, 9));
                st[c * 4 + 1] = (u8) (gmul(a0, 9) ^ gmul(a1, 14) ^
                                      gmul(a2, 11) ^ gmul(a3, 13));
                st[c * 4 + 2] = (u8) (gmul(a0, 13) ^ gmul(a1, 9) ^
                                      gmul(a2, 14) ^ gmul(a3, 11));
                st[c * 4 + 3] = (u8) (gmul(a0, 11) ^ gmul(a1, 13) ^
                                      gmul(a2, 9) ^ gmul(a3, 14));
            }
        }
    }
    memcpy(out, st, 16);
}

int
pdfaes_cbc_decrypt_nopad(const u8 *key, u32 keylen, const u8 iv[16],
                         const u8 *in, u32 len, u8 *out)
{
    PdfAesKey ks;
    u8 chain[16], next[16], blk[16];
    u32 off;
    int e, i;

    if ((len & 15u) != 0) {
        return PDF_E_DATA;
    }
    e = pdfaes_setkey(&ks, key, keylen);
    if (e != PDF_OK) {
        return e;
    }
    memcpy(chain, iv, 16);
    for (off = 0; off < len; off += 16) {
        memcpy(next, in + off, 16);         /* in may alias out       */
        pdfaes_ecb_decrypt(&ks, next, blk);
        for (i = 0; i < 16; i++) {
            out[off + i] = (u8) (blk[i] ^ chain[i]);
        }
        memcpy(chain, next, 16);
    }
    return PDF_OK;
}

int
pdfaes_cbc_decrypt(const u8 *key, u32 keylen, const u8 *in, u32 len,
                   u8 *out, u32 *outlen)
{
    u8 iv[16];
    u32 body;
    int e;

    *outlen = 0;
    if (len == 0) {
        return PDF_OK;
    }
    if (len < 16 || ((len - 16) & 15u) != 0) {
        return PDF_E_DATA;
    }
    memcpy(iv, in, 16);
    body = len - 16;
    if (body == 0) {
        return PDF_OK;                      /* IV only: empty string  */
    }
    e = pdfaes_cbc_decrypt_nopad(key, keylen, iv, in + 16, body, out);
    if (e != PDF_OK) {
        return e;
    }
    /* strip PKCS#5 padding, but only if it really is padding: a
       producer that gets this wrong should still give readable data  */
    {
        u8 pad = out[body - 1];

        if (pad >= 1 && pad <= 16 && (u32) pad <= body) {
            u32 i;
            int good = 1;

            for (i = 0; i < pad; i++) {
                if (out[body - 1 - i] != pad) {
                    good = 0;
                    break;
                }
            }
            if (good) {
                body -= pad;
            }
        }
    }
    *outlen = body;
    return PDF_OK;
}

/* CBC encrypt, needed only by the R6 hardened hash (Algorithm 2.B).  */
static int
aes_cbc_encrypt_nopad(const u8 *key, u32 keylen, const u8 iv[16],
                      const u8 *in, u32 len, u8 *out)
{
    PdfAesKey ks;
    u8 chain[16], blk[16];
    u32 off;
    int e, i;

    if ((len & 15u) != 0) {
        return PDF_E_DATA;
    }
    e = pdfaes_setkey(&ks, key, keylen);
    if (e != PDF_OK) {
        return e;
    }
    memcpy(chain, iv, 16);
    for (off = 0; off < len; off += 16) {
        for (i = 0; i < 16; i++) {
            blk[i] = (u8) (in[off + i] ^ chain[i]);
        }
        pdfaes_ecb_encrypt(&ks, blk, out + off);
        memcpy(chain, out + off, 16);
    }
    return PDF_OK;
}

