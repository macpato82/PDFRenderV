/* The length field is 128 bits; we only ever hash small buffers, so
   the top 64 bits are always zero.                                    */
static void
sha512_finish(PdfSha512Ctx *ctx, u8 *out, int words)
{
    u64 bits = ctx->len * 8;
    u8 pad[144];
    u32 padlen;
    int i;

    memset(pad, 0, sizeof pad);
    pad[0] = 0x80;
    padlen = (ctx->buflen < 112) ? (112 - ctx->buflen)
                                 : (240 - ctx->buflen);
    st64be(pad + padlen + 8, bits);
    pdfsha512_update(ctx, pad, padlen + 16);
    for (i = 0; i < words; i++) {
        st64be(out + i * 8, ctx->h[i]);
    }
}

void
pdfsha384_final(PdfSha512Ctx *ctx, u8 out[48])
{
    sha512_finish(ctx, out, 6);
}

void
pdfsha512_final(PdfSha512Ctx *ctx, u8 out[64])
{
    sha512_finish(ctx, out, 8);
}

