    0x748f82eeu, 0x78a5636fu, 0x84c87814u, 0x8cc70208u,
    0x90befffau, 0xa4506cebu, 0xbef9a3f7u, 0xc67178f2u
};

static void
sha256_block(PdfSha256Ctx *ctx, const u8 *p)
{
    u32 w[64], a, b, c, d, e, f, g, h;
    int i;

    for (i = 0; i < 16; i++) {
        w[i] = ld32be(p + i * 4);
    }
    for (i = 16; i < 64; i++) {
        u32 s0 = ror32(w[i - 15], 7) ^ ror32(w[i - 15], 18) ^
                 (w[i - 15] >> 3);
        u32 s1 = ror32(w[i - 2], 17) ^ ror32(w[i - 2], 19) ^
                 (w[i - 2] >> 10);
        w[i] = w[i - 16] + s0 + w[i - 7] + s1;
    }
    a = ctx->h[0]; b = ctx->h[1]; c = ctx->h[2]; d = ctx->h[3];
    e = ctx->h[4]; f = ctx->h[5]; g = ctx->h[6]; h = ctx->h[7];
    for (i = 0; i < 64; i++) {
        u32 s1 = ror32(e, 6) ^ ror32(e, 11) ^ ror32(e, 25);
        u32 ch = (e & f) ^ (~e & g);
        u32 t1 = h + s1 + ch + sha256_k[i] + w[i];
        u32 s0 = ror32(a, 2) ^ ror32(a, 13) ^ ror32(a, 22);
        u32 maj = (a & b) ^ (a & c) ^ (b & c);
        u32 t2 = s0 + maj;

        h = g; g = f; f = e; e = d + t1;
        d = c; c = b; b = a; a = t1 + t2;
    }
    ctx->h[0] += a; ctx->h[1] += b; ctx->h[2] += c; ctx->h[3] += d;
    ctx->h[4] += e; ctx->h[5] += f; ctx->h[6] += g; ctx->h[7] += h;
}

void
pdfsha256_init(PdfSha256Ctx *ctx)
{
    ctx->h[0] = 0x6a09e667u; ctx->h[1] = 0xbb67ae85u;
    ctx->h[2] = 0x3c6ef372u; ctx->h[3] = 0xa54ff53au;
    ctx->h[4] = 0x510e527fu; ctx->h[5] = 0x9b05688cu;
    ctx->h[6] = 0x1f83d9abu; ctx->h[7] = 0x5be0cd19u;
    ctx->len = 0;
    ctx->buflen = 0;
}

void
pdfsha256_update(PdfSha256Ctx *ctx, const u8 *data, u32 len)
{
    ctx->len += len;
    if (ctx->buflen != 0) {
        u32 need = 64 - ctx->buflen;

        if (len < need) {
            memcpy(ctx->buf + ctx->buflen, data, len);
            ctx->buflen += len;
            return;
        }
        memcpy(ctx->buf + ctx->buflen, data, need);
        sha256_block(ctx, ctx->buf);
        ctx->buflen = 0;
        data += need;
        len -= need;
    }
    while (len >= 64) {
        sha256_block(ctx, data);
        data += 64;
        len -= 64;
    }
    if (len != 0) {
        memcpy(ctx->buf, data, len);
        ctx->buflen = len;
    }
}

void
pdfsha256_final(PdfSha256Ctx *ctx, u8 out[32])
{
    u64 bits = ctx->len * 8;
    u8 pad[72];
    u32 padlen;
    int i;

    memset(pad, 0, sizeof pad);
    pad[0] = 0x80;
    padlen = (ctx->buflen < 56) ? (56 - ctx->buflen)
                                : (120 - ctx->buflen);
    st64be(pad + padlen, bits);
    pdfsha256_update(ctx, pad, padlen + 8);
    for (i = 0; i < 8; i++) {
        st32be(out + i * 4, ctx->h[i]);
    }
}

void
pdfsha256(const u8 *data, u32 len, u8 out[32])
{
    PdfSha256Ctx ctx;

    pdfsha256_init(&ctx);
    pdfsha256_update(&ctx, data, len);
    pdfsha256_final(&ctx, out);
}

