#include "pdfobj.h"
#include "pdfflt.h"
#include "pdffile.h"
#include "pdffont.h"

enum { ROFAM_HOMERTON = 0, ROFAM_TRINITY, ROFAM_CORPUS };

/* --- small helpers ---------------------------------------------------- */

static void
set_identity_enc(u8 enc[256])
{
    u32 i;

    for (i = 0; i < 256; i++) {
        enc[i] = (u8) i;
    }
}

static u16
clampu16(s32 v, s32 max)
{
    if (v < 0) {
        return 0;
    }
    if (v > max) {
        return (u16) max;
    }
    return (u16) v;
}

/* --- WinAnsiEncoding / MacRomanEncoding -------------------------------- */

/* 0x00-0x7F and 0xA0-0xFF track Latin-1 already; only 0x80-0x9F need
   overriding with printable ASCII approximations of the CP1252 glyphs
   the RISC OS Latin-1 fonts do not carry.                              */
static const u8 winansi_hi[32] = {
    /* 0x80 */ 'E', 0,    ',',  'f',  '"',  '.',  '+',  '+',
    /* 0x88 */ '^', '%',  'S',  '<',  'O',  0,    'Z',  0,
    /* 0x90 */ 0,   '\'', '\'', '"',  '"',  '*',  '-',  '-',
    /* 0x98 */ '~', 'T',  's',  '>',  'o',  0,    'z',  'Y'
};

static void
apply_winansi(u8 enc[256])
{
    u32 i;

    for (i = 0; i < 32; i++) {
        enc[0x80 + i] = winansi_hi[i];
    }
}

/* Full MacRoman (0x80-0xFF) -> Latin-1 table.  Accented letters and the
   smart quote / dash block are mapped exactly; symbols with no Latin-1
   equivalent get a sensible ASCII stand-in where one is natural, else
   0 (no mapping - caller skips the glyph).                             */
static const u8 macroman_hi[128] = {
    /* 0x80 */ 0xC4, 0xC5, 0xC7, 0xC9, 0xD1, 0xD6, 0xDC, 0xE1,
    /* 0x88 */ 0xE0, 0xE2, 0xE4, 0xE3, 0xE5, 0xE7, 0xE9, 0xE8,
    /* 0x90 */ 0xEA, 0xEB, 0xED, 0xEC, 0xEE, 0xEF, 0xF1, 0xF3,
    /* 0x98 */ 0xF2, 0xF4, 0xF6, 0xF5, 0xFA, 0xF9, 0xFB, 0xFC,
    /* 0xA0 */ 0,    0xB0, 0xA2, 0xA3, 0xA7, 0,    0xB6, 0xDF,
    /* 0xA8 */ 0xAE, 0xA9, 'T',  0xB4, 0xA8, 0,    0xC6, 0xD8,
    /* 0xB0 */ 0,    0xB1, 0,    0,    0xA5, 0xB5, 0,    0,
    /* 0xB8 */ 0,    0,    0,    0xAA, 0xBA, 0,    0xE6, 0xF8,
    /* 0xC0 */ 0xBF, 0xA1, 0xAC, 0,    0,    0,    0,    0xAB,
    /* 0xC8 */ 0xBB, '.',  0xA0, 0xC0, 0xC3, 0xD5, 'O',  'o',
    /* 0xD0 */ '-',  '-',  '"',  '"',  '\'', '\'', 0xF7, 0,
    /* 0xD8 */ 0xFF, 'Y',  0,    0,    0,    0,    0,    0,
    /* 0xE0 */ 0,    0,    0,    0,    0,    0xC2, 0xCA, 0xC1,
    /* 0xE8 */ 0xCB, 0xC8, 0xCD, 0xCE, 0xCF, 0xCC, 0xD3, 0xD4,
    /* 0xF0 */ 0,    0xD2, 0xDA, 0xDB, 0xD9, 0,    0,    0,
    /* 0xF8 */ 0,    0,    0,    0,    0,    0,    0,    0
};

static void
apply_macroman(u8 enc[256])
{
    u32 i;

    for (i = 0; i < 128; i++) {
        enc[0x80 + i] = macroman_hi[i];
    }
}

static void
apply_encoding(PdfDoc *doc, u8 enc[256], PdfObj *encobj)
{
    PdfObj *base;
    const char *name = NULL;

    if (encobj == NULL) {
        return;                          /* leave identity */
    }
    if (encobj->type == PDF_NAME) {
        name = (const char *) encobj->u.str.p;
    } else if (encobj->type == PDF_DICT) {
        base = pdf_resolve(doc, pdf_dictget(encobj, "BaseEncoding"));
        if (base != NULL && base->type == PDF_NAME) {
            name = (const char *) base->u.str.p;
        }
        /* /Differences is not supported in this version - ignored */
    }
    if (name == NULL) {
        return;                          /* StandardEncoding or unknown */
    }
    if (strcmp(name, "WinAnsiEncoding") == 0) {
        apply_winansi(enc);
    } else if (strcmp(name, "MacRomanEncoding") == 0) {
        apply_macroman(enc);
    }
}

/* --- RISC OS font name mapping ----------------------------------------- */

static void
pick_rofont(PdfDoc *doc, char rofont[48], const char *basefont, PdfObj *descr)
{
    char work[128];
    const char *p = basefont;
    u32 n, i;
    int family = ROFAM_HOMERTON;
    int bold = 0, italic = 0;
    int matched = 0;
    PdfObj *flags_o = NULL, *stemv_o = NULL;
    s32 flags = 0, stemv = 0;

    if (descr != NULL) {
        flags_o = pdf_resolve(doc, pdf_dictget(descr, "Flags"));
        stemv_o = pdf_resolve(doc, pdf_dictget(descr, "StemV"));
        flags = pdfobj_int_of(flags_o);
        stemv = pdfobj_int_of(stemv_o);
    }

    if (p != NULL) {
        int is_prefix = 1;

        /* strip an "ABCDEF+" subset prefix (six uppercase letters) */
        for (i = 0; i < 6; i++) {
            if (p[i] < 'A' || p[i] > 'Z') {
                is_prefix = 0;
                break;
            }
        }
        if (is_prefix && p[6] == '+') {
            p += 7;
        }
        n = (u32) strlen(p);
        if (n >= sizeof work) {
            n = (u32) sizeof work - 1;
        }
        for (i = 0; i < n; i++) {
            char c = p[i];
            if (c >= 'A' && c <= 'Z') {
                c = (char) (c - 'A' + 'a');
            }
            work[i] = c;
        }
        work[n] = 0;
        if (n == 0) {
            p = NULL;                    /* empty name: treat as missing */
        }
    }

    if (p != NULL) {
        if (strstr(work, "symbol") != NULL) {
            strcpy(rofont, "Sidney");
            return;
        }
        if (strstr(work, "zapf") != NULL || strstr(work, "dingbat") != NULL) {
            strcpy(rofont, "Selwyn");
            return;
        }
        if (strstr(work, "courier") != NULL || strstr(work, "mono") != NULL) {
            family = ROFAM_CORPUS;
            matched = 1;
        } else if (strstr(work, "times") != NULL ||
                   strstr(work, "georgia") != NULL ||
                   strstr(work, "garamond") != NULL ||
                   strstr(work, "palatino") != NULL ||
                   strstr(work, "book") != NULL ||
                   strstr(work, "roman") != NULL ||
                   strstr(work, "serif") != NULL) {
            family = ROFAM_TRINITY;
            matched = 1;
        }
        if (strstr(work, "bold") != NULL || strstr(work, "heavy") != NULL ||
            strstr(work, "black") != NULL || strstr(work, "semibold") != NULL) {
            bold = 1;
        }
        if (strstr(work, "italic") != NULL || strstr(work, "oblique") != NULL) {
            italic = 1;
        }
    }

    if (!matched) {
        /* BaseFont missing or unhelpful: fall back to descriptor flags */
        if (flags & 1) {
            family = ROFAM_CORPUS;       /* FixedPitch */
        } else if (flags & 2) {
            family = ROFAM_TRINITY;      /* Serif */
        } else {
            family = ROFAM_HOMERTON;
        }
    }

    if (flags & 0x40000) {
        bold = 1;                        /* ForceBold */
    }
    if (stemv >= 120) {
        bold = 1;
    }
    if (flags & 0x40) {
        italic = 1;                      /* Italic */
    }

    if (family == ROFAM_CORPUS) {
        if (bold && italic) {
            strcpy(rofont, "Corpus.Bold.Oblique");
        } else if (bold) {
            strcpy(rofont, "Corpus.Bold");
        } else if (italic) {
            strcpy(rofont, "Corpus.Medium.Oblique");
        } else {
            strcpy(rofont, "Corpus.Medium");
        }
    } else if (family == ROFAM_TRINITY) {
        if (bold && italic) {
            strcpy(rofont, "Trinity.Bold.Italic");
        } else if (bold) {
            strcpy(rofont, "Trinity.Bold");
        } else if (italic) {
            strcpy(rofont, "Trinity.Medium.Italic");
        } else {
            strcpy(rofont, "Trinity.Medium");
        }
    } else {
        if (bold && italic) {
            strcpy(rofont, "Homerton.Bold.Oblique");
        } else if (bold) {
            strcpy(rofont, "Homerton.Bold");
        } else if (italic) {
            strcpy(rofont, "Homerton.Medium.Oblique");
        } else {
            strcpy(rofont, "Homerton.Medium");
        }
    }
}

/* --- Type0: /W ranges and /ToUnicode CMap ------------------------------ */

/* Big-endian code from a hex-string PDF_STRING: u.str.len bytes,
   usually 2; longer values clamp to 0xffff.                            */
static u16
cmap_code(PdfObj *s)
{
    u32 v = 0, i;

    if (s == NULL || s->type != PDF_STRING) {
        return 0;
    }
    for (i = 0; i < s->u.str.len; i++) {
        v = (v << 8) | s->u.str.p[i];
        if (v > 0xffffu) {
            v = 0xffffu;
        }
    }
    return (u16) v;
}

/* Destination unicode: first two bytes big-endian (a longer string is a
   multi-char ligature expansion - only the first UTF-16 unit is kept).
   Returns 0 and leaves *out untouched if the value is a surrogate.     */
static int
cmap_dst(PdfObj *s, u32 *out)
{
    u32 v;

    if (s == NULL || s->type != PDF_STRING) {
        return 0;
    }
    if (s->u.str.len >= 2) {
        v = ((u32) s->u.str.p[0] << 8) | s->u.str.p[1];
    } else if (s->u.str.len == 1) {
        v = s->u.str.p[0];
    } else {
        v = 0;
    }
    if (v >= 0xd800u && v <= 0xdfffu) {
        return 0;
    }
    *out = v;
    return 1;
}

/* Walk a decoded ToUnicode CMap, reacting only to beginbfchar/bfrange.
   out == NULL counts entries; otherwise fills them.  Returns the count
   (which, on the fill pass, equals the count from the first pass).    */
static u32
bf_ranges(PdfPool *pool, const u8 *buf, u32 len, PdfURange *out)
{
    PdfLex lx;
    PdfObj *o;
    char kw[PDF_KWMAX];
    int t;
    u32 count = 0;

    pdflex_init(&lx, buf, len, pool);
    for (;;) {
        t = pdf_parseany(&lx, &o, kw, 0);
        if (t == PDF_TOK_EOF) {
            break;
        }
        if (t != PDF_TOK_KW) {
            continue;
        }
        if (strcmp(kw, "beginbfchar") == 0) {
            for (;;) {
                PdfObj *src, *dst;
                u32 uni;
                u16 code;

                t = pdf_parseany(&lx, &o, kw, 0);
                if (t == PDF_TOK_KW) {
                    if (strcmp(kw, "endbfchar") == 0) {
                        break;
                    }
                    continue;
                }
                if (t != PDF_TOK_OBJ) {
                    break;
                }
                src = o;
                t = pdf_parseany(&lx, &o, kw, 0);
                if (t != PDF_TOK_OBJ) {
                    break;
                }
                dst = o;
                if (src->type != PDF_STRING || !cmap_dst(dst, &uni)) {
                    continue;
                }
                code = cmap_code(src);
                if (out != NULL) {
                    out[count].lo = code;
                    out[count].hi = code;
                    out[count].dst = uni;
                }
                count++;
            }
        } else if (strcmp(kw, "beginbfrange") == 0) {
            for (;;) {
                PdfObj *lo, *hi, *third;
                u16 lov, hiv;

                t = pdf_parseany(&lx, &o, kw, 0);
                if (t == PDF_TOK_KW) {
                    if (strcmp(kw, "endbfrange") == 0) {
                        break;
                    }
                    continue;
                }
                if (t != PDF_TOK_OBJ) {
                    break;
                }
                lo = o;
                t = pdf_parseany(&lx, &o, kw, 0);
                if (t != PDF_TOK_OBJ) {
                    break;
                }
                hi = o;
                t = pdf_parseany(&lx, &o, kw, 0);
                if (t != PDF_TOK_OBJ) {
                    break;
                }
                third = o;

                if (lo->type != PDF_STRING || hi->type != PDF_STRING) {
                    continue;
                }
                lov = cmap_code(lo);
                hiv = cmap_code(hi);

                if (third->type == PDF_ARRAY) {
                    u32 j, n = pdf_arrlen(third);

                    for (j = 0; j < n; j++) {
                        PdfObj *el = pdf_arrget(third, j);
                        u32 uni;

                        if (!cmap_dst(el, &uni)) {
                            continue;
                        }
                        if (out != NULL) {
                            u16 code = clampu16((s32) lov + (s32) j, 0xffff);
                            out[count].lo = code;
                            out[count].hi = code;
                            out[count].dst = uni;
                        }
                        count++;
                    }
                } else if (third->type == PDF_STRING) {
                    u32 uni;

                    if (cmap_dst(third, &uni)) {
                        if (out != NULL) {
                            out[count].lo = lov;
                            out[count].hi = hiv;
                            out[count].dst = uni;
                        }
                        count++;
                    }
                }
            }
        }
    }
    return count;
}

/* Walk a /W array: "cFirst cLast w" triples or "c [w1 w2 ...]" pairs
   (the array form emits one single-code range per element).  Same
   count-then-fill convention as bf_ranges.                            */
static u32
w_ranges(PdfDoc *doc, PdfObj *warr, PdfWRange *out)
{
    u32 len = pdf_arrlen(warr);
    u32 i = 0, count = 0;

    while (i < len) {
        PdfObj *a0 = pdf_resolve(doc, pdf_arrget(warr, i));
        PdfObj *a1;

        if (a0 == NULL || (a0->type != PDF_INT && a0->type != PDF_REAL)) {
            break;
        }
        if (i + 1 >= len) {
            break;
        }
        a1 = pdf_resolve(doc, pdf_arrget(warr, i + 1));
        if (a1 != NULL && a1->type == PDF_ARRAY) {
            u32 j, n = pdf_arrlen(a1);
            s32 base = pdfobj_int_of(a0);

            for (j = 0; j < n; j++) {
                if (out != NULL) {
                    PdfObj *wv = pdf_resolve(doc, pdf_arrget(a1, j));
                    u16 code = clampu16(base + (s32) j, 0xffff);
                    out[count].lo = code;
                    out[count].hi = code;
                    out[count].w = clampu16(pdfobj_int_of(wv), 0xffff);
                }
                count++;
            }
            i += 2;
        } else {
            PdfObj *wo;

            if (i + 2 >= len) {
                break;
            }
            wo = pdf_resolve(doc, pdf_arrget(warr, i + 2));
            if (out != NULL) {
                out[count].lo = clampu16(pdfobj_int_of(a0), 0xffff);
                out[count].hi = clampu16(pdfobj_int_of(a1), 0xffff);
                out[count].w = clampu16(pdfobj_int_of(wo), 0xffff);
            }
            count++;
            i += 3;
        }
    }
    return count;
}

static void
make_type0(PdfDoc *doc, PdfFont *f, PdfObj *fontdict, const char *basefont)
{
    PdfObj *descfonts = pdf_resolve(doc, pdf_dictget(fontdict, "DescendantFonts"));
    PdfObj *desc = NULL;
    PdfObj *descr = NULL;
    PdfObj *tounicode;

    f->type = PDFF_TYPE0;
    f->defwidth = 1000;

    if (descfonts != NULL && descfonts->type == PDF_ARRAY) {
        desc = pdf_resolve(doc, pdf_arrget(descfonts, 0));
    }
    if (desc != NULL) {
        PdfObj *dw = pdf_resolve(doc, pdf_dictget(desc, "DW"));
        PdfObj *warr = pdf_resolve(doc, pdf_dictget(desc, "W"));

        if (dw != NULL) {
            f->defwidth = clampu16(pdfobj_int_of(dw), 0xffff);
        }
        if (warr != NULL && warr->type == PDF_ARRAY) {
            u32 n = w_ranges(doc, warr, NULL);

            if (n > 0) {
                f->wr = pdfpool_alloc(doc->pool, n * sizeof *f->wr);
                if (f->wr != NULL) {
                    f->nwr = w_ranges(doc, warr, f->wr);
                }
            }
        }
        descr = pdf_resolve(doc, pdf_dictget(desc, "FontDescriptor"));
    }

    tounicode = pdf_resolve(doc, pdf_dictget(fontdict, "ToUnicode"));
    if (tounicode != NULL && tounicode->type == PDF_STREAM) {
        PdfBuf buf = { 0 };

        if (pdf_streamdata(doc, tounicode, &buf, NULL) == PDF_OK) {
            u32 n = bf_ranges(doc->pool, buf.p, buf.len, NULL);

            if (n > 0) {
                f->ur = pdfpool_alloc(doc->pool, n * sizeof *f->ur);
                if (f->ur != NULL) {
                    f->nur = bf_ranges(doc->pool, buf.p, buf.len, f->ur);
                }
            }
        }
        pdfbuf_free(&buf);
    }

    pick_rofont(doc, f->rofont, basefont, descr);
}

/* --- Type1/TrueType/MMType1 (simple, 1-byte) --------------------------- */

static void
make_simple(PdfDoc *doc, PdfFont *f, PdfObj *fontdict, const char *basefont)
{
    PdfObj *descr = pdf_resolve(doc, pdf_dictget(fontdict, "FontDescriptor"));
    PdfObj *fc = pdf_resolve(doc, pdf_dictget(fontdict, "FirstChar"));
    PdfObj *lc = pdf_resolve(doc, pdf_dictget(fontdict, "LastChar"));
    PdfObj *warr = pdf_resolve(doc, pdf_dictget(fontdict, "Widths"));
    PdfObj *encobj = pdf_resolve(doc, pdf_dictget(fontdict, "Encoding"));
    PdfObj *mw, *flags_o;
    s32 first, last;

    if (fc != NULL && lc != NULL && warr != NULL && warr->type == PDF_ARRAY) {
        first = pdfobj_int_of(fc);
        last = pdfobj_int_of(lc);
        if (first >= 0 && first <= 0xffff && last >= first && last <= 0xffff) {
            u32 n = (u32) (last - first + 1);
            u32 alen = pdf_arrlen(warr);

            if (n > alen) {
                n = alen;
                last = first + (s32) n - 1;
            }
            if (n > 0) {
                f->widths = pdfpool_alloc(doc->pool, n * sizeof *f->widths);
                if (f->widths != NULL) {
                    u32 i;

                    for (i = 0; i < n; i++) {
                        PdfObj *w = pdf_resolve(doc, pdf_arrget(warr, i));
                        f->widths[i] = clampu16(pdfobj_int_of(w), 32767);
                    }
                    f->firstchar = (int) first;
                    f->lastchar = (int) last;
                }
            }
        }
    }

    mw = descr != NULL ? pdf_resolve(doc, pdf_dictget(descr, "MissingWidth"))
                        : NULL;
    if (mw != NULL) {
        f->defwidth = clampu16(pdfobj_int_of(mw), 0xffff);
    }

    /* /Differences is not supported in this version - ignored */
    apply_encoding(doc, f->enc, encobj);

    flags_o = descr != NULL ? pdf_resolve(doc, pdf_dictget(descr, "Flags"))
                             : NULL;
    if (flags_o != NULL && (pdfobj_int_of(flags_o) & 4) != 0) {
        set_identity_enc(f->enc);        /* Symbolic: /Encoding ignored */
    }

    pick_rofont(doc, f->rofont, basefont, descr);
}

/* --- public interface --------------------------------------------------- */

PdfFont *
pdffont_make(PdfDoc *doc, PdfObj *fontdict)
{
    PdfFont *f;
    PdfObj *subtype, *bfobj;
    const char *basefont;

    f = pdfpool_alloc(doc->pool, sizeof *f);
    if (f == NULL) {
        return NULL;
    }
    memset(f, 0, sizeof *f);
    f->type = PDFF_SIMPLE;
    f->firstchar = 0;
    f->lastchar = -1;
    f->defwidth = 500;
    set_identity_enc(f->enc);
    strcpy(f->rofont, "Homerton.Medium");

    fontdict = pdf_resolve(doc, fontdict);
    subtype = pdf_resolve(doc, pdf_dictget(fontdict, "Subtype"));
    bfobj = pdf_resolve(doc, pdf_dictget(fontdict, "BaseFont"));
    basefont = (bfobj != NULL && bfobj->type == PDF_NAME)
               ? (const char *) bfobj->u.str.p : NULL;

    if (pdf_isname(subtype, "Type0")) {
        make_type0(doc, f, fontdict, basefont);
    } else if (pdf_isname(subtype, "Type3")) {
        f->type = PDFF_TYPE3;            /* glyph procedures: not rendered */
    } else {
        make_simple(doc, f, fontdict, basefont);
    }
    return f;
}

int
pdffont_width(PdfFont *f, u32 code)
{
    if (f->type == PDFF_TYPE0) {
        u32 i;

        for (i = 0; i < f->nwr; i++) {
            if (code >= f->wr[i].lo && code <= f->wr[i].hi) {
                return f->wr[i].w;
            }
        }
        return f->defwidth;
    }
    if (f->widths != NULL && (s32) code >= f->firstchar &&
        (s32) code <= f->lastchar) {
        return f->widths[code - (u32) f->firstchar];
    }
    return f->defwidth;
}

int
pdffont_tolatin1(PdfFont *f, u32 code)
{
    if (f->type == PDFF_TYPE0) {
        u32 i;
        u32 uni = 0;
        int have = 0;

        for (i = 0; i < f->nur; i++) {
            if (code >= f->ur[i].lo && code <= f->ur[i].hi) {
                uni = f->ur[i].dst + (code - f->ur[i].lo);
                have = 1;
                break;
            }
        }
        if (!have) {
            /* Identity-H of Latin text is common enough to earn this
               fallback when there is no ToUnicode CMap at all.        */
            return (f->nur == 0 && code < 0x100) ? (int) code : 0;
        }
        if (uni < 0x100) {
            return (int) uni;
        }
        switch (uni) {
        case 0x2018: case 0x2019: case 0x201A: return '\'';
        case 0x201C: case 0x201D: case 0x201E: return '"';
        case 0x2013: case 0x2014: case 0x2212: return '-';
        case 0x2022: return '*';
        case 0x2026: return '.';
        case 0x00A0: return ' ';
        case 0xFB01: return 'f';
        case 0xFB02: return 'f';
        case 0x2039: return '<';
        case 0x203A: return '>';
        default: return 0;
        }
    }
    return f->enc[code & 0xffu];
}
