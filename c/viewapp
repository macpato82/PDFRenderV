readmodevar(int var)
{
    int v = 0;

    _swix(XOS_ReadModeVariable, _INR(0, 1) | _OUT(2), -1, var, &v);
    return v;
}

/* --- rendering ------------------------------------------------------ */

/* Make sure our document handle is still good.  It will not be if the
   module has been reloaded under us (*RMKill/*RMLoad during
   development, or a user updating the module) - the handles live in
   the module and die with it.  Reopen the file rather than making the
   window useless.  Returns 0 if we have a usable handle.            */
static int
ensure_doc(void)
{
    int pages = 0, ver = 0, handle = 0, npages = 0;

    if (_swix(PDFRenderV_Info, _IN(0) | _OUT(0) | _OUT(1),
              vw.handle, &pages, &ver) == NULL) {
        return 0;                       /* still valid               */
    }
    if (_swix(PDFRenderV_Open, _INR(0, 1) | _OUT(0) | _OUT(1),
              0, vw.filename, &handle, &npages) != NULL) {
        return -1;
    }
    vw.handle = handle;
    vw.npages = (u32) npages;
    if (vw.page >= vw.npages) {
        vw.page = vw.npages ? vw.npages - 1 : 0;
    }
    return 0;
}

static void load_glyphs(fix zoomfix);
static void load_links(fix zoomfix);
static void free_glyphs(void);
static void clipboard_copy(void);
static void save_selection(void);

static void
free_sprite(void)
{
    if (vw.danum) {
        _swix(XOS_DynamicArea, _INR(0, 1), 1, vw.danum);
        vw.danum = 0;
        vw.area = NULL;
    }
}

/* Render current page at current zoom into a fresh dynamic-area
   sprite, using the module's renderer.  Returns 0 on success.        */
static int
render_page(void)
{
    int wmpt = 0, hmpt = 0, rot = 0, w, h;
    u32 areasize;
    _kernel_oserror *e;

    if (ensure_doc() != 0) {
        report("The document could not be reopened");
        return -1;
    }
    e = _swix(PDFRenderV_PageSize, _INR(0, 1) | _OUTR(0, 2),
              vw.handle, vw.page + 1, &wmpt, &hmpt, &rot);
    if (e != NULL) {
        report_oserr(e);
        return -1;
    }
    if (rot == 90 || rot == 270) {
        int t = wmpt;
        wmpt = hmpt;
        hmpt = t;
    }
    /* 100% = actual size on a 90dpi screen: 1pt = 1.25px; sizes are
       millipoints so px = mpt * zoom / 80000                         */
    w = (int) (((s64) wmpt * vw.zoom) / 80000);
    h = (int) (((s64) hmpt * vw.zoom) / 80000);
    if (w < 16) w = 16;
    if (h < 16) h = 16;
    if (w > 4096) w = 4096;
    if (h > 4096) h = 4096;

    free_sprite();
    areasize = 16 + 44 + (u32) w * (u32) h * 4 + 256;
    {
        int danum = 0;
        u8 *base = NULL;
        e = _swix(XOS_DynamicArea,
                  _INR(0, 8) | _OUT(1) | _OUT(3),
                  0, -1, areasize, -1, 0, areasize, 0, 0,
                  "PDFRenderV page", &danum, &base);
        if (e != NULL) {
            report_oserr(e);
            return -1;
        }
        vw.danum = danum;
        vw.area = base;
    }
    ((u32 *) vw.area)[0] = areasize;
    ((u32 *) vw.area)[1] = 0;
    ((u32 *) vw.area)[2] = 16;
    ((u32 *) vw.area)[3] = 16;
    e = _swix(XOS_SpriteOp, _INR(0, 6),
              15 + 256, vw.area, "page", 0, w, h, SPRITE_MODE_32BPP_180);
    if (e == NULL) {
        /* flags bit 0: white background.  The render is synchronous
           and can take a moment - show the hourglass.                */
        _swix(XHourglass_On, 0);
        e = _swix(PDFRenderV_Render, _INR(0, 4),
                  1, vw.handle, vw.page + 1, vw.area, vw.area + 16);
        _swix(XHourglass_Off, 0);
    }
    if (e != NULL) {
        report_oserr(e);
        free_sprite();
        return -1;
    }
    vw.sprw = w;
    vw.sprh = h;
    /* selection and links follow the page, at the same zoom as the
       pixels they have to line up with                              */
    load_glyphs((fix) (((s64) vw.zoom << 16) / 80));
    load_links((fix) (((s64) vw.zoom << 16) / 80));
    return 0;
}


/* --- links ------------------------------------------------------------ */

static void
free_links(void)
{
    free(vw.links);
    vw.links = NULL;
    vw.nlinks = 0;
}

/* Pull the page's URI links at the zoom the sprite was rendered with,
   so the boxes line up with the pixels on screen - same convention as
   the glyphs.                                                        */
static void
load_links(fix zoomfix)
{
    int need = 0, count = 0;
    _kernel_oserror *e;

    free_links();
    e = _swix(PDFRenderV_ExtractLinks, _INR(0, 5) | _OUT(0) | _OUT(1),
              0, vw.handle, vw.page + 1, zoomfix, 0, 0, &need, &count);
    if (e != NULL || need <= 0 || count <= 0) {
        return;                         /* most pages have no links   */
    }
    vw.links = malloc((u32) need);
    if (vw.links == NULL) {
        return;
    }
    e = _swix(PDFRenderV_ExtractLinks, _INR(0, 5) | _OUT(0) | _OUT(1),
              0, vw.handle, vw.page + 1, zoomfix, vw.links, need,
              &need, &count);
    if (e != NULL) {
        free_links();
        return;
    }
    vw.nlinks = (u32) count;
}

/* The page starts at the top of the work area; the status row takes
   the last STATUSH of it, which the extent below allows for so the
   page can be scrolled clear of the row.  Everything that maps
   between page and work-area coordinates goes through these.       */
static int
page_w(void)
{
    return vw.sprw << vw.xeig;
}

static int
page_h(void)
{
    return vw.sprh << vw.yeig;
}

/* work-area y of the page's top and bottom edges                     */
#define PAGE_TOP  0
#define PAGE_BOT  (-page_h())

/* Which link is at this work-area point, or -1.  Work-area y runs
   downwards from 0, the same mapping glyph_at uses.                 */
static int
link_at(int wx, int wy)
{
    const Link *l = (const Link *) vw.links;
    int top = PAGE_BOT;
    u32 i;

    for (i = 0; i < vw.nlinks; i++) {
        int x0 = (FX_TOINT(l[i].x0)) << vw.xeig;
        int x1 = (FX_TOINT(l[i].x1)) << vw.xeig;
        int y0 = top + ((FX_TOINT(l[i].y0)) << vw.yeig);
        int y1 = top + ((FX_TOINT(l[i].y1)) << vw.yeig);

        if (wx >= x0 && wx < x1 && wy >= y0 && wy < y1) {
            return (int) i;
        }
    }
    return -1;
}

/* Open a URL the way RISC OS expects, trying each mechanism in turn
   because which one works depends on what the user has installed:

     1. AcornURI's URI_Dispatch - the modern route, and the one that
        respects the configured handler.  Absent on plenty of systems,
        including the machine this was developed on, in which case the
        SWI is simply not known.
     2. the older ANT broadcast, which NetSurf and its contemporaries
        still answer.  Sent "recorded" so we hear about it bouncing.
     3. if it bounces, nobody is listening, so start the browser
        through the URLOpen_<scheme> alias its !Boot sets up.

   Steps 2 and 3 are split across the poll loop: the bounce arrives as
   a User_Message_Acknowledge, handled there.                        */
static void
start_urlopen(const char *url)
{
    char cmd[600];
    const char *colon = strchr(url, ':');
    int n = colon ? (int) (colon - url) : 0;

    if (n <= 0 || n > 16) {
        report("That link has no scheme this can open");
        return;
    }
    sprintf(cmd, "URLOpen_%.*s %.500s", n, url, url);
    if (_swix(XWimp_StartTask, _IN(0), cmd) != NULL) {
        report("Nothing here is set up to open that kind of link");
    }
}

static void
open_link(int idx)
{
    const Link *l = (const Link *) vw.links;
    const char *url;
    int flags = 0;

    if (idx < 0 || (u32) idx >= vw.nlinks) {
        return;
    }
    url = (const char *) (vw.links + l[idx].uoff);

    if (_swix(XURI_Dispatch, _INR(0, 2) | _OUT(0), 0, url, 0,
              &flags) == NULL &&
        (flags & URI_DISPATCH_FAILED) == 0) {
        return;                         /* AcornURI took it          */
    }

    /* ANT: the URL goes straight in the message body when it fits    */
    {
        int blk[64];
        u32 len = strlen(url);

        if (len + 1 > sizeof vw.pendurl) {
            start_urlopen(url);
            return;
        }
        strcpy(vw.pendurl, url);
        if (len < 232) {
            memset(blk, 0, sizeof blk);
            blk[0] = (int) (20 + ((len + 4) & ~3u));
            blk[3] = 0;                 /* your_ref: a new message   */
            blk[4] = Msg_URLOpen;
            strcpy((char *) &blk[5], url);
            if (_swix(XWimp_SendMessage, _INR(0, 2), 18, blk, 0)
                == NULL) {
                vw.pendref = blk[2];    /* my_ref, filled in by the
                                           Wimp: match the bounce    */
                return;
            }
        }
        start_urlopen(url);
    }
}

