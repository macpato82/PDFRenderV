static void
report(const char *msg)
{
    struct {
        int num;
        char text[200];
    } eb;

    eb.num = 0;
    strncpy(eb.text, msg, sizeof eb.text - 1);
    eb.text[sizeof eb.text - 1] = 0;
    _swix(XWimp_ReportError, _INR(0, 2), &eb, 1, "PDFRenderV");
}

static void
report_oserr(_kernel_oserror *e)
{
    if (e != NULL) {
        _swix(XWimp_ReportError, _INR(0, 2), e, 1, "PDFRenderV");
    }
}

static int
readmodevar(int var)
{
    int v = 0;

    _swix(XOS_ReadModeVariable, _INR(0, 1) | _OUT(2), -1, var, &v);
    return v;
}

/* --- rendering ------------------------------------------------------ */

/* Make sure our document handle is still good.  It will not be if the
   module has been reloaded under us (*RMKill/*RMLoad during
   development, or a user updating the module) - the handles live in
   the module and die with it.  Reopen the file rather than making the
   window useless.  Returns 0 if we have a usable handle.            */
static int
ensure_doc(void)
{
    int pages = 0, ver = 0, handle = 0, npages = 0;

    if (_swix(PDFRenderV_Info, _IN(0) | _OUT(0) | _OUT(1),
              vw.handle, &pages, &ver) == NULL) {
        return 0;                       /* still valid               */
    }
    if (_swix(PDFRenderV_Open, _INR(0, 1) | _OUT(0) | _OUT(1),
              0, vw.filename, &handle, &npages) != NULL) {
        return -1;
    }
    vw.handle = handle;
    vw.npages = (u32) npages;
    if (vw.page >= vw.npages) {
        vw.page = vw.npages ? vw.npages - 1 : 0;
    }
    return 0;
}

static void load_glyphs(fix zoomfix);
static void free_glyphs(void);
static void clipboard_copy(void);
static void save_selection(void);

static void
free_sprite(void)
{
    if (vw.danum) {
        _swix(XOS_DynamicArea, _INR(0, 1), 1, vw.danum);
        vw.danum = 0;
        vw.area = NULL;
    }
}

/* Render current page at current zoom into a fresh dynamic-area
   sprite, using the module's renderer.  Returns 0 on success.        */
static int
render_page(void)
{
    int wmpt = 0, hmpt = 0, rot = 0, w, h;
    u32 areasize;
    _kernel_oserror *e;

    if (ensure_doc() != 0) {
        report("The document could not be reopened");
        return -1;
    }
    e = _swix(PDFRenderV_PageSize, _INR(0, 1) | _OUTR(0, 2),
              vw.handle, vw.page + 1, &wmpt, &hmpt, &rot);
    if (e != NULL) {
        report_oserr(e);
        return -1;
    }
    if (rot == 90 || rot == 270) {
        int t = wmpt;
        wmpt = hmpt;
        hmpt = t;
    }
    /* 100% = actual size on a 90dpi screen: 1pt = 1.25px; sizes are
       millipoints so px = mpt * zoom / 80000                         */
    w = (int) (((s64) wmpt * vw.zoom) / 80000);
    h = (int) (((s64) hmpt * vw.zoom) / 80000);
    if (w < 16) w = 16;
    if (h < 16) h = 16;
    if (w > 4096) w = 4096;
    if (h > 4096) h = 4096;

    free_sprite();
    areasize = 16 + 44 + (u32) w * (u32) h * 4 + 256;
    {
        int danum = 0;
        u8 *base = NULL;
        e = _swix(XOS_DynamicArea,
                  _INR(0, 8) | _OUT(1) | _OUT(3),
                  0, -1, areasize, -1, 0, areasize, 0, 0,
                  "PDFRenderV page", &danum, &base);
        if (e != NULL) {
            report_oserr(e);
            return -1;
        }
        vw.danum = danum;
        vw.area = base;
    }
    ((u32 *) vw.area)[0] = areasize;
    ((u32 *) vw.area)[1] = 0;
    ((u32 *) vw.area)[2] = 16;
    ((u32 *) vw.area)[3] = 16;
    e = _swix(XOS_SpriteOp, _INR(0, 6),
              15 + 256, vw.area, "page", 0, w, h, SPRITE_MODE_32BPP_180);
    if (e == NULL) {
        /* flags bit 0: white background.  The render is synchronous
           and can take a moment - show the hourglass.                */
        _swix(XHourglass_On, 0);
        e = _swix(PDFRenderV_Render, _INR(0, 4),
                  1, vw.handle, vw.page + 1, vw.area, vw.area + 16);
        _swix(XHourglass_Off, 0);
    }
    if (e != NULL) {
        report_oserr(e);
        free_sprite();
        return -1;
    }
    vw.sprw = w;
    vw.sprh = h;
    /* selection follows the page, at the same zoom as the pixels    */
    load_glyphs((fix) (((s64) vw.zoom << 16) / 80));
    return 0;
}

/* --- text selection -------------------------------------------------- */

static void
free_glyphs(void)
{
    free(vw.glyphs);
    vw.glyphs = NULL;
    vw.nglyphs = 0;
    vw.selfrom = vw.selto = -1;
}

/* Pull the page's glyphs at the zoom the sprite was rendered with, so
   the boxes line up with what is on screen.                          */
static void
load_glyphs(fix zoomfix)
{
    int need = 0, count = 0;
    _kernel_oserror *e;

    free_glyphs();
    e = _swix(PDFRenderV_ExtractText, _INR(0, 5) | _OUT(0) | _OUT(1),
              0, vw.handle, vw.page + 1, zoomfix, 0, 0, &need, &count);
    if (e != NULL || need <= 0 || count <= 0) {
        return;                         /* a page may hold no text    */
    }
    vw.glyphs = malloc((u32) need);
    if (vw.glyphs == NULL) {
        return;
    }
    e = _swix(PDFRenderV_ExtractText, _INR(0, 5) | _OUT(0) | _OUT(1),
              0, vw.handle, vw.page + 1, zoomfix, vw.glyphs, need,
              &need, &count);
    if (e != NULL) {
        free_glyphs();
        return;
    }
    vw.nglyphs = (u32) count;
}

/* Work-area coordinates of a glyph box, in OS units.  The sprite is
   plotted 1:1 in screen pixels from the work-area origin, so a device
   unit is one pixel, i.e. 1<<eig OS units.                           */
static void
glyph_box(const Glyph *g, int *x0, int *y0, int *x1, int *y1)
{
    int top = -(vw.sprh << vw.yeig);

    *x0 = (FX_TOINT(g->x0)) << vw.xeig;
    *x1 = (FX_TOINT(g->x1)) << vw.xeig;
    /* device y counts up from the sprite's bottom, which sits at the
       bottom of the work area                                        */
    *y0 = top + ((FX_TOINT(g->y0)) << vw.yeig);
    *y1 = top + ((FX_TOINT(g->y1)) << vw.yeig);
}

/* Index of the glyph nearest a work-area point, or -1.  Prefers a
   direct hit; otherwise takes the nearest on the closest line, so a
   drag through the gaps between words still selects sensibly.       */
static int
glyph_at(int wx, int wy)
{
    u32 i;
    int best = -1;
    long bestd = 0;

    for (i = 0; i < vw.nglyphs; i++) {
        int x0, y0, x1, y1;
        long dx, dy, d;

        glyph_box(&vw.glyphs[i], &x0, &y0, &x1, &y1);
        if (wx >= x0 && wx < x1 && wy >= y0 && wy < y1) {
            return (int) i;
        }
        dy = wy < y0 ? y0 - wy : wy > y1 ? wy - y1 : 0;
        dx = wx < x0 ? x0 - wx : wx > x1 ? wx - x1 : 0;
        d = dy * 8 + dx;                /* lines matter more than columns */
        if (best < 0 || d < bestd) {
            best = (int) i;
            bestd = d;
        }
    }
    return best;
}

/* Build the selected text, inserting spaces and newlines from the
   geometry (a PDF has neither).                                     */
static char *
selection_text(u32 *lenp)
{
    int from = vw.selfrom, to = vw.selto, t;
    u32 i, n = 0, cap;
    char *out;

    *lenp = 0;
    if (from < 0 || to < 0 || vw.glyphs == NULL) {
        return NULL;
    }
    if (from > to) {
        t = from;
        from = to;
        to = t;
    }
    cap = (u32) (to - from + 2) * 2 + 8;
    out = malloc(cap);
    if (out == NULL) {
        return NULL;
    }
    for (i = (u32) from; i <= (u32) to && i < vw.nglyphs; i++) {
        const Glyph *g = &vw.glyphs[i];

        if (i > (u32) from) {
            const Glyph *p = &vw.glyphs[i - 1];
            int newline = g->y0 < p->y0 - (p->y1 - p->y0) / 2 ||
                          g->y0 > p->y0 + (p->y1 - p->y0) / 2;
            if (newline) {
                out[n++] = 10;
            } else if (g->x0 > p->x1 + (p->x1 - p->x0) / 3) {
                out[n++] = ' ';         /* visible gap = word break   */
            }
        }
        if (g->ch >= 32) {
            out[n++] = (char) g->ch;
        }
        if (n + 4 >= cap) {
            break;
        }
    }
    out[n] = 0;
    *lenp = n;
    return out;
}

/* Screen size in OS units.                                          */
static void
screen_size(int *w, int *h)
{
    *w = (readmodevar(11) + 1) << vw.xeig;      /* XWindLimit         */
    *h = (readmodevar(12) + 1) << vw.yeig;      /* YWindLimit         */
}

/* Choose the opening zoom: show the whole thing if it fits, and
   shrink to fit the screen when it does not.  A 4000-pixel scan
   should open readable, not 4000 pixels wide with scrollbars.       */
static void
fit_zoom(void)
{
    int wmpt = 0, hmpt = 0, rot = 0, sw, sh, i;
    s64 pxw, pxh;

    if (_swix(PDFRenderV_PageSize, _INR(0, 1) | _OUTR(0, 2),
              vw.handle, vw.page + 1, &wmpt, &hmpt, &rot) != NULL) {
        return;
    }
    if (rot == 90 || rot == 270) {
        int t = wmpt;
        wmpt = hmpt;
        hmpt = t;
    }
    screen_size(&sw, &sh);
    /* leave room for window furniture and the icon bar               */
    sw -= 80;
    sh -= 260;                          /* title, scroll row, iconbar */
    if (sw < 200 || sh < 200 || wmpt <= 0 || hmpt <= 0) {
        return;
    }
    for (i = NZOOM - 1; i > 0; i--) {
        pxw = ((s64) wmpt * zoomsteps[i]) / 80000;
        pxh = ((s64) hmpt * zoomsteps[i]) / 80000;
        if ((pxw << vw.xeig) <= sw && (pxh << vw.yeig) <= sh) {
            break;
        }
    }
    /* never open above 100%: a small image should not be blown up    */
    while (i > 0 && zoomsteps[i] > 100) {
        i--;
    }
    vw.zoom = zoomsteps[i];
}

/* --- window management ---------------------------------------------- */

static void
update_toolbar_texts(void)
{
    int blk[4];

    sprintf(vw.pagetxt, "%u/%u", vw.page + 1, vw.npages);
    sprintf(vw.zoomtxt, "%d%%", vw.zoom);
    /* Wimp_SetIconState takes a 4-word block in R1                   */
    blk[0] = vw.pane;
    blk[1] = IC_PAGE;
    blk[2] = 0;
    blk[3] = 0;
    _swix(XWimp_SetIconState, _IN(1), blk);
    blk[1] = IC_ZOOM;
    _swix(XWimp_SetIconState, _IN(1), blk);
}

static void
set_extent(void)
{
    int ext[4];

    /* The work area is exactly the page.  The toolbar no longer eats
       into it: it lives in the horizontal scroll bar, which is
       furniture, outside the work area entirely.                   */
    ext[0] = 0;
    ext[1] = -(vw.sprh << vw.yeig);
    ext[2] = vw.sprw << vw.xeig;
    ext[3] = 0;
    _swix(XWimp_SetExtent, _INR(0, 1), vw.win, ext);
    _swix(XWimp_ForceRedraw, _INR(0, 4), vw.win,
          0, -(vw.sprh << vw.yeig), vw.sprw << vw.xeig, 0);
}

/* icon block helper: bbox + flags + 12 bytes of data                 */
static void
mkicon(int *p, int x0, int y0, int x1, int y1, unsigned flags,
       const char *text, char *indbuf, int indlen)
{
    p[0] = x0;
    p[1] = y0;
    p[2] = x1;
    p[3] = y1;
    p[4] = (int) flags;
    memset(p + 5, 0, 12);
    if (indbuf != NULL) {
        p[5] = (int) indbuf;
        p[6] = -1;
        p[7] = indlen;
    } else {
        strncpy((char *) (p + 5), text, 11);
    }
}

static int
create_windows(void)
{
    int blk[120];
    _kernel_oserror *e;

    /* --- main document window --- */
    memset(blk, 0, sizeof blk);
    {
        /* open the window at the size of the content (plus the
           toolbar), clamped to what the screen can show             */
        int sw, sh, ww, wh, x0, y1;

        screen_size(&sw, &sh);
        ww = vw.sprw << vw.xeig;
        wh = vw.sprh << vw.yeig;
        if (ww > sw - 80) {
            ww = sw - 80;
        }
        if (wh > sh - 160) {
            wh = sh - 160;
        }
        /* never narrower than the embedded toolbar plus a usable
           length of scroll bar beside it                           */
        if (ww < TOOLW + 200) {
            ww = TOOLW + 200;
        }
        if (wh < 200) {
            wh = 200;
        }
        x0 = (sw - ww) / 2;
        y1 = sh - 100;
        blk[0] = x0;                    /* visible area               */
        blk[1] = y1 - wh;
        blk[2] = x0 + ww;
        blk[3] = y1;
    }
    blk[6] = -1;                        /* open at top                */
    /* moveable; new-style control icons: back/close/title/toggle/
       vscroll/adjust/hscroll                                         */
    blk[7] = (int) 0xFF000002u;
    ((u8 *) &blk[8])[0] = 7;            /* title fg                   */
    ((u8 *) &blk[8])[1] = 2;            /* title bg                   */
    ((u8 *) &blk[8])[2] = 7;            /* work fg                    */
    ((u8 *) &blk[8])[3] = 1;            /* work bg                    */
    ((u8 *) &blk[9])[0] = 3;            /* scroll outer               */
    ((u8 *) &blk[9])[1] = 1;            /* scroll inner               */
    ((u8 *) &blk[9])[2] = 12;           /* highlight                  */
    blk[4] = 0;                         /* scroll x                   */
    blk[5] = 0;                         /* scroll y                   */
    blk[10] = 0;                        /* work area extent           */
    blk[11] = -(vw.sprh << vw.yeig);
    blk[12] = vw.sprw << vw.xeig;
    blk[13] = 0;
    blk[14] = 0x00000109;               /* title: text+indirected+ctr */
    /* work-area button type 10 (click/drag): without this the Wimp
       never reports clicks in the page and text cannot be selected  */
    blk[15] = 10 << 12;
    blk[16] = 1;                        /* wimp sprite area           */
    /* minimum size: the toolbar occupies the left of the scroll bar
       row, so refuse to be dragged narrower than it plus enough bar
       to be worth dragging (the Wimp will happily give a scroll well
       of negative length otherwise)                                */
    blk[17] = (TOOLW + 160) | (128 << 16);
    blk[18] = (int) vw.titletxt;        /* indirected title           */
    blk[19] = -1;
    blk[20] = (int) sizeof vw.titletxt;
    blk[21] = 0;                        /* no icons                   */
    e = _swix(XWimp_CreateWindow, _IN(1) | _OUT(0), blk, &vw.win);
    if (e != NULL) {
        report_oserr(e);
        return -1;
    }

    /* --- toolbar pane --- */
    memset(blk, 0, sizeof blk);
    blk[0] = 200;                       /* placed properly at open    */
    blk[1] = 900;
    blk[2] = 200 + TOOLW;
    blk[3] = 940;
    blk[6] = -1;
    /* pane + auto-redraw + no control icons, plus bit 23: a
       "furniture window", which is what lets a nested child encroach
       on its parent's border instead of being clipped to the work
       area - without it the bar cannot reach the scroll bar at all
       (Nested Window Manager functional spec; window flag 23).     */
    blk[7] = (int) 0x80800030u;
    ((u8 *) &blk[8])[0] = 0xFF;         /* no frame/title             */
    ((u8 *) &blk[8])[1] = 2;
    ((u8 *) &blk[8])[2] = 7;
    ((u8 *) &blk[8])[3] = 1;
    ((u8 *) &blk[9])[0] = 3;
    ((u8 *) &blk[9])[1] = 1;
    ((u8 *) &blk[9])[2] = 12;
    blk[10] = 0;                        /* extent: set at open time    */
    blk[11] = -40;
    blk[12] = TOOLW;
    blk[13] = 0;
    blk[14] = 0;                        /* no title text              */
    blk[15] = 0;
    blk[16] = 1;
    blk[17] = 0;
    blk[18] = 0;
    blk[19] = 0;
    blk[20] = 0;
    blk[21] = NTOOL;                    /* icons follow               */
    {
        /* icon flags: text|border|hcentre|vcentre|filled, click
           button type, black on grey.  The y coordinates here are
           provisional - arrange_toolbar resizes every icon to the
           real scroll bar height before the bar is ever shown.     */
        unsigned bf = 0x1700303Du;
        unsigned df = 0x1700013Du;      /* display only: no button    */
        int *ic = blk + 22;

        mkicon(ic + 0, toollayout[0].x0, -36, toollayout[0].x1, -4,
               bf, "<", NULL, 0);
        mkicon(ic + 8, toollayout[1].x0, -36, toollayout[1].x1, -4,
               df | 0x100, NULL, vw.pagetxt, sizeof vw.pagetxt);
        mkicon(ic + 16, toollayout[2].x0, -36, toollayout[2].x1, -4,
               bf, ">", NULL, 0);
        mkicon(ic + 24, toollayout[3].x0, -36, toollayout[3].x1, -4,
               bf, "-", NULL, 0);
        mkicon(ic + 32, toollayout[4].x0, -36, toollayout[4].x1, -4,
               df | 0x100, NULL, vw.zoomtxt, sizeof vw.zoomtxt);
        mkicon(ic + 40, toollayout[5].x0, -36, toollayout[5].x1, -4,
               bf, "+", NULL, 0);
        mkicon(ic + 48, toollayout[6].x0, -36, toollayout[6].x1, -4,
               bf, "Print", NULL, 0);
    }
    e = _swix(XWimp_CreateWindow, _IN(1) | _OUT(0), blk, &vw.pane);
    if (e != NULL) {
        report_oserr(e);
        return -1;
    }
    return 0;
}

/* Fit the toolbar into the horizontal scroll bar of the document
   window and open it there as a nested child.

   The height of that row is not ours to choose - it comes from the
   current screen mode and the toolsprites in use - so the icons are
   sized here rather than in the window definition, and this is redone
   whenever the mode changes.  The row itself is the gap between the
   bottom of the window's outline (which includes the border) and the
   bottom of its visible area, a pixel inside each.

   With the pane marked as a furniture window the Wimp shortens the
   scroll bar to whatever is left, so the bar and the scroll bar share
   the row instead of overlapping.                                  */
static void
arrange_toolbar(const int *mainst)
{
    int out[8], st[16], ext[4];
    int ph, h, i;

    out[0] = vw.win;
    if (_swix(XWimp_GetWindowOutline, _IN(1), out) != NULL) {
        return;
    }
    ph = 1 << vw.yeig;                  /* height of a pixel          */
    h = (mainst[2] - ph) - (out[2] + ph);
    if (h < 8) {
        return;                         /* no scroll bar to sit in    */
    }

    /* Open requests arrive continuously while a window is dragged or
       scrolled, and the nested Wimp keeps the bar in place by itself
       once it is anchored.  So do the expensive part - setting the
       extent and resizing every icon, both of which force redraws -
       only when the row has actually changed size, which happens on
       a mode change and not otherwise.  Doing it every time made
       dragging and paging crawl.                                   */
    if (vw.barnested && h == vw.barh) {
        return;
    }

    /* work area = the whole visible area of the bar                  */
    ext[0] = 0;
    ext[1] = -h;
    ext[2] = TOOLW;
    ext[3] = 0;
    _swix(XWimp_SetExtent, _INR(0, 1), vw.pane, ext);

    /* every icon fills the row bar a pixel top and bottom            */
    for (i = 0; i < NTOOL; i++) {
        _swix(XWimp_ResizeIcon, _INR(0, 5), vw.pane, i,
              toollayout[i].x0, -h + ph, toollayout[i].x1, -ph);
    }

    st[0] = vw.pane;
    if (_swix(XWimp_GetWindowState, _IN(1), st) != NULL) {
        return;
    }
    st[1] = mainst[1];                  /* left edge of the window    */
    st[2] = out[2] + ph;                /* bottom of the scroll row   */
    st[3] = mainst[1] + TOOLW;
    st[4] = st[2] + h;
    st[5] = 0;                          /* scroll offsets             */
    st[6] = 0;
    st[7] = -1;                         /* in front                   */
    _swix(XWimp_OpenWindow, _INR(1, 4), st, WIMP_NEST_MAGIC,
          vw.win, NEST_BOTTOMLEFT);
    vw.barh = h;
    vw.barnested = 1;
}

/* Open the main window (from an open request block) and place the
   toolbar in its scroll bar.                                         */
static void
open_with_pane(int *open)
{
    int st[16];

    /* Open the document window FIRST, then read back where it really
       landed: the Wimp forces a new window on-screen, so a bar placed
       from the requested coordinates can end up somewhere else
       entirely (which is how the toolbar once went missing).       */
    _swix(XWimp_OpenWindow, _IN(1), open);

    st[0] = vw.win;
    if (_swix(XWimp_GetWindowState, _IN(1), st) != NULL) {
        return;
    }
    arrange_toolbar(st);
}

/* Paint the selection as EOR'd rectangles over the plotted page, so
   it inverts whatever is underneath and needs no repaint to remove.
   ox/oy are the work-area origin in screen coordinates.             */
static void
draw_selection(int ox, int oy)
{
    int from = vw.selfrom, to = vw.selto, t;
    u32 i;

    if (from < 0 || to < 0 || vw.glyphs == NULL) {
        return;
    }
    if (from > to) {
        t = from;
        from = to;
        to = t;
    }
    /* GCOL action 3 = exclusive OR, colour white: inverts            */
    _swix(0x40743, _IN(0) | _INR(3, 4), 0xFFFFFF00u, 0, 3);
    for (i = (u32) from; i <= (u32) to && i < vw.nglyphs; i++) {
        int x0, y0, x1, y1;

        glyph_box(&vw.glyphs[i], &x0, &y0, &x1, &y1);
        /* PLOT 4 = move absolute, PLOT &65 = rectangle fill to point */
        _swix(0x45, _INR(0, 2), 4, ox + x0, oy + y0);
        _swix(0x45, _INR(0, 2), 0x65, ox + x1 - 1, oy + y1 - 1);
    }
}

static void
redraw_main(int *blk)
{
    int more = 0;

    _swix(XWimp_RedrawWindow, _IN(1) | _OUT(0), blk, &more);
    while (more) {
        /* work-area origin in screen coords                          */
        int ox = blk[1] - blk[5];
        int oy = blk[4] - blk[6];
        int sx = ox;
        int sy = oy - (vw.sprh << vw.yeig);
        if (vw.area != NULL) {
            _swix(XOS_SpriteOp, _INR(0, 7),
                  52 + 512, vw.area, vw.area + 16, sx, sy, 0, 0, 0);
        }
        draw_selection(ox, oy);
        _swix(XWimp_GetRectangle, _IN(1) | _OUT(0), blk, &more);
    }
}

static void
redraw_doc(void)
{
    _swix(XWimp_ForceRedraw, _INR(0, 4), vw.win,
          0, -(vw.sprh << vw.yeig), vw.sprw << vw.xeig, 0);
}

/* Resize the window to the page just rendered, keeping its top-left
   corner where the user put it.  Pages within one PDF are not all the
   same size - a landscape plate in a portrait document is common - and
   zooming changes the size too, so the window follows the page rather
   than leaving it adrift in a window of the wrong shape.  The screen
   is the limit; past that the scroll bars do their job.             */
static void
size_to_page(void)
{
    int st[16], sw, sh, ww, wh;

    st[0] = vw.win;
    if (_swix(XWimp_GetWindowState, _IN(1), st) != NULL) {
        return;
    }
    if ((st[8] & (1 << 16)) == 0) {
        return;                         /* not open: nothing to size  */
    }
    screen_size(&sw, &sh);
    ww = vw.sprw << vw.xeig;
    wh = vw.sprh << vw.yeig;
    if (ww > sw - 80) {
        ww = sw - 80;
    }
    if (wh > sh - 260) {
        wh = sh - 260;
    }
    if (ww < TOOLW + 200) {
        ww = TOOLW + 200;               /* room for the toolbar       */
    }
    if (wh < 200) {
        wh = 200;
    }
    st[3] = st[1] + ww;                 /* x1: grow/shrink rightwards */
    st[2] = st[4] - wh;                 /* y0: and downwards          */
    st[7] = -1;                         /* keep it in front           */
    open_with_pane(st);
}

static void
rerender(void)
{
    render_page();
    update_toolbar_texts();
    set_extent();
    size_to_page();
}

/* --- printing ------------------------------------------------------- */

static void
print_page(void)
{
    _kernel_oserror *e;
    int job = 0, oldjob = 0;
    int psize[6];
    int wmpt = 0, hmpt = 0, rot = 0;
    fix zoomfix, zx, zy;
    int devw, devh;

    if (ensure_doc() != 0) {
        report("The document could not be reopened");
        return;
    }
    e = _swix(XOS_Find, _INR(0, 1) | _OUT(0), 0x8F, "printer:", &job);
    if (e != NULL || job == 0) {
        report("No printer driver is active (load Printers first)");
        return;
    }
    e = _swix(XPDriver_SelectJob, _INR(0, 1) | _OUT(0),
              job, "PDFRenderV", &oldjob);
    if (e != NULL) {
        _swix(XOS_Find, _INR(0, 1), 0, job);
        report_oserr(e);
        return;
    }
    e = _swix(XPDriver_PageSize, _OUTR(1, 6),
              &psize[0], &psize[1], &psize[2], &psize[3],
              &psize[4], &psize[5]);
    if (e == NULL) {
        e = _swix(PDFRenderV_PageSize, _INR(0, 1) | _OUTR(0, 2),
                  vw.handle, vw.page + 1, &wmpt, &hmpt, &rot);
    }
    if (e == NULL) {
        int prw_os = (psize[4] - psize[2]) / 400;   /* printable, OS  */
        int prh_os = (psize[5] - psize[3]) / 400;
        fix pw = (fix) (((s64) wmpt << 16) / 1000); /* points, 16.16  */
        fix ph = (fix) (((s64) hmpt << 16) / 1000);
        if (rot == 90 || rot == 270) {
            fix t = pw;
            pw = ph;
            ph = t;
        }
        /* actual size (1pt = 2.5 OS units), shrunk to fit            */
        zoomfix = 5 << 15;
        zx = fx_div(FX_FROMINT(prw_os), pw);
        zy = fx_div(FX_FROMINT(prh_os), ph);
        if (zx < zoomfix) zoomfix = zx;
        if (zy < zoomfix) zoomfix = zy;
        devw = FX_TOINT(fx_mul(pw, zoomfix));
        devh = FX_TOINT(fx_mul(ph, zoomfix));

        {
            int rect[4], pos[2], xform[4], outrect[4];
            int more = 0, id = 0;

            rect[0] = 0;
            rect[1] = 0;
            rect[2] = devw + 4;
            rect[3] = devh + 4;
            xform[0] = 1 << 16;
            xform[1] = 0;
            xform[2] = 0;
            xform[3] = 1 << 16;
            pos[0] = psize[2];
            pos[1] = psize[3];
            e = _swix(XPDriver_GiveRectangle, _INR(0, 4),
                      1, rect, xform, pos, 0xFFFFFF00u);
            if (e == NULL) {
                e = _swix(XPDriver_DrawPage,
                          _INR(0, 3) | _OUT(0) | _OUT(2),
                          1, outrect, vw.page + 1, 0, &more, &id);
            }
            while (e == NULL && more != 0) {
                /* flags bit 1: render direct to current output (the
                   printer job intercepts the Draw/Font/sprite calls);
                   R3 = zoom, device units per point, 16.16           */
                e = _swix(PDFRenderV_Render, _INR(0, 3),
                          2, vw.handle, vw.page + 1, zoomfix);
                if (e != NULL) {
                    break;
                }
                e = _swix(XPDriver_GetRectangle,
                          _IN(1) | _OUT(0) | _OUT(2),
                          outrect, &more, &id);
            }
        }
    }
    if (e != NULL) {
        _swix(XPDriver_AbortJob, _IN(0), job);
        _swix(XOS_Find, _INR(0, 1), 0, job);
        report_oserr(e);
        return;
    }
    e = _swix(XPDriver_EndJob, _IN(0), job);
    _swix(XOS_Find, _INR(0, 1), 0, job);
    report_oserr(e);
}

/* Write the selection to a text file alongside the document, which
   is the useful thing to do without a full drag-and-drop save box. */
static void
save_selection(void)
{
    u32 len = 0;
    char *text = selection_text(&len);
    char path[300];
    _kernel_oserror *e;

    if (text == NULL || len == 0) {
        free(text);
        return;
    }
    sprintf(path, "%.280s/txt", vw.filename);
    e = _swix(XOS_File, _INR(0, 5), 10, path, 0xFFF, 0,
              text, text + len);
    free(text);
    if (e != NULL) {
        report_oserr(e);
    } else {
        char msg[340];
        sprintf(msg, "Saved %u characters to %.290s", len, path);
        report(msg);
    }
}

/* --- menu ------------------------------------------------------------- */

/* A plain Wimp menu: 28-byte header then 24-byte items.  Built by
   hand rather than via the Toolbox so the viewer stays a single
   self-contained binary.                                            */
#define MENU_COPY   0
#define MENU_ALL    1
#define MENU_SAVE   2
#define MENU_ITEMS  3

static struct {
    char title[12];
    char tfcol, tbcol, wfcol, wbcol;
    int width, height, gap;
    struct {
        int flags;
        int submenu;
        int iconflags;
        char text[12];
    } item[MENU_ITEMS];
} selmenu;

static void
build_menu(void)
{
    static const char *const names[MENU_ITEMS] = {
        "Copy", "Select all", "Save text"
    };
    int i;

    memset(&selmenu, 0, sizeof selmenu);
    strcpy(selmenu.title, "Text");
    selmenu.tfcol = 7;
    selmenu.tbcol = 2;
    selmenu.wfcol = 7;
    selmenu.wbcol = 0;
    selmenu.width = 200;
    selmenu.height = 44;
    selmenu.gap = 0;
    for (i = 0; i < MENU_ITEMS; i++) {
        selmenu.item[i].flags = 0;
        selmenu.item[i].submenu = -1;
        selmenu.item[i].iconflags = 0x07000021;     /* text, filled  */
        strcpy(selmenu.item[i].text, names[i]);
    }
    selmenu.item[MENU_ITEMS - 1].flags |= 0x80;     /* last item     */
}

/* Grey Copy and Save when there is nothing selected.                */
static void
update_menu(void)
{
    int shade = (vw.selfrom < 0 || vw.selto < 0) ? 0x400000 : 0;

    selmenu.item[MENU_COPY].iconflags =
        0x07000021 | (u32) shade;
    selmenu.item[MENU_SAVE].iconflags =
        0x07000021 | (u32) shade;
    selmenu.item[MENU_ALL].iconflags =
        0x07000021 | (vw.nglyphs ? 0 : 0x400000);
}

/* --- clipboard -------------------------------------------------------- */

/* Claim the global clipboard for our selection (Message_ClaimEntity,
   broadcast; the owner then answers Message_DataRequest).           */
static void
clipboard_copy(void)
{
    int blk[16];
    u32 len = 0;
    char *text = selection_text(&len);

    if (text == NULL || len == 0) {
        free(text);
        return;
    }
    free(vw.clip);
    vw.clip = text;
    vw.cliplen = len;
    vw.ownclip = 1;

    memset(blk, 0, sizeof blk);
    blk[0] = 24;                        /* size                       */
    blk[3] = 0;                         /* your_ref                   */
    blk[4] = Msg_ClaimEntity;
    blk[5] = ENTITY_CLIPBOARD;
    _swix(XWimp_SendMessage, _INR(0, 2), 17, blk, 0);   /* broadcast  */
}

/* Someone wants the clipboard: offer it as plain text.              */
static void
clipboard_send(int *msg)
{
    int blk[16];
    int theirtask = msg[1];

    if (!vw.ownclip || vw.clip == NULL) {
        return;
    }
    if ((msg[9] & ENTITY_CLIPBOARD) == 0) {
        return;                         /* +36 flags: not clipboard   */
    }
    memset(blk, 0, sizeof blk);
    blk[0] = 60;
    blk[3] = msg[2];                    /* your_ref = their my_ref    */
    blk[4] = Msg_DataSave;
    blk[5] = msg[5];                    /* window                     */
    blk[6] = msg[6];                    /* icon                       */
    blk[7] = msg[7];                    /* x                          */
    blk[8] = msg[8];                    /* y                          */
    blk[9] = (int) vw.cliplen;          /* estimated size             */
    blk[10] = 0xFFF;                    /* filetype: Text             */
    strcpy((char *) &blk[11], "Selection");
    _swix(XWimp_SendMessage, _INR(0, 2), 17, blk, theirtask);
    vw.savemyref = blk[2];              /* filled in by the Wimp      */
}

/* They answered with somewhere to put it: write the file and tell
   them where it is.                                                 */
static void
clipboard_saveack(int *msg)
{
    const char *path = (const char *) &msg[11];
    int blk[16];
    _kernel_oserror *e;

    if (!vw.ownclip || vw.clip == NULL) {
        return;
    }
    e = _swix(XOS_File, _INR(0, 5), 10, path, 0xFFF, 0,
              vw.clip, vw.clip + vw.cliplen);
    if (e != NULL) {
        report_oserr(e);
        return;
    }
    memcpy(blk, msg, 60);
    blk[0] = 60;
    blk[3] = msg[2];                    /* your_ref = their my_ref    */
    blk[4] = Msg_DataLoad;
    blk[9] = (int) vw.cliplen;
    blk[10] = 0xFFF;
    _swix(XWimp_SendMessage, _INR(0, 2), 17, blk, msg[1]);
}

/* --- event handling ------------------------------------------------- */

static void
toolbar_click(int icon)
{
    switch (icon) {
    case IC_PREV:
        if (vw.page > 0) {
            vw.page--;
            rerender();
        }
        break;
    case IC_NEXT:
        if (vw.page + 1 < vw.npages) {
            vw.page++;
            rerender();
        }
        break;
    case IC_ZOUT:
    case IC_ZIN:
        {
            int i, cur = 0;
            for (i = 0; i < NZOOM; i++) {
                if (zoomsteps[i] == vw.zoom) {
                    cur = i;
                }
            }
            if (icon == IC_ZOUT && cur > 0) {
                vw.zoom = zoomsteps[cur - 1];
                rerender();
            } else if (icon == IC_ZIN && cur < NZOOM - 1) {
                vw.zoom = zoomsteps[cur + 1];
                rerender();
            }
        }
        break;
    case IC_PRINT:
        print_page();
        break;
    }
}

static void
poll_loop(void)
{
    int blk[64];
    int event;

    while (!vw.quit) {
        if (_swix(XWimp_Poll, _INR(0, 1) | _OUT(0),
                  vw.dragging ? 0x30 : 0x31, blk, &event) != NULL) {
            return;
        }
        switch (event) {
        case 0:                         /* null: tracking a drag      */
            if (vw.dragging) {
                int pi[8], st[16], wx, wy, idx;

                _swix(XWimp_GetPointerInfo, _IN(1), pi);
                if ((pi[2] & 0x54) == 0) {
                    vw.dragging = 0;    /* button released            */
                    break;
                }
                st[0] = vw.win;
                _swix(XWimp_GetWindowState, _IN(1), st);
                wx = pi[0] - (st[1] - st[5]);
                wy = pi[1] - (st[4] - st[6]);
                idx = glyph_at(wx, wy);
                if (idx >= 0 && idx != vw.selto) {
                    vw.selto = idx;
                    vw.selfrom = vw.anchor;
                    redraw_doc();
                }
            }
            break;
        case 1:                         /* redraw                     */
            if (blk[0] == vw.win) {
                redraw_main(blk);
            }
            break;
        case 2:                         /* open                      */
            if (blk[0] == vw.win) {
                open_with_pane(blk);
            } else if (blk[0] == vw.pane) {
                /* Deliberately nothing.  Once the bar is nested the
                   Wimp keeps it with its parent, and re-opening it
                   with the plain form would drop the parent link and
                   leave it floating as a top-level window.        */
                ;
            } else {
                _swix(XWimp_OpenWindow, _IN(1), blk);
            }
            break;
        case 3:                         /* close                     */
            if (blk[0] == vw.win) {
                vw.quit = 1;
            }
            break;
        case 6:                         /* mouse click               */
            if (blk[3] == vw.pane) {
                toolbar_click(blk[4]);
            } else if (blk[3] == vw.win && (blk[2] & 2) != 0) {
                /* Menu button over the page: the text menu          */
                update_menu();
                _swix(XWimp_CreateMenu, _INR(1, 3),
                      &selmenu, blk[0] - 64, blk[1]);
            } else if (blk[3] == vw.win && (blk[2] & 0x54) != 0) {
                /* Select (4) or Select-drag (64) in the page: start
                   or extend a text selection                        */
                int st[16], wx, wy, idx;

                st[0] = vw.win;
                _swix(XWimp_GetWindowState, _IN(1), st);
                wx = blk[0] - (st[1] - st[5]);
                wy = blk[1] - (st[4] - st[6]);
                /* claim the input focus (invisible caret) so the
                   keyboard shortcuts reach us                      */
                _swix(XWimp_SetCaretPosition, _INR(0, 5),
                      vw.win, -1, 0, 0, (1 << 25) | 40, 0);
                idx = glyph_at(wx, wy);
                if (idx >= 0) {
                    vw.anchor = idx;
                    vw.selfrom = vw.selto = idx;
                    vw.dragging = 1;
                    redraw_doc();
                } else if (vw.selfrom >= 0) {
                    vw.selfrom = vw.selto = -1;
                    redraw_doc();
                }
            }
            break;
        case 9:                         /* menu selection            */
            switch (blk[0]) {
            case MENU_COPY:
                clipboard_copy();
                break;
            case MENU_ALL:
                if (vw.nglyphs) {
                    vw.selfrom = 0;
                    vw.selto = (int) vw.nglyphs - 1;
                    redraw_doc();
                }
                break;
            case MENU_SAVE:
                save_selection();
                break;
            default:
                break;
            }
            break;
        case 8:                         /* key pressed               */
            if (blk[6] == 3) {          /* Ctrl-C                    */
                clipboard_copy();
            } else if (blk[6] == 1) {   /* Ctrl-A: select all        */
                if (vw.nglyphs) {
                    vw.selfrom = 0;
                    vw.selto = (int) vw.nglyphs - 1;
                    redraw_doc();
                }
            } else if (blk[6] == 0x18E) {   /* Page Down             */
                toolbar_click(IC_NEXT);
            } else if (blk[6] == 0x19E) {   /* Page Up               */
                toolbar_click(IC_PREV);
            } else {
                _swix(0x400E6, _INR(0, 1), 0, blk);     /* pass on   */
            }
            break;
        case 17:
        case 18:
            switch (blk[4]) {
            case 0:                     /* Message_Quit              */
                vw.quit = 1;
                break;
            case Msg_DataRequest:
                clipboard_send(blk);
                break;
            case Msg_DataSaveAck:
                clipboard_saveack(blk);
                break;
            case Msg_ModeChange:
                /* Both the size of a pixel and the height of the
                   scroll bar row change with the mode, so the extent
                   and the embedded bar have to be worked out again -
                   otherwise the bar ends up a row adrift.         */
                vw.xeig = readmodevar(4);
                vw.yeig = readmodevar(5);
                vw.barnested = 0;       /* force a full re-layout    */
                set_extent();
                {
                    int st[16];

                    st[0] = vw.win;
                    if (_swix(XWimp_GetWindowState, _IN(1), st) == NULL
                        && (st[8] & (1 << 16)) != 0) {
                        arrange_toolbar(st);
                    }
                }
                break;
            case Msg_ClaimEntity:
                /* someone else took the clipboard                   */
                if (blk[1] != vw.task && (blk[5] & ENTITY_CLIPBOARD)) {
                    vw.ownclip = 0;
                    free(vw.clip);
                    vw.clip = NULL;
                    vw.cliplen = 0;
                }
                break;
            default:
                break;
            }
            break;
        default:
            break;
        }
    }
}

/* --- icon bar ------------------------------------------------------- */

/* Run with no file, the viewer is just an icon on the icon bar: drop a
   document on it to open one.  A document window is a separate copy of
   this binary (the Filer runs one per file through the filetype alias),
   so only this no-file copy ever creates a bar icon - otherwise every
   open document would add another identical one.                     */

#define IB_MENU_INFO  0
#define IB_MENU_QUIT  1
#define IB_MENU_ITEMS 2

static struct {
    char title[12];
    char tfcol, tbcol, wfcol, wbcol;
    int width, height, gap;
    struct {
        int flags;
        int submenu;
        int iconflags;
        char text[12];
    } item[IB_MENU_ITEMS];
} barmenu;

static void
build_barmenu(void)
{
    static const char *const names[IB_MENU_ITEMS] = { "Info", "Quit" };
    int i;

    memset(&barmenu, 0, sizeof barmenu);
    strcpy(barmenu.title, "Viewer");
    barmenu.tfcol = 7;
    barmenu.tbcol = 2;
    barmenu.wfcol = 7;
    barmenu.wbcol = 0;
    barmenu.width = 200;
    barmenu.height = 44;
    barmenu.gap = 0;
    for (i = 0; i < IB_MENU_ITEMS; i++) {
        barmenu.item[i].submenu = -1;
        barmenu.item[i].iconflags = 0x07000021;         /* text, filled */
        strcpy(barmenu.item[i].text, names[i]);
    }
    barmenu.item[IB_MENU_ITEMS - 1].flags |= 0x80;      /* last item    */
}

/* Hand a dropped file to a fresh copy of ourselves, the same way the
   Filer would open it.                                              */
static void
bar_open_file(const char *path)
{
    char cmd[320];

    /* PDFRenderV$Viewer is what the module puts in Alias$@RunType_*,
       so this is exactly the command a double-click would run.     */
    sprintf(cmd, "Run <PDFRenderV$Viewer> %.280s", path);
    _swix(XWimp_StartTask, _IN(0), cmd);
}

/* Is another copy already sitting on the icon bar?

   PDFRenderV$BarTask holds the task handle of whichever copy owns the
   icon.  Ping that handle directly and wait for the answer: a live
   copy replies with a pong, and if the handle is stale - the previous
   copy died without tidying up, or the Wimp has since reused the
   number for something else - the message either fails outright or
   bounces back unacknowledged, and we take the icon over.  The
   message goes to one task rather than being broadcast, so there is
   no race between the reply and the bounce.                        */
static int
bar_already_running(void)
{
    int blk[16];
    int other = 0, len = 0;
    char val[16];
    int i;

    if (_swix(XOS_ReadVarVal, _INR(0, 4) | _OUT(2),
              "PDFRenderV$BarTask", val, (int) sizeof val - 1, 0, 3,
              &len) != NULL || len <= 0) {
        return 0;
    }
    val[len] = 0;
    other = atoi(val);
    if (other == 0 || other == vw.task) {
        return 0;
    }

    memset(blk, 0, sizeof blk);
    blk[0] = 20;                        /* message size              */
    blk[3] = 0;                         /* your_ref: a new message   */
    blk[4] = Msg_BarPing;
    if (_swix(XWimp_SendMessage, _INR(0, 2), 18, blk, other) != NULL) {
        return 0;                       /* no such task              */
    }
    for (i = 0; i < 32; i++) {
        int event = 0;

        if (_swix(XWimp_Poll, _INR(0, 1) | _OUT(0), 1, blk, &event)
            != NULL) {
            return 0;
        }
        if ((event == 17 || event == 18) && blk[4] == Msg_BarPong) {
            return 1;                   /* someone is there          */
        }
        if (event == 19 && blk[4] == Msg_BarPing) {
            return 0;                   /* nobody answered           */
        }
    }
    return 0;
}

static void
set_bartask(int handle)
{
    char val[16];

    if (handle == 0) {
        _swix(XOS_SetVarVal, _INR(0, 4),
              "PDFRenderV$BarTask", val, -1, 0, 0);   /* delete      */
        return;
    }
    sprintf(val, "%d", handle);
    _swix(XOS_SetVarVal, _INR(0, 4),
          "PDFRenderV$BarTask", val, (int) strlen(val), 0, 0);
}

static int
bar_main(void)
{
    int blk[64];
    int icon = 0;
    int quit = 0;

    /* One icon, however many times the application is started.      */
    if (bar_already_running()) {
        _swix(XWimp_CloseDown, _INR(0, 1), vw.task, WIMP_NEST_MAGIC);
        return 0;
    }

    /* Icon bar, left-hand (device) side, immediately to the right of
       the ROM 'Apps' icon.  Handle -5 is "left side, scanning from the
       left" with R0 a priority; the PRM's table gives Apps &50000000
       and the RAM disc &40000000, and higher priority sits nearer the
       outside, so &4F000000 lands us just inside Apps.              */
    memset(blk, 0, sizeof blk);
    blk[0] = -5;                        /* left side, by priority     */
    blk[1] = 0;                         /* x0                         */
    blk[2] = 0;                         /* y0                         */
    blk[3] = 68;                        /* x1: the icon is 68 wide    */
    /* The PRM asks for a 68 OS unit square, which is right for the
       standard tool sprites - but a taller theme leaves a 68-high box
       sitting on the floor of the bar with the sprite stranded below
       everything else (measured: 16 pixels low against the Filer's
       icons).  The sprite is placed in the box, not stretched to it,
       so a box the height of a generous bar plus the centring flags
       below puts it level whatever the theme.                      */
    blk[4] = 136;                       /* y1                         */
    /* sprite, horizontally and vertically centred, button type 3
       (click) so Select and Menu both reach us                      */
    blk[5] = (1 << 1) | (1 << 3) | (1 << 4) | (3 << 12);
    strcpy((char *) &blk[6], "!viewer");
    if (_swix(XWimp_CreateIcon, _INR(0, 1) | _OUT(0),
              0x4F000000, blk, &icon) != NULL) {
        return 1;
    }
    set_bartask(vw.task);
    build_barmenu();

    while (!quit) {
        int event = 0;

        if (_swix(XWimp_Poll, _INR(0, 1) | _OUT(0), 1, blk, &event)
            != NULL) {
            break;
        }
        switch (event) {
        case 6:                         /* mouse click               */
            if (blk[3] == -2) {         /* on the icon bar           */
                if ((blk[2] & 2) != 0) {        /* Menu              */
                    _swix(XWimp_CreateMenu, _INR(1, 3), &barmenu,
                          blk[0] - 64, 96 + IB_MENU_ITEMS * 44);
                }
            }
            break;
        case 9:                         /* menu selection            */
            if (blk[0] == IB_MENU_QUIT) {
                quit = 1;
            } else if (blk[0] == IB_MENU_INFO) {
                report("PDFRenderV Viewer 1.00 - PDF, JPEG, PNG, "
                       "Sprite and Draw");
            }
            break;
        case 17:
        case 18:
            switch (blk[4]) {
            case 0:                     /* Message_Quit              */
                quit = 1;
                break;
            case Msg_DataLoad:
                /* a file dropped on the icon: open it, then
                   acknowledge so the sender does not report the
                   transfer as failed                              */
                bar_open_file((const char *) &blk[11]);
                blk[3] = blk[2];        /* your_ref = their my_ref   */
                blk[4] = Msg_DataLoadAck;
                _swix(XWimp_SendMessage, _INR(0, 2), 17, blk, blk[1]);
                break;
            case Msg_BarPing:
                /* another copy is starting up and asking whether the
                   icon is taken.  It is.                          */
                {
                    int who = blk[1];

                    blk[3] = blk[2];
                    blk[4] = Msg_BarPong;
                    _swix(XWimp_SendMessage, _INR(0, 2), 17, blk, who);
                }
                break;
            default:
                break;
            }
            break;
        default:
            break;
        }
    }
    set_bartask(0);
    {
        int del[2];                     /* blk has long since been
                                           overwritten by Wimp_Poll  */
        del[0] = -2;                    /* icon bar                  */
        del[1] = icon;
        _swix(XWimp_DeleteIcon, _IN(1), del);
    }
    _swix(XWimp_CloseDown, _INR(0, 1), vw.task, WIMP_NEST_MAGIC);
    return 0;
}

/* --- entry ---------------------------------------------------------- */

int
main(int argc, char **argv)
{
    _kernel_oserror *e;

    dbg(1);
    /* Register with the Wimp first.
       R3 must be a pointer to a message list, NOT zero: with Wimp
       310 a null POINTER means "no messages wanted" while a null
       LIST means "all messages" - the reverse of what one expects
       (PRM, Wimp_Initialise).  Passing 0 here silently cost us every
       Message_DataRequest, i.e. the whole clipboard.               */
    {
        static const int wanted[] = {
            Msg_DataSave, Msg_DataSaveAck, Msg_DataLoad,
            Msg_ClaimEntity, Msg_DataRequest,
            Msg_ModeChange, Msg_BarPing, Msg_BarPong, 0
        };
        /* 380, not 310: the nested Wimp only makes its child-window
           features available to a task that asks for that version,
           and the toolbar is a nested furniture window.           */
        e = _swix(XWimp_Initialise, _INR(0, 3) | _OUT(1),
                  380, WIMP_NEST_MAGIC, "PDFRenderV", wanted, &vw.task);
    }
    if (e != NULL) {
        fprintf(stderr, "PDFRenderV: %s\n", e->errmess);
        return 1;
    }
    dbg(2);
    if (argc < 2) {
        /* No document: be the icon bar application instead          */
        return bar_main();
    }
    /* CLib splits the tail on spaces; rejoin so paths containing
       spaces survive                                                 */
    {
        int i;
        vw.filename[0] = 0;
        for (i = 1; i < argc; i++) {
            if (i > 1) {
                strncat(vw.filename, " ",
                        sizeof vw.filename - strlen(vw.filename) - 1);
            }
            strncat(vw.filename, argv[i],
                    sizeof vw.filename - strlen(vw.filename) - 1);
        }
    }
    vw.zoom = 100;
    vw.selfrom = vw.selto = -1;

    /* the module does everything document-shaped                     */
    {
        int handle = 0, npages = 0;
        e = _swix(PDFRenderV_Open, _INR(0, 1) | _OUT(0) | _OUT(1),
                  0, vw.filename, &handle, &npages);
        if (e != NULL) {
            report_oserr(e);
            _swix(XWimp_CloseDown, _INR(0, 1), vw.task, 0x4B534154);
            return 1;
        }
        vw.handle = handle;
        vw.npages = (u32) npages;
    }
    /* PDFRenderV_Info returns the filetype in R1 for non-PDF files,
       so the viewer can tell a document from a picture              */
    {
        int pages = 0, info = 0;
        if (_swix(PDFRenderV_Info, _IN(0) | _OUT(0) | _OUT(1),
                  vw.handle, &pages, &info) == NULL) {
            vw.isimage = info > 0xFF;   /* a filetype, not a version */
        }
    }
    dbg(3);

    vw.xeig = readmodevar(4);
    vw.yeig = readmodevar(5);
    sprintf(vw.titletxt, "%.290s", vw.filename);
    fit_zoom();

    if (render_page() != 0) {
        report("Could not render the first page");
    }
    dbg(4);
    if (create_windows() != 0) {
        _swix(PDFRenderV_Close, _IN(0), vw.handle);
        _swix(XWimp_CloseDown, _INR(0, 1), vw.task, 0x4B534154);
        return 1;
    }
    dbg(5);
    update_toolbar_texts();
    build_menu();

    /* open centred-ish via a GetWindowState + open                    */
    {
        int st[16];
        st[0] = vw.win;
        _swix(XWimp_GetWindowState, _IN(1), st);
        st[7] = -1;
        open_with_pane(st);
    }
    dbg(6);

    poll_loop();

    free_sprite();
    free_glyphs();
    free(vw.clip);
    _swix(PDFRenderV_Close, _IN(0), vw.handle);
    _swix(XWimp_CloseDown, _INR(0, 1), vw.task, 0x4B534154);
    return 0;
}
