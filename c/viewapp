/* One glyph as PDFRenderV_ExtractText returns it: device units,
   16.16, origin bottom left of the page.                            */
typedef struct {
    s32 x0, y0, x1, y1;
    u32 ch;
} Glyph;

/* toolbar icon numbers (creation order below) */
#define IC_PREV  0
#define IC_PAGE  1
#define IC_NEXT  2
#define IC_ZOUT  3
#define IC_ZOOM  4
#define IC_ZIN   5
#define IC_PRINT 6

static const int zoomsteps[] = { 25, 50, 75, 100, 125, 150, 200, 300, 400 };
#define NZOOM ((int) (sizeof zoomsteps / sizeof zoomsteps[0]))

typedef struct {
    int handle;                 /* module document handle             */
    u32 npages;
    char filename[256];
    u32 page;                   /* 0-based                            */
    int zoom;                   /* percent                            */
    /* sprite in a dynamic area */
    int danum;
    u8 *area;
    int sprw, sprh;             /* pixels                             */
    /* wimp */
    int task;
    int win, pane;
    int xeig, yeig;
    char pagetxt[16], zoomtxt[12];
    char titletxt[300];
    /* text selection */
    Glyph *glyphs;
    u32 nglyphs;
    int selfrom, selto;         /* glyph indices, -1 = no selection   */
    int dragging;
    int anchor;
    /* clipboard */
    char *clip;                 /* our selection, if we own it        */
    u32 cliplen;
    int ownclip;
    int savemyref;              /* my_ref of the DataSave we sent     */
    int isimage;                /* JPEG/PNG/Sprite/Draw, not a PDF    */
    int quit;
