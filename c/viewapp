/* The toolbar is embedded in the document window's horizontal scroll
   bar, so its height is not ours to pick - it is whatever the scroll
   bar is in the current mode and theme, worked out at open time.
   Only the horizontal layout is fixed.  (Nested Wimp; see
   arrange_toolbar.)                                                 */
static const struct { int x0, x1; } toollayout[] = {
    {   8,  56 },                       /* IC_PREV   <                */
    {  60, 172 },                       /* IC_PAGE   n/N              */
    { 176, 224 },                       /* IC_NEXT   >                */
    { 244, 292 },                       /* IC_ZOUT   -                */
    { 296, 384 },                       /* IC_ZOOM   100%             */
    { 388, 436 },                       /* IC_ZIN    +                */
    { 456, 568 }                        /* IC_PRINT  Print            */
};
#define NTOOL ((int) (sizeof toollayout / sizeof toollayout[0]))
#define TOOLW 576                       /* bar width, OS units        */

