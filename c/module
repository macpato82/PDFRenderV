#define XOS_File        (0x08)
#define XOS_SpriteOp    (0x2E)
#define XOS_Write0      (0x02)
#define XOS_NewLine     (0x03)
#define XOS_Module      (0x1E)
#define XOS_CLI         (0x05)
#define XOS_ReadVarVal  (0x23)
#define XOS_SetVarVal   (0x24)

#define XDrawFile_Render (0x45540)
#define XDrawFile_BBox   (0x45541)
#define XJPEG_Info       (0x49980)
#define XJPEG_PlotScaled (0x49982)

/* Filetypes we open.  The viewer is a previewer, not just a PDF
   reader: everything here appears in the same window with the same
   zoom and print controls.                                          */
#define FT_PDF     0xADF
#define FT_JPEG    0xC85
#define FT_PNG     0xB60
#define FT_SPRITE  0xFF9
#define FT_DRAW    0xAFF

#define RUNTYPE_VAR   "Alias$@RunType_ADF"
#define CLAIM_VAR     "PDFRenderV$Claim"
#define VIEWER_VAR    "PDFRenderV$Viewer"

#define SPRITE_MODE_32BPP_180 \
    ((6u << 27) | (180u << 14) | (180u << 1) | 1u)

#define MAXDOCS 8

/* A document is a PDF or a single-page image/drawing.  Everything
   below the SWI layer works the same way for both.                  */
typedef struct {
    int inuse;
    int kind;                   /* FT_* of the opened file           */
    PdfDoc *doc;                /* FT_PDF only                       */
    u8 *buf;                    /* whole file                        */
    u32 len;
    int w, h;                   /* image pixels, or Draw OS units    */
} DocSlot;

static DocSlot docs[MAXDOCS];

/* --- helpers -------------------------------------------------------- */

static void
wr0(const char *s)
{
    _swix(XOS_Write0, _IN(0), s);
    _swix(XOS_NewLine, 0);
}

static _kernel_oserror *
pdferr_to_os(int err)
{
    switch (err) {
    case PDF_OK:
        return NULL;
    case PDF_E_NOMEM:
        return err_NoMem;
    case PDF_E_ENCRYPTED:
        return err_Encrypted;
    case PDF_E_UNSUP:
        return err_Unsup;
    case PDF_E_RANGE:
        return err_BadPage;
    default:
        return err_BadPDF;
    }
}

/* Copy a CLI token (CR-terminated tail rule: anything <= ' ' ends).  */
static const char *
get_token(const char *p, char *out, int outsz)
{
    int n = 0;

    while (*p == ' ') {
        p++;
    }
    while ((unsigned char) *p > ' ' && n < outsz - 1) {
        out[n++] = *p++;
    }
    out[n] = 0;
    return p;
}

/* Load a whole file into a malloc'd buffer.                          */
static _kernel_oserror *
load_file(const char *name, u8 **bufp, u32 *lenp, int *typep)
{
    _kernel_oserror *e;
    int objtype = 0, size = 0, loadaddr = 0;
    u8 *buf;

    e = _swix(XOS_File, _INR(0, 1) | _OUT(0) | _OUT(2) | _OUT(4),
              17, name, &objtype, &loadaddr, &size);
    /* a typed file has &FFFtttdd in its load address                 */
    if (typep != NULL) {
        *typep = ((loadaddr >> 20) & 0xFFF) == 0xFFF
                 ? (loadaddr >> 8) & 0xFFF : -1;
    }
    if (e != NULL) {
        return e;
    }
    if (objtype != 1 && objtype != 3) {
        return err_BadPDF;
    }
    if (size < 8 || size > 0x10000000) {
        return err_BadPDF;
    }
    buf = malloc((u32) size);
    if (buf == NULL) {
        return err_NoMem;
    }
    e = _swix(XOS_File, _INR(0, 3), 255, name, buf, 0);
    if (e != NULL) {
        free(buf);
        return e;
    }
    *bufp = buf;
    *lenp = (u32) size;
    return NULL;
}

/* Work out what a file is: its filetype if it has a useful one,
   otherwise sniff the signature (HostFS and archives lose types).   */
static int
sniff_kind(int filetype, const u8 *buf, u32 len)
{
    switch (filetype) {
    case FT_PDF: case FT_JPEG: case FT_PNG:
    case FT_SPRITE: case FT_DRAW:
        return filetype;
    default:
        break;
    }
    if (len >= 5 && memcmp(buf, "%PDF-", 5) == 0) {
        return FT_PDF;
    }
    if (len >= 8 && buf[0] == 0x89 && memcmp(buf + 1, "PNG", 3) == 0) {
        return FT_PNG;
    }
    if (len >= 3 && buf[0] == 0xFF && buf[1] == 0xD8 && buf[2] == 0xFF) {
        return FT_JPEG;
    }
    if (len >= 4 && memcmp(buf, "Draw", 4) == 0) {
        return FT_DRAW;
    }
    return -1;
}

/* Image geometry, so PageSize can answer before anything is drawn.  */
static _kernel_oserror *
measure_doc(DocSlot *ds)
{
    switch (ds->kind) {
    case FT_JPEG:
        {
            int w = 0, h = 0;
            _kernel_oserror *e =
                _swix(XJPEG_Info, _INR(0, 2) | _OUT(2) | _OUT(3),
                      1, ds->buf, ds->len, &w, &h);
            if (e != NULL) {
                return e;
            }
            ds->w = w;
            ds->h = h;
            return NULL;
        }
    case FT_PNG:
        {
            /* IHDR is always the first chunk: 8-byte signature, then
               length+type, then width/height big-endian            */
            if (ds->len < 24 || memcmp(ds->buf + 12, "IHDR", 4) != 0) {
                return err_BadPDF;
            }
            ds->w = (int) ((u32) ds->buf[16] << 24 | (u32) ds->buf[17] << 16 |
                           (u32) ds->buf[18] << 8 | ds->buf[19]);
            ds->h = (int) ((u32) ds->buf[20] << 24 | (u32) ds->buf[21] << 16 |
                           (u32) ds->buf[22] << 8 | ds->buf[23]);
            return NULL;
        }
    case FT_SPRITE:
        {
            /* sprite file: count, first, free, then the sprite      */
            const u32 *a = (const u32 *) ds->buf;
            const u32 *sp;
            if (ds->len < 60 || a[0] == 0) {
                return err_BadPDF;
            }
            sp = (const u32 *) (ds->buf + a[1] - 4);
            ds->w = (int) sp[4] + 1;    /* width in words - 1        */
            ds->h = (int) sp[5] + 1;
            {   /* words hold several pixels below 32bpp             */
                u32 mode = sp[10];
                int type = (int) ((mode >> 27) & 31);
                int bpp = type == 6 ? 32 : type == 5 ? 16 : type == 4 ? 8
                        : type == 3 ? 4 : type == 2 ? 2 : type == 1 ? 1 : 0;
                if (bpp && bpp < 32) {
                    ds->w = ds->w * (32 / bpp) -
                            (int) ((31 - sp[7]) / (u32) bpp);
                }
            }
            return NULL;
        }
    case FT_DRAW:
        {
            int bbox[4];
            _kernel_oserror *e =
                _swix(XDrawFile_BBox, _INR(0, 4),
                      0, ds->buf, ds->len, 0, bbox);
            if (e != NULL) {
                return e;
            }
            /* Draw units are 1/256 OS unit; keep OS units here      */
            ds->w = (bbox[2] - bbox[0]) / 256;
            ds->h = (bbox[3] - bbox[1]) / 256;
            if (ds->w < 1) ds->w = 1;
            if (ds->h < 1) ds->h = 1;
            return NULL;
        }
    default:
        return err_BadPDF;
    }
}

static _kernel_oserror *
open_doc(const char *name, int *handlep)
{
    int i, filetype = -1, kind;
    u8 *buf;
    u32 len;
    PdfDoc *doc;
    _kernel_oserror *e;

    for (i = 0; i < MAXDOCS; i++) {
        if (!docs[i].inuse) {
            break;
        }
    }
    if (i == MAXDOCS) {
        return err_NoMem;
    }
    e = load_file(name, &buf, &len, &filetype);
    if (e != NULL) {
        return e;
    }
    kind = sniff_kind(filetype, buf, len);
    if (kind < 0) {
        free(buf);
        return err_BadPDF;
    }
    docs[i].kind = kind;
    docs[i].buf = buf;
    docs[i].len = len;
    if (kind == FT_PDF) {
        int err = pdf_open(&doc, buf, len);
        if (err != PDF_OK) {
            free(buf);
            docs[i].buf = NULL;
            return pdferr_to_os(err);
        }
        docs[i].doc = doc;
    } else {
        e = measure_doc(&docs[i]);
        if (e != NULL) {
            free(buf);
            docs[i].buf = NULL;
            return e;
        }
    }
    docs[i].inuse = 1;
    *handlep = i + 1;
    return NULL;
}

static DocSlot *
get_doc(int handle)
{
    if (handle < 1 || handle > MAXDOCS || !docs[handle - 1].inuse) {
        return NULL;
    }
    return &docs[handle - 1];
}

static void
close_doc(DocSlot *ds)
{
    if (ds->doc != NULL) {
        pdfimg_cache_flush(ds->doc);
        pdf_close(ds->doc);
    }
    free(ds->buf);
    ds->doc = NULL;
    ds->buf = NULL;
    ds->len = 0;
    ds->inuse = 0;
}

static u32
doc_pages(DocSlot *ds)
{
    return ds->kind == FT_PDF ? ds->doc->npages : 1;
}

/* Render page (0-based) direct to the current VDU output at zoom
   (16.16 device units per point).  Used inside PDriver print jobs,
   which intercept the Draw/Font/sprite calls.                        */
static _kernel_oserror *
render_direct(PdfDoc *doc, u32 page, fix zoom)
{
    RoRender *rr;
    fix pw, ph;
    int rot, err;

    if (zoom <= 0) {
        return err_BadPage;
    }
    if (pdf_pagegeom(doc, page, &pw, &ph, &rot) != PDF_OK) {
        return err_BadPage;
    }
    if (rot == 90 || rot == 270) {
        fix t = pw;
        pw = ph;
        ph = t;
    }
    rr = malloc(sizeof *rr);
    if (rr == NULL) {
        return err_NoMem;
    }
    rorender_begin_direct(rr, FX_TOINT(fx_mul(pw, zoom)),
                          FX_TOINT(fx_mul(ph, zoom)));
    err = pdf_runpage(doc, page, &rr->be, zoom);
    rorender_end(rr);
    free(rr);
    return pdferr_to_os(err);
}

/* Draw a non-PDF document into the sprite that output is already
   redirected to.  devw/devh is the sprite; everything is scaled to
   fit and centred, exactly as the PDF path does.                    */
/* Each format gets its own small function: one big switch tripped a
   Norcroft internal error (cse_adconbase) in its common-subexpression
   pass, and smaller functions are clearer anyway.                    */

static _kernel_oserror *
plot_jpeg(DocSlot *ds, int dx, int dy, int dw, int dh)
{
    u32 scale[4];

    scale[0] = (u32) dw;
    scale[1] = (u32) dh;
    scale[2] = (u32) ds->w;
    scale[3] = (u32) ds->h;
    return _swix(XJPEG_PlotScaled, _INR(0, 5),
                 ds->buf, dx, dy, scale, ds->len, 0);
}

/* A sprite FILE is a sprite area without its leading size word, so
   rebuild that word in a copy before plotting.                      */
static _kernel_oserror *
plot_sprite(DocSlot *ds, int dx, int dy, int dw, int dh)
{
    u8 *area = malloc(ds->len + 4);
    _kernel_oserror *e;
    u32 scale[4];
    u32 first;

    if (area == NULL) {
        return err_NoMem;
    }
    /* A sprite area's offsets are measured from the size word, which
       the FILE format omits; rebuild it in place so `first` is
       already correct - do NOT add 4 again.                         */
    ((u32 *) area)[0] = ds->len + 4;
    memcpy(area + 4, ds->buf, ds->len);
    first = ((u32 *) area)[2];
    scale[0] = (u32) dw;
    scale[1] = (u32) dh;
    scale[2] = (u32) ds->w;
    scale[3] = (u32) ds->h;
    /* Plot action 8: overwrite, *using the mask* (PRM, Sprites: bit 3
       of the plot action).  Without it a masked sprite is drawn
       including whatever lies under its mask, which is usually black,
       so a transparent logo arrived on a black rectangle.          */
    e = _swix(XOS_SpriteOp, _INR(0, 7),
              52 + 512, area, area + first, dx, dy, 8, scale, 0);
    free(area);
    return e;
}

/* Draw matrix: a,b,c,d in 1/65536, e,f in 1/256 OS unit (PRM, Draw
   module).  Scale to fit, then move the bounding box to (dx, dy).   */
static _kernel_oserror *
plot_draw(DocSlot *ds, int dx, int dy, int dw)
{
    int bbox[4], m[6];
    s64 sx;
    _kernel_oserror *e;

    e = _swix(XDrawFile_BBox, _INR(0, 4), 0, ds->buf, ds->len, 0, bbox);
    if (e != NULL) {
        return e;
    }
    sx = ((s64) dw << 16) / (ds->w > 0 ? ds->w : 1);
    m[0] = (int) sx;
    m[1] = 0;
    m[2] = 0;
    m[3] = (int) sx;
    m[4] = dx * 256 - (int) (((s64) bbox[0] * sx) >> 16);
    m[5] = dy * 256 - (int) (((s64) bbox[1] * sx) >> 16);
    return _swix(XDrawFile_Render, _INR(0, 4),
                 0, ds->buf, ds->len, m, 0);
}

/* Wrap decoded pixels in a temporary 32bpp sprite and plot it.      */
static _kernel_oserror *
plot_pixels(u32 *pix, int w, int h, int dx, int dy, int dw, int dh)
{
    u32 total = 16 + 44 + (u32) w * (u32) h * 4;
    u8 *area = malloc(total);
    u32 *a, *hdr, scale[4];
    _kernel_oserror *e;

    if (area == NULL) {
        return err_NoMem;
    }
    a = (u32 *) area;
    a[0] = total;
    a[1] = 1;
    a[2] = 16;
    a[3] = total;
    hdr = a + 4;
    memset(hdr, 0, 44);
    hdr[0] = total - 16;
    memcpy(hdr + 1, "png", 4);
    hdr[4] = (u32) w - 1;
    hdr[5] = (u32) h - 1;
    hdr[6] = 0;
    hdr[7] = 31;
    hdr[8] = 44;
    hdr[9] = 44;
    hdr[10] = SPRITE_MODE_32BPP_180;
    memcpy(area + 16 + 44, pix, (u32) w * (u32) h * 4);
    scale[0] = (u32) dw;
    scale[1] = (u32) dh;
    scale[2] = (u32) w;
    scale[3] = (u32) h;
    e = _swix(XOS_SpriteOp, _INR(0, 7),
              52 + 512, area, area + 16, dx, dy, 0, scale, 0);
    free(area);
    return e;
}

static _kernel_oserror *
plot_png(DocSlot *ds, int dx, int dy, int dw, int dh)
{
    int w = 0, h = 0, err;
    u32 *pix = NULL;
    _kernel_oserror *e;

    err = pdfpng_decode(ds->buf, ds->len, &w, &h, &pix);
    if (err != PDF_OK) {
        return pdferr_to_os(err);
    }
    e = plot_pixels(pix, w, h, dx, dy, dw, dh);
    free(pix);
    return e;
}

/* Draw a non-PDF document into the sprite output is redirected to,
   scaled to fit and centred, exactly as the PDF path does.          */
static _kernel_oserror *
render_image(DocSlot *ds, int devw, int devh)
{
    int sw = ds->w, sh = ds->h;
    int dw, dh, dx, dy;

    if (sw < 1 || sh < 1) {
        return err_BadPDF;
    }
    dw = devw;
    dh = (int) (((s64) devw * sh) / sw);
    if (dh > devh) {
        dh = devh;
        dw = (int) (((s64) devh * sw) / sh);
    }
    dx = (devw - dw) / 2;
    dy = (devh - dh) / 2;

    if (ds->kind == FT_JPEG) {
        return plot_jpeg(ds, dx, dy, dw, dh);
    }
    if (ds->kind == FT_SPRITE) {
        return plot_sprite(ds, dx, dy, dw, dh);
    }
    if (ds->kind == FT_DRAW) {
        return plot_draw(ds, dx, dy, dw);
    }
    if (ds->kind == FT_PNG) {
        return plot_png(ds, dx, dy, dw, dh);
    }
    return err_BadPDF;
}

/* Render page (0-based) into sprite, scaled to fit.                  */
static _kernel_oserror *
render_into_sprite(DocSlot *ds, u32 page, void *area, void *sprite,
                   int whitebg)
{
    PdfDoc *doc = ds->doc;
    RoRender *rr;
    fix pw, ph, zoom, zx, zy;
    int rot, err;

    if (ds->kind != FT_PDF) {
        /* images and drawings: redirect, clear, plot, restore       */
        _kernel_oserror *e;

        rr = malloc(sizeof *rr);
        if (rr == NULL) {
            return err_NoMem;
        }
        err = rorender_begin(rr, area, sprite, whitebg);
        if (err != PDF_OK) {
            free(rr);
            return pdferr_to_os(err);
        }
        e = render_image(ds, rr->devw, rr->devh);
        rorender_end(rr);
        free(rr);
        return e;
    }
    if (pdf_pagegeom(doc, page, &pw, &ph, &rot) != PDF_OK) {
        return err_BadPage;
    }
    if (rot == 90 || rot == 270) {
        fix t = pw;
        pw = ph;
        ph = t;
    }
    rr = malloc(sizeof *rr);
    if (rr == NULL) {
        return err_NoMem;
    }
    err = rorender_begin(rr, area, sprite, whitebg);
    if (err != PDF_OK) {
        free(rr);
        return pdferr_to_os(err);
    }
    zx = fx_div(FX_FROMINT(rr->devw), pw);
    zy = fx_div(FX_FROMINT(rr->devh), ph);
    zoom = zx < zy ? zx : zy;
    err = pdf_runpage(doc, page, &rr->be, zoom);
    rorender_end(rr);
    free(rr);
    return pdferr_to_os(err);
}

/* --- module lifecycle ----------------------------------------------- */

static void claim_filetypes(void);

_kernel_oserror *
mod_init(const char *cmd_tail, int podule_base, void *pw)
{
    /* refuse to stack a second instance (the newest instance would
       otherwise shadow this one and confuse testing)                 */
    int count = 0, module = 0, section = 0;

    (void) cmd_tail;
    (void) podule_base;
    (void) pw;
    for (;;) {
        u8 *base = NULL;
        /* OS_Module 12: R1/R2 enumerate, R3 = module base; the title
           lives at base + word[base+&10] (PRM: Modules)              */
        if (_swix(XOS_Module, _INR(0, 2) | _OUT(1) | _OUT(2) | _OUT(3),
                  12, module, section, &module, &section,
                  &base) != NULL) {
            break;
        }
        if (base != NULL) {
            u32 toff = *(u32 *) (base + 0x10);
            if (toff != 0 &&
                strcmp((const char *) base + toff, "PDFRenderV") == 0) {
                count++;
            }
        }
    }
    if (count >= 2) {
        return err_Already;
    }
    memset(docs, 0, sizeof docs);
    claim_filetypes();
    return NULL;
}

/* Claim the filetypes listed in PDFRenderV$Claim (default: all the
   ones we can render) for the registered viewer.  Called at module
   init and again on Service_StartWimp, because applications whose
   !Boot runs after ours would otherwise take them back.            */
static void
claim_filetypes(void)
{
    char viewer[200];
    int len = 0;

    if (_swix(XOS_ReadVarVal, _INR(0, 4) | _OUT(2),
              VIEWER_VAR, viewer, (int) sizeof viewer - 1, 0, 0,
              &len) == NULL && len > 0) {
        static const char *const types[] = {
            "ADF", "C85", "B60", "FF9", "AFF"
        };
        char claim[128];
        int clen = 0, i;

        viewer[len] = 0;
        if (_swix(XOS_ReadVarVal, _INR(0, 4) | _OUT(2),
                  CLAIM_VAR, claim, (int) sizeof claim - 1, 0, 0,
                  &clen) != NULL || clen <= 0) {
            strcpy(claim, "ADF,C85,B60,FF9,AFF");
        } else {
            claim[clen] = 0;
        }
        for (i = 0; i < 5; i++) {
            char var[40], alias[256];

            if (strstr(claim, types[i]) == NULL) {
                continue;
            }
            sprintf(var, "Alias$@RunType_%s", types[i]);
            sprintf(alias, "Run %s %%*0", viewer);
            _swix(XOS_SetVarVal, _INR(0, 4),
                  var, alias, strlen(alias), 0, 0);
        }
    }
}

void
mod_service(int service_number, _kernel_swi_regs *r, void *pw)
{
    (void) r;
    (void) pw;
    if (service_number == 0x49) {       /* Service_StartWimp         */
        claim_filetypes();
    }
}

_kernel_oserror *
mod_final(int fatal, int podule, void *pw)
{
    int i;

    (void) fatal;
    (void) podule;
    (void) pw;
    for (i = 0; i < MAXDOCS; i++) {
        if (docs[i].inuse) {
            close_doc(&docs[i]);
        }
    }
    /* Release every filetype we claimed, but only where the alias
       still points at our viewer - never stamp on another app.     */
    {
        static const char *const types[] = {
            "ADF", "C85", "B60", "FF9", "AFF"
        };
        char viewer[200];
        int vlen = 0, i;

        if (_swix(XOS_ReadVarVal, _INR(0, 4) | _OUT(2),
                  VIEWER_VAR, viewer, (int) sizeof viewer - 1, 0, 0,
                  &vlen) == NULL && vlen > 0) {
            viewer[vlen] = 0;
            for (i = 0; i < 5; i++) {
                char var[40], cur[256];
                int len = 0;
                sprintf(var, "Alias$@RunType_%s", types[i]);
                if (_swix(XOS_ReadVarVal, _INR(0, 4) | _OUT(2),
                          var, cur, (int) sizeof cur - 1, 0, 0,
                          &len) != NULL || len <= 4) {
                    continue;
                }
                cur[len] = 0;
                if (strncmp(cur, "Run ", 4) == 0 &&
                    strncmp(cur + 4, viewer, strlen(viewer)) == 0) {
                    _swix(XOS_SetVarVal, _INR(0, 4), var, 0, -1, 0, 0);
                }
            }
        }
    }
    return NULL;
}

/* --- SWI dispatch --------------------------------------------------- */

_kernel_oserror *
mod_swi(int swi_no, _kernel_swi_regs *r, void *pw)
{
    (void) pw;
    switch (swi_no) {
    case SWIOFF_Open:
        {
            int handle = 0;
            _kernel_oserror *e =
                open_doc((const char *) r->r[1], &handle);
            if (e != NULL) {
                return e;
            }
            r->r[0] = handle;
            r->r[1] = (int) doc_pages(get_doc(handle));
            return NULL;
        }
    case SWIOFF_Close:
        {
            DocSlot *ds = get_doc(r->r[0]);
            if (ds == NULL) {
                return err_BadHandle;
            }
            close_doc(ds);
            return NULL;
        }
    case SWIOFF_Info:
        {
            DocSlot *ds = get_doc(r->r[0]);
            if (ds == NULL) {
                return err_BadHandle;
            }
            r->r[0] = (int) doc_pages(ds);
            r->r[1] = ds->kind == FT_PDF
                      ? (ds->doc->vermajor << 8) | ds->doc->verminor
                      : ds->kind;
            return NULL;
        }
    case SWIOFF_PageSize:
        {
            DocSlot *ds = get_doc(r->r[0]);
            fix w, h;
            int rot;
            if (ds == NULL) {
                return err_BadHandle;
            }
            if (r->r[1] < 1) {
                return err_BadPage;
            }
            if (ds->kind != FT_PDF) {
                /* one page; report the image at 1 pixel = 1 point so
                   100% zoom shows it close to actual size          */
                r->r[0] = ds->w * 1000;
                r->r[1] = ds->h * 1000;
                r->r[2] = 0;
                return NULL;
            }
            if (pdf_pagegeom(ds->doc, (u32) r->r[1] - 1, &w, &h,
                             &rot) != PDF_OK) {
                return err_BadPage;
            }
            /* 16.16 points -> millipoints                            */
            r->r[0] = (int) (((s64) w * 1000) >> 16);
            r->r[1] = (int) (((s64) h * 1000) >> 16);
            r->r[2] = rot;
            return NULL;
        }
    case SWIOFF_Render:
        {
            DocSlot *ds = get_doc(r->r[1]);
            if (ds == NULL) {
                return err_BadHandle;
            }
            if (r->r[2] < 1 || (u32) r->r[2] > doc_pages(ds)) {
                return err_BadPage;
            }
            if (ds->kind != FT_PDF && (r->r[0] & 2) == 0) {
                return render_into_sprite(ds, 0, (void *) r->r[3],
                                          (void *) r->r[4],
                                          r->r[0] & 1);
            }
            if (r->r[0] & 2) {
                /* direct mode: R3 = zoom (16.16 device units/point)  */
                return render_direct(ds->doc, (u32) r->r[2] - 1,
                                     (fix) r->r[3]);
            }
            return render_into_sprite(ds, (u32) r->r[2] - 1,
                                      (void *) r->r[3],
                                      (void *) r->r[4],
                                      r->r[0] & 1);
        }
    case SWIOFF_ExtractText:
        {
            DocSlot *ds = get_doc(r->r[1]);
            PdfGlyph *gl = NULL;
            u32 n = 0, need;
            int err;

            if (ds == NULL) {
                return err_BadHandle;
            }
            if (ds->kind != FT_PDF) {
                r->r[0] = 0;            /* an image has no text      */
                r->r[1] = 0;
                return NULL;
            }
            if (r->r[2] < 1 || (u32) r->r[2] > ds->doc->npages) {
                return err_BadPage;
            }
            err = pdf_extracttext(ds->doc, (u32) r->r[2] - 1,
                                  r->r[3] ? (fix) r->r[3] : FX_ONE,
                                  &gl, &n);
            if (err != PDF_OK) {
                free(gl);
                return pdferr_to_os(err);
            }
            need = n * (u32) sizeof(PdfGlyph);
            if (r->r[4] != 0 && (u32) r->r[5] >= need && need > 0) {
                memcpy((void *) r->r[4], gl, need);
            }
            free(gl);
            r->r[0] = (int) need;
            r->r[1] = (int) n;
            return NULL;
        }
    default:
        return err_BadSWI;
    }
}

/* --- * commands ----------------------------------------------------- */

static _kernel_oserror *
cmd_pdfinfo(const char *tail)
{
    char name[256];
    int handle = 0;
    _kernel_oserror *e;
    DocSlot *ds;
    char line[128];
    u32 p, show;

    get_token(tail, name, sizeof name);
    e = open_doc(name, &handle);
    if (e != NULL) {
        return e;
    }
    ds = get_doc(handle);
    if (ds->kind != FT_PDF) {
        const char *what = ds->kind == FT_JPEG ? "JPEG"
                         : ds->kind == FT_PNG ? "PNG"
                         : ds->kind == FT_SPRITE ? "Sprite" : "Draw";
        sprintf(line, "%s, %d x %d", what, ds->w, ds->h);
        wr0(line);
        close_doc(ds);
        return NULL;
    }
    sprintf(line, "PDF %d.%d, %u page%s", ds->doc->vermajor,
            ds->doc->verminor, ds->doc->npages,
            ds->doc->npages == 1 ? "" : "s");
    wr0(line);
    show = ds->doc->npages < 8 ? ds->doc->npages : 8;
    for (p = 0; p < show; p++) {
        fix w, h;
        int rot;
        if (pdf_pagegeom(ds->doc, p, &w, &h, &rot) == PDF_OK) {
            sprintf(line, "  page %u: %d x %d pt%s%d", p + 1,
                    FX_ROUND(w), FX_ROUND(h),
                    rot ? ", rotated " : "", rot);
            if (!rot) {
                line[strlen(line) - 1] = 0;
            }
            wr0(line);
        }
    }
    close_doc(ds);
    return NULL;
}

/* Turn a page's glyphs into plain text, inserting spaces and line
   breaks from the geometry (a PDF stores neither).                  */
static char *
glyphs_to_text(PdfGlyph *gl, u32 n, u32 *lenp)
{
    char *out = malloc((u32) n * 2 + 8);
    u32 i, k = 0;

    *lenp = 0;
    if (out == NULL) {
        return NULL;
    }
    for (i = 0; i < n; i++) {
        if (i > 0) {
            PdfGlyph *p = &gl[i - 1];
            s32 half = (p->y1 - p->y0) / 2;
            if (gl[i].y0 < p->y0 - half || gl[i].y0 > p->y0 + half) {
                out[k++] = 10;
            } else if (gl[i].x0 > p->x1 + (p->x1 - p->x0) / 3) {
                out[k++] = ' ';
            }
        }
        if (gl[i].ch >= 32 && gl[i].ch < 256) {
            out[k++] = (char) gl[i].ch;
        }
    }
    out[k] = 0;
    *lenp = k;
    return out;
}

static _kernel_oserror *
cmd_pdftext(const char *tail)
{
    char name[256], pagestr[16], out[256];
    int handle = 0, page;
    _kernel_oserror *e;
    DocSlot *ds;
    PdfGlyph *gl = NULL;
    u32 n = 0, len = 0;
    char *text;

    tail = get_token(tail, name, sizeof name);
    tail = get_token(tail, pagestr, sizeof pagestr);
    get_token(tail, out, sizeof out);
    page = atoi(pagestr);
    if (page < 1) {
        return err_Syntax;
    }
    e = open_doc(name, &handle);
    if (e != NULL) {
        return e;
    }
    ds = get_doc(handle);
    if (ds->kind != FT_PDF || (u32) page > ds->doc->npages) {
        close_doc(ds);
        return err_BadPage;
    }
    if (pdf_extracttext(ds->doc, (u32) page - 1, FX_ONE, &gl, &n)
        != PDF_OK) {
        close_doc(ds);
        return err_NoMem;
    }
    text = glyphs_to_text(gl, n, &len);
    free(gl);
    close_doc(ds);
    if (text == NULL) {
        return err_NoMem;
    }
    if (out[0] != 0) {
        e = _swix(XOS_File, _INR(0, 5), 10, out, 0xFFF, 0,
                  text, text + len);
        if (e == NULL) {
            char line[320];
            sprintf(line, "Wrote %u characters (%u glyphs) to %s",
                    len, n, out);
            wr0(line);
        }
    } else {
        char line[80];
        sprintf(line, "%u glyphs, %u characters:", n, len);
        wr0(line);
        wr0(text);
        e = NULL;
    }
    free(text);
    return e;
}

static _kernel_oserror *
cmd_pdftosprite(const char *tail)
{
    char name[256], pagestr[16], out[256], widthstr[16];
    int handle = 0, page, width;
    _kernel_oserror *e;
    DocSlot *ds;
    fix pw, ph;
    int rot, height;
    u8 *area = NULL;
    u32 areasize;

    tail = get_token(tail, name, sizeof name);
    tail = get_token(tail, pagestr, sizeof pagestr);
    tail = get_token(tail, out, sizeof out);
    get_token(tail, widthstr, sizeof widthstr);
    page = atoi(pagestr);
    width = widthstr[0] ? atoi(widthstr) : 1000;
    if (page < 1 || width < 16 || width > 4096) {
        return err_Syntax;
    }

    e = open_doc(name, &handle);
    if (e != NULL) {
        return e;
    }
    ds = get_doc(handle);
    if (ds->kind != FT_PDF) {
        pw = FX_FROMINT(ds->w);
        ph = FX_FROMINT(ds->h);
        rot = 0;
    } else if ((u32) page > ds->doc->npages ||
               pdf_pagegeom(ds->doc, (u32) page - 1, &pw, &ph,
                            &rot) != PDF_OK) {
        close_doc(ds);
        return err_BadPage;
    }
    if (rot == 90 || rot == 270) {
        fix t = pw;
        pw = ph;
        ph = t;
    }
    height = (int) (((s64) width * ph) / pw);
    if (height < 1) {
        height = 1;
    }
    if (height > 4096) {
        height = 4096;
        width = (int) (((s64) height * pw) / ph);
    }

    areasize = 16 + 44 + (u32) width * (u32) height * 4 + 64;
    area = malloc(areasize);
    if (area == NULL) {
        close_doc(ds);
        return err_NoMem;
    }
    ((u32 *) area)[0] = areasize;
    ((u32 *) area)[1] = 0;
    ((u32 *) area)[2] = 16;
    ((u32 *) area)[3] = 16;
    e = _swix(XOS_SpriteOp, _INR(0, 6),
              15 + 256, area, "page", 0, width, height,
              SPRITE_MODE_32BPP_180);
    if (e == NULL) {
        e = render_into_sprite(ds, (u32) page - 1, area, area + 16, 1);
    }
    if (e == NULL) {
        e = _swix(XOS_SpriteOp, _INR(0, 2), 12 + 256, area, out);
    }
    if (e == NULL) {
        /* stamp it as a sprite file                                  */
        e = _swix(XOS_File, _INR(0, 2), 18, out, 0xFF9);
    }
    free(area);
    close_doc(ds);
    if (e == NULL) {
        char line[192];
        sprintf(line, "Rendered page %d to %s (%d x %d)",
                page, out, width, height);
        wr0(line);
    }
    return e;
}

_kernel_oserror *
cmd_handler(const char *arg_string, int argc, int cmd_no, void *pw)
{
    (void) argc;
    (void) pw;
    switch (cmd_no) {
    case CMD_PDFInfo:
        return cmd_pdfinfo(arg_string);
    case CMD_PDFToSprite:
        return cmd_pdftosprite(arg_string);
    case CMD_PDFText:
        return cmd_pdftext(arg_string);
    case CMD_PDFClaim:
        claim_filetypes();
        return NULL;
    case CMD_PDFRenderVOpen:
        /* run the viewer application on the file (replaces the
           current application, as *Run always does)                  */
        {
            char viewer[200], cmd[512], tail[256];
            int vlen = 0, n = 0;
            const char *p = arg_string;
            _kernel_oserror *e =
                _swix(XOS_ReadVarVal, _INR(0, 4) | _OUT(2),
                      VIEWER_VAR, viewer, (int) sizeof viewer - 1,
                      0, 0, &vlen);
            if (e != NULL || vlen <= 0) {
                return err_Syntax;      /* no viewer registered */
            }
            viewer[vlen] = 0;
            while ((unsigned char) *p >= ' ' && n < 255) {
                tail[n++] = *p++;      /* CR-terminated CLI tail  */
            }
            tail[n] = 0;
            sprintf(cmd, "Run %s %s", viewer, tail);
            return _swix(XOS_CLI, _IN(0), cmd);
        }
    default:
        return NULL;
    }
}
