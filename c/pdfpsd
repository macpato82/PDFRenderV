*/

#include <stdlib.h>
#include <string.h>

#include "pdftypes.h"
#include "pdfpsd.h"

#define MODE_BITMAP     0
#define MODE_GRAY       1
#define MODE_INDEXED    2
#define MODE_RGB        3
#define MODE_CMYK       4

static u32
rd16(const u8 *p)
{
    return ((u32) p[0] << 8) | p[1];
}

static u32
rd32(const u8 *p)
{
    return ((u32) p[0] << 24) | ((u32) p[1] << 16) |
           ((u32) p[2] << 8) | p[3];
}

typedef struct {
    u32 channels, height, width, depth, mode;
    u32 cmodeoff, cmodelen;     /* the palette, for indexed files     */
    u32 dataoff;                /* the composite                      */
} Psd;

static int
psd_header(const u8 *src, u32 len, Psd *p)
{
    u32 off;

    if (len < 26 || memcmp(src, "8BPS", 4) != 0 || rd16(src + 4) != 1) {
        return PDF_E_DATA;
    }
    p->channels = rd16(src + 12);
    p->height = rd32(src + 14);
    p->width = rd32(src + 18);
    p->depth = rd16(src + 22);
    p->mode = rd16(src + 24);
    if (p->width == 0 || p->height == 0 || p->channels == 0) {
        return PDF_E_DATA;
    }
    if (p->depth != 8 && p->depth != 16) {
        return PDF_E_UNSUP;             /* 1 and 32 bit are rare      */
    }

    /* colour mode data, then image resources, then layers - each a
       length followed by that many bytes                            */
    off = 26;
    if (off + 4 > len) {
        return PDF_E_DATA;
    }
    p->cmodelen = rd32(src + off);
    p->cmodeoff = off + 4;
    off = p->cmodeoff + p->cmodelen;

    if (off + 4 > len) {
        return PDF_E_DATA;
    }
    off += 4 + rd32(src + off);         /* image resources            */
    if (off + 4 > len) {
        return PDF_E_DATA;
    }
    off += 4 + rd32(src + off);         /* layer and mask information */
    if (off + 2 > len) {
        return PDF_E_DATA;
    }
    p->dataoff = off;
    return PDF_OK;
}

int
pdfpsd_size(const u8 *src, u32 len, int *w, int *h)
{
    Psd p;
    int err;

    *w = *h = 0;
    err = psd_header(src, len, &p);
    if (err != PDF_OK) {
        return err;
    }
    *w = (int) p.width;
    *h = (int) p.height;
    return PDF_OK;
}

/* PackBits, one channel's worth: the row lengths come first, all of
   them, then the rows themselves.                                   */
static int
unpack_rle(const u8 *src, u32 len, u32 off, const u16 *rowlens,
           u32 nrows, u32 rowbytes, u8 *out)
{
    u32 r;

    for (r = 0; r < nrows; r++) {
        u32 n = rowlens[r];
        u32 i = 0;
        u32 w = 0;
        u8 *dst = out + r * rowbytes;

        if (off + n > len) {
            return PDF_E_DATA;
        }
        while (i < n && w < rowbytes) {
            s8 c = (s8) src[off + i++];

            if (c >= 0) {
                u32 count = (u32) c + 1;

                while (count-- && i < n && w < rowbytes) {
                    dst[w++] = src[off + i++];
                }
            } else if (c != -128) {
                u32 count = (u32) (-c) + 1;
                u8 v;

                if (i >= n) {
                    break;
                }
                v = src[off + i++];
                while (count-- && w < rowbytes) {
                    dst[w++] = v;
                }
            }
        }
        off += n;
    }
    return PDF_OK;
}

int
pdfpsd_decode(const u8 *src, u32 len, int *wp, int *hp, u32 **pixp)
{
    Psd p;
    u32 *pix = NULL;
    u8 *planes = NULL;
    u32 comp, rowbytes, planebytes, nch, c, x, y;
    int err;

    *wp = *hp = 0;
    *pixp = NULL;
    err = psd_header(src, len, &p);
    if (err != PDF_OK) {
        return err;
    }
    if ((u32) p.width * p.height > 16000000u) {
        return PDF_E_LIMIT;
    }
    comp = rd16(src + p.dataoff);
    if (comp != 0 && comp != 1) {
        return PDF_E_UNSUP;             /* zip variants are rare      */
    }

    /* only the colour channels are needed; any extra are alpha or
       spot channels, which the composite has already applied       */
    nch = p.channels;
    if (p.mode == MODE_RGB && nch > 3) { nch = 3; }
    if (p.mode == MODE_CMYK && nch > 4) { nch = 4; }
    if ((p.mode == MODE_GRAY || p.mode == MODE_INDEXED) && nch > 1) {
        nch = 1;
    }

    rowbytes = p.width * (p.depth / 8);
    planebytes = rowbytes * p.height;
    planes = calloc(nch, planebytes);
    if (planes == NULL) {
        return PDF_E_NOMEM;
    }

    if (comp == 0) {
        u32 off = p.dataoff + 2;

        for (c = 0; c < nch; c++) {
            if (off + planebytes > len) {
                break;
            }
            memcpy(planes + c * planebytes, src + off, planebytes);
            off += planebytes;
        }
    } else {
        /* every row length in the file, for every channel, first    */
        u32 nrows = p.height * p.channels;
        u32 tbl = p.dataoff + 2;
        u16 *rowlens;
        u32 off, i;

        if (tbl + nrows * 2 > len) {
            free(planes);
            return PDF_E_DATA;
        }
        rowlens = malloc(nrows * sizeof *rowlens);
        if (rowlens == NULL) {
            free(planes);
            return PDF_E_NOMEM;
        }
        for (i = 0; i < nrows; i++) {
            rowlens[i] = (u16) rd16(src + tbl + i * 2);
        }
        off = tbl + nrows * 2;
        for (c = 0; c < p.channels; c++) {
            u32 used = 0;

            for (i = 0; i < p.height; i++) {
                used += rowlens[c * p.height + i];
            }
            if (c < nch) {
                if (unpack_rle(src, len, off, rowlens + c * p.height,
                               p.height, rowbytes,
                               planes + c * planebytes) != PDF_OK) {
                    break;
                }
            }
            off += used;
        }
        free(rowlens);
    }

    pix = malloc((u32) p.width * p.height * sizeof *pix);
    if (pix == NULL) {
        free(planes);
        return PDF_E_NOMEM;
    }

    for (y = 0; y < p.height; y++) {
        for (x = 0; x < p.width; x++) {
            u32 i = y * p.width + x;
            u32 step = p.depth / 8;
            u32 o = y * rowbytes + x * step;
            u32 v[4];
            u32 r, g, b;

            for (c = 0; c < nch && c < 4; c++) {
                const u8 *pl = planes + c * planebytes + o;

                v[c] = p.depth == 16 ? (((u32) pl[0] << 8) | pl[1]) >> 8
                                     : pl[0];
            }
            switch (p.mode) {
            case MODE_RGB:
                r = v[0]; g = nch > 1 ? v[1] : v[0];
                b = nch > 2 ? v[2] : v[0];
                break;
            case MODE_CMYK:
                {
                    /* Photoshop stores CMYK inverted                */
                    u32 cy = 255 - v[0], m = 255 - v[1];
                    u32 ye = 255 - v[2], k = nch > 3 ? 255 - v[3] : 0;

                    r = 255 - (cy + k > 255 ? 255 : cy + k);
                    g = 255 - (m + k > 255 ? 255 : m + k);
                    b = 255 - (ye + k > 255 ? 255 : ye + k);
                }
                break;
            case MODE_INDEXED:
                {
                    u32 idx = v[0];
                    u32 n = p.cmodelen / 3;

                    if (n == 0 || idx >= n ||
                        p.cmodeoff + p.cmodelen > len) {
                        r = g = b = v[0];
                    } else {
                        r = src[p.cmodeoff + idx];
                        g = src[p.cmodeoff + n + idx];
                        b = src[p.cmodeoff + 2 * n + idx];
                    }
                }
                break;
            default:
                r = g = b = v[0];
                break;
            }
            pix[i] = r | (g << 8) | (b << 16);
        }
    }
    free(planes);
    *wp = (int) p.width;
    *hp = (int) p.height;
    *pixp = pix;
    return PDF_OK;
}
