/* The FontManager only anti-aliases up to the configured FontMax2
   (and caches up to FontMax3), so large zooms and headings go jagged
   on typical setups.  Raise both for the duration of a render and
   restore afterwards - Font_SetFontMax alters only the live values,
   not the CMOS configuration.                                        */
static void
fontmax_raise(RoRender *rr)
{
    if (_swix(XFont_ReadFontMax, _OUTR(0, 5),
              &rr->fmax[0], &rr->fmax[1], &rr->fmax[2],
              &rr->fmax[3], &rr->fmax[4], &rr->fmax[5]) != NULL) {
        return;
    }
    rr->fmax_saved = 1;
    {
        int m2 = rr->fmax[2] < 64 ? 64 : rr->fmax[2];
        int m3 = rr->fmax[3] < 64 ? 64 : rr->fmax[3];
        _swix(XFont_SetFontMax, _INR(0, 7),
              rr->fmax[0], rr->fmax[1], m2, m3,
              rr->fmax[4], rr->fmax[5], 0, 0);
    }
}

static void
fontmax_restore(RoRender *rr)
{
    if (rr->fmax_saved) {
        _swix(XFont_SetFontMax, _INR(0, 7),
              rr->fmax[0], rr->fmax[1], rr->fmax[2], rr->fmax[3],
              rr->fmax[4], rr->fmax[5], 0, 0);
        rr->fmax_saved = 0;
    }
}

static void
setup_vtable(RoRender *rr)
{
    rr->be.ctx = rr;
    rr->be.gsave = be_gsave;
    rr->be.grestore = be_grestore;
    rr->be.clip = be_clip;
    rr->be.fill = be_fill;
    rr->be.stroke = be_stroke;
    rr->be.text = be_text;
    rr->be.textwidth = be_textwidth;
    rr->be.image = be_image;
}

int
rorender_begin_direct(RoRender *rr, int devw, int devh)
{
    memset(rr, 0, sizeof *rr);
    rr->devw = devw;
    rr->devh = devh;
    rr->clip[0].x0 = 0;
    rr->clip[0].y0 = 0;
    rr->clip[0].x1 = devw - 1;
    rr->clip[0].y1 = devh - 1;
    fontmax_raise(rr);
    setup_vtable(rr);
    return PDF_OK;
}

int
rorender_begin(RoRender *rr, void *area, void *sprite, int whitebg)
{
    u32 savesize = 0;

    memset(rr, 0, sizeof *rr);
    rr->area = area;
    rr->sprite = sprite;

    /* sprite geometry: width from words-1 (32bpp: 1 word = 1 px)     */
    {
        const u32 *sp = sprite;
        rr->devw = (int) sp[4] + 1;
        rr->devh = (int) sp[5] + 1;
    }
    if (_swix(XOS_SpriteOp, _INR(0, 2) | _OUT(3),
              62 + 512, area, sprite, &savesize) != NULL) {
        return PDF_E_UNSUP;
    }
    rr->savearea = malloc(savesize + 4);
    if (rr->savearea == NULL) {
        return PDF_E_NOMEM;
    }
    *(u32 *) rr->savearea = 0;
    if (_swix(XOS_SpriteOp, _INR(0, 3) | _OUT(1) | _OUT(2) | _OUT(3),
              60 + 512, area, sprite, rr->savearea,
              &rr->old[1], &rr->old[2], &rr->old[3]) != NULL) {
        free(rr->savearea);
        rr->savearea = NULL;
        return PDF_E_UNSUP;
    }
    rr->redirected = 1;

    rr->clip[0].x0 = 0;
    rr->clip[0].y0 = 0;
    rr->clip[0].x1 = rr->devw - 1;
    rr->clip[0].y1 = rr->devh - 1;
    clip_apply(rr);

    if (whitebg) {
        u8 cls = 16;                    /* VDU 16: clear graphics win */
        setgcol(0xFFFFFFu, 1);
        vdu_bytes(&cls, 1);
    }

    fontmax_raise(rr);
    setup_vtable(rr);
    return PDF_OK;
}

void
rorender_end(RoRender *rr)
{
    int i;

    for (i = 0; i < RO_NFONTS; i++) {
        if (rr->fonts[i].handle) {
            _swix(XFont_LoseFont, _IN(0), rr->fonts[i].handle);
            rr->fonts[i].handle = 0;
        }
    }
    fontmax_restore(rr);
    if (rr->redirected) {
        _swix(XOS_SpriteOp, _INR(0, 3),
              60 + 512, rr->old[1], rr->old[2], rr->old[3]);
        rr->redirected = 0;
    }
    free(rr->savearea);
    rr->savearea = NULL;
    free(rr->dpath);
    rr->dpath = NULL;
}
