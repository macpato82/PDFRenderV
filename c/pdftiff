*/

#include <stdlib.h>
#include <string.h>

#include "pdftypes.h"
#include "pdfflt.h"
#include "pdftiff.h"

/* tags we act on */
#define T_WIDTH         256
#define T_HEIGHT        257
#define T_BPS           258
#define T_COMPRESSION   259
#define T_PHOTOMETRIC   262
#define T_STRIPOFFSETS  273
#define T_SAMPLESPP     277
#define T_ROWSPERSTRIP  278
#define T_STRIPCOUNTS   279
#define T_PLANARCONFIG  284
#define T_PREDICTOR     317
#define T_COLORMAP      320
#define T_TILEWIDTH     322
#define T_TILELENGTH    323
#define T_TILEOFFSETS   324
#define T_TILECOUNTS    325
#define T_EXTRASAMPLES  338

#define C_NONE          1
#define C_LZW           5
#define C_DEFLATE_ADOBE 8
#define C_PACKBITS      32773
#define C_DEFLATE       32946

#define P_WHITEZERO     0
#define P_BLACKZERO     1
#define P_RGB           2
#define P_PALETTE       3

typedef struct {
    const u8 *buf;
    u32 len;
    int big;                    /* byte order                         */
} Tiff;

static u32
rd16(const Tiff *t, u32 off)
{
    if (off + 2 > t->len) {
        return 0;
    }
    return t->big ? ((u32) t->buf[off] << 8) | t->buf[off + 1]
                  : ((u32) t->buf[off + 1] << 8) | t->buf[off];
}

static u32
rd32(const Tiff *t, u32 off)
{
    if (off + 4 > t->len) {
        return 0;
    }
    return t->big
        ? ((u32) t->buf[off] << 24) | ((u32) t->buf[off + 1] << 16) |
          ((u32) t->buf[off + 2] << 8) | t->buf[off + 3]
        : ((u32) t->buf[off + 3] << 24) | ((u32) t->buf[off + 2] << 16) |
          ((u32) t->buf[off + 1] << 8) | t->buf[off];
}

/* One value out of a field, whatever its type.                      */
static u32
field_value(const Tiff *t, u32 type, u32 off, u32 i)
{
    switch (type) {
    case 1: case 6: case 7:             /* BYTE, SBYTE, UNDEFINED     */
        return off + i < t->len ? t->buf[off + i] : 0;
    case 3: case 8:                     /* SHORT, SSHORT              */
        return rd16(t, off + i * 2);
    default:                            /* LONG, SLONG, RATIONAL...   */
        return rd32(t, off + i * 4);
    }
}

static u32
type_size(u32 type)
{
    switch (type) {
    case 1: case 2: case 6: case 7: return 1;
    case 3: case 8:                 return 2;
    case 5: case 10:                return 8;
    default:                        return 4;
    }
}

/* Where a field's values live: inline in the entry when they fit in
   four bytes, otherwise at the offset it holds.                    */
static u32
field_data(const Tiff *t, u32 entry, u32 type, u32 count)
{
    return type_size(type) * count <= 4 ? entry + 8 : rd32(t, entry + 8);
}

typedef struct {
    u32 width, height;
    u32 bps[4], spp;
    u32 compression, photometric, planar, predictor;
    u32 rowsperstrip;
    u32 stripoff, stripoff_type, stripoff_count;
    u32 stripcnt, stripcnt_type, stripcnt_count;
    u32 tilew, tileh;
    u32 tileoff, tileoff_type, tileoff_count;
    u32 tilecnt, tilecnt_type, tilecnt_count;
    u32 cmap, cmap_count;
    u32 extrasamples;
} TiffDir;

static int
read_dir(const Tiff *t, TiffDir *d)
{
    u32 ifd, n, i;

    memset(d, 0, sizeof *d);
    d->spp = 1;
    d->bps[0] = 1;
    d->compression = C_NONE;
    d->photometric = P_BLACKZERO;
    d->planar = 1;
    d->predictor = 1;
    d->rowsperstrip = 0xFFFFFFFFu;

    ifd = rd32(t, 4);
    if (ifd == 0 || ifd + 2 > t->len) {
        return PDF_E_DATA;
    }
    n = rd16(t, ifd);
    if (n == 0 || n > 512) {
        return PDF_E_DATA;
    }
    for (i = 0; i < n; i++) {
        u32 e = ifd + 2 + i * 12;
        u32 tag, type, count, data;

        if (e + 12 > t->len) {
            break;
        }
        tag = rd16(t, e);
        type = rd16(t, e + 2);
        count = rd32(t, e + 4);
        data = field_data(t, e, type, count);

        switch (tag) {
        case T_WIDTH:       d->width = field_value(t, type, data, 0); break;
        case T_HEIGHT:      d->height = field_value(t, type, data, 0); break;
        case T_COMPRESSION: d->compression = field_value(t, type, data, 0); break;
        case T_PHOTOMETRIC: d->photometric = field_value(t, type, data, 0); break;
        case T_SAMPLESPP:   d->spp = field_value(t, type, data, 0); break;
        case T_ROWSPERSTRIP:d->rowsperstrip = field_value(t, type, data, 0); break;
        case T_PLANARCONFIG:d->planar = field_value(t, type, data, 0); break;
        case T_PREDICTOR:   d->predictor = field_value(t, type, data, 0); break;
        case T_TILEWIDTH:   d->tilew = field_value(t, type, data, 0); break;
        case T_TILELENGTH:  d->tileh = field_value(t, type, data, 0); break;
        case T_EXTRASAMPLES:d->extrasamples = count; break;
        case T_BPS:
            {
                u32 k;

                for (k = 0; k < count && k < 4; k++) {
                    d->bps[k] = field_value(t, type, data, k);
                }
            }
            break;
        case T_STRIPOFFSETS:
            d->stripoff = data; d->stripoff_type = type;
            d->stripoff_count = count;
            break;
        case T_STRIPCOUNTS:
            d->stripcnt = data; d->stripcnt_type = type;
            d->stripcnt_count = count;
            break;
        case T_TILEOFFSETS:
            d->tileoff = data; d->tileoff_type = type;
            d->tileoff_count = count;
            break;
        case T_TILECOUNTS:
            d->tilecnt = data; d->tilecnt_type = type;
            d->tilecnt_count = count;
            break;
        case T_COLORMAP:
            d->cmap = data; d->cmap_count = count;
            break;
        default:
            break;
        }
    }
    if (d->width == 0 || d->height == 0) {
        return PDF_E_DATA;
    }
    return PDF_OK;
}

int
pdftiff_size(const u8 *src, u32 len, int *w, int *h)
{
    Tiff t;
    TiffDir d;
    int err;

    *w = *h = 0;
    if (len < 8) {
        return PDF_E_DATA;
    }
    if (src[0] == 'I' && src[1] == 'I') {
        t.big = 0;
    } else if (src[0] == 'M' && src[1] == 'M') {
        t.big = 1;
    } else {
        return PDF_E_DATA;
    }
    t.buf = src;
    t.len = len;
    if (rd16(&t, 2) != 42) {
        return PDF_E_DATA;
    }
    err = read_dir(&t, &d);
    if (err != PDF_OK) {
        return err;
    }
    *w = (int) d.width;
    *h = (int) d.height;
    return PDF_OK;
}

/* Undo whichever compression the strip or tile used.                */
static int
decompress(const Tiff *t, const TiffDir *d, u32 off, u32 nbytes,
           PdfBuf *out)
{
    if (off >= t->len) {
        return PDF_E_DATA;
    }
    if (nbytes > t->len - off) {
        nbytes = t->len - off;
    }
    out->len = 0;
    switch (d->compression) {
    case C_NONE:
        if (pdfbuf_need(out, nbytes) != PDF_OK) {
            return PDF_E_NOMEM;
        }
        memcpy(out->p, t->buf + off, nbytes);
        out->len = nbytes;
        return PDF_OK;
    case C_LZW:
        /* TIFF LZW is PDF LZW with the early-change behaviour on    */
        return pdf_lzw(t->buf + off, nbytes, 1, out);
    case C_DEFLATE:
    case C_DEFLATE_ADOBE:
        return pdf_inflate(t->buf + off, nbytes, out);
    case C_PACKBITS:
        /* PackBits is PDF's RunLength, byte for byte                */
        return pdf_rle(t->buf + off, nbytes, out);
    default:
        return PDF_E_UNSUP;
    }
}

/* One sample out of a packed row.                                   */
static u32
sample_at(const u8 *row, u32 rowbytes, u32 bits, u32 idx)
{
    u32 bitpos = idx * bits;
    u32 byte = bitpos >> 3;

    if (byte >= rowbytes) {
        return 0;
    }
    switch (bits) {
    case 1:  return (row[byte] >> (7 - (bitpos & 7))) & 1;
    case 2:  return (row[byte] >> (6 - (bitpos & 7))) & 3;
    case 4:  return (bitpos & 7) ? (row[byte] & 15) : (row[byte] >> 4);
    case 8:  return row[byte];
    case 16: return byte + 1 < rowbytes
                    ? ((u32) row[byte] << 8) | row[byte + 1] : 0;
    default: return 0;
    }
}

/* Turn one decoded row of samples into XRGB32 pixels.               */
static void
row_to_pixels(const TiffDir *d, const Tiff *t, const u8 *row,
              u32 rowbytes, u32 *out, u32 width)
{
    u32 bits = d->bps[0];
    u32 maxv = bits >= 16 ? 65535u : (1u << bits) - 1u;
    u32 x;

    for (x = 0; x < width; x++) {
        u32 r, g, b;

        if (d->photometric == P_RGB && d->spp >= 3) {
            u32 base = x * d->spp;

            r = sample_at(row, rowbytes, bits, base);
            g = sample_at(row, rowbytes, bits, base + 1);
            b = sample_at(row, rowbytes, bits, base + 2);
            if (bits == 16) {
                r >>= 8; g >>= 8; b >>= 8;
            } else if (bits != 8) {
                r = r * 255 / maxv; g = g * 255 / maxv; b = b * 255 / maxv;
            }
        } else if (d->photometric == P_PALETTE && d->cmap != 0) {
            u32 idx = sample_at(row, rowbytes, bits, x);
            u32 n = d->cmap_count / 3;

            if (n == 0 || idx >= n) {
                r = g = b = 0;
            } else {
                /* the map is three runs of 16-bit values             */
                r = rd16(t, d->cmap + idx * 2) >> 8;
                g = rd16(t, d->cmap + (n + idx) * 2) >> 8;
                b = rd16(t, d->cmap + (2 * n + idx) * 2) >> 8;
            }
        } else {
            u32 v = sample_at(row, rowbytes, bits, x * d->spp);

            if (bits == 16) {
                v >>= 8;
            } else if (bits != 8) {
                v = v * 255 / maxv;
            }
            if (d->photometric == P_WHITEZERO) {
                v = 255 - v;
            }
            r = g = b = v;
        }
        out[x] = r | (g << 8) | (b << 16);
    }
}

int
pdftiff_decode(const u8 *src, u32 len, int *wp, int *hp, u32 **pixp)
{
    Tiff t;
    TiffDir d;
    PdfBuf buf;
    u32 *pix = NULL;
    u32 rowbytes, y;
    int err;

    *wp = *hp = 0;
    *pixp = NULL;
    err = pdftiff_size(src, len, wp, hp);
    if (err != PDF_OK) {
        return err;
    }
    t.buf = src;
    t.len = len;
    t.big = (src[0] == 'M');
    err = read_dir(&t, &d);
    if (err != PDF_OK) {
        return err;
    }
    if (d.planar != 1) {
        return PDF_E_UNSUP;             /* separate planes: rare      */
    }
    if (d.bps[0] != 1 && d.bps[0] != 2 && d.bps[0] != 4 &&
        d.bps[0] != 8 && d.bps[0] != 16) {
        return PDF_E_UNSUP;
    }
    if ((u32) *wp * (u32) *hp > 16000000u) {
        return PDF_E_LIMIT;
    }
    pix = malloc((u32) *wp * (u32) *hp * sizeof *pix);
    if (pix == NULL) {
        return PDF_E_NOMEM;
    }
    memset(pix, 0xFF, (u32) *wp * (u32) *hp * sizeof *pix);
    memset(&buf, 0, sizeof buf);

    rowbytes = ((u32) *wp * d.spp * d.bps[0] + 7) / 8;

    if (d.tilew != 0 && d.tileh != 0 && d.tileoff_count != 0) {
        /* tiled: walk the grid, decoding each tile into place       */
        u32 across = (d.width + d.tilew - 1) / d.tilew;
        u32 down = (d.height + d.tileh - 1) / d.tileh;
        u32 tilerow = (d.tilew * d.spp * d.bps[0] + 7) / 8;
        u32 ti;

        for (ti = 0; ti < across * down && ti < d.tileoff_count; ti++) {
            u32 off = field_value(&t, d.tileoff_type, d.tileoff, ti);
            u32 cnt = d.tilecnt_count > ti
                    ? field_value(&t, d.tilecnt_type, d.tilecnt, ti)
                    : 0;
            u32 tx = (ti % across) * d.tilew;
            u32 ty = (ti / across) * d.tileh;
            u32 r;

            if (decompress(&t, &d, off, cnt, &buf) != PDF_OK) {
                continue;
            }
            if (d.predictor == 2) {
                u32 l = buf.len;

                pdf_predict(buf.p, &l, 2, (int) d.spp, (int) d.bps[0],
                            (int) d.tilew);
            }
            for (r = 0; r < d.tileh && ty + r < d.height; r++) {
                u32 rowoff = r * tilerow;
                u32 wide = d.tilew;

                if (rowoff + tilerow > buf.len) {
                    break;
                }
                if (tx + wide > d.width) {
                    wide = d.width - tx;
                }
                row_to_pixels(&d, &t, buf.p + rowoff, tilerow,
                              pix + (ty + r) * d.width + tx, wide);
            }
        }
    } else {
        /* stripped, which is the common case                        */
        u32 rps = d.rowsperstrip;
        u32 nstrips, s;

        if (rps == 0 || rps > d.height) {
            rps = d.height;
        }
        nstrips = (d.height + rps - 1) / rps;
        if (d.stripoff_count < nstrips) {
            nstrips = d.stripoff_count;
        }
        for (s = 0; s < nstrips; s++) {
            u32 off = field_value(&t, d.stripoff_type, d.stripoff, s);
            u32 cnt = d.stripcnt_count > s
                    ? field_value(&t, d.stripcnt_type, d.stripcnt, s)
                    : rowbytes * rps;
            u32 r;

            if (decompress(&t, &d, off, cnt, &buf) != PDF_OK) {
                continue;
            }
            if (d.predictor == 2) {
                u32 l = buf.len;

                pdf_predict(buf.p, &l, 2, (int) d.spp, (int) d.bps[0],
                            (int) d.width);
            }
            for (r = 0; r < rps; r++) {
                y = s * rps + r;
                if (y >= d.height || (r + 1) * rowbytes > buf.len) {
                    break;
                }
                row_to_pixels(&d, &t, buf.p + r * rowbytes, rowbytes,
                              pix + y * d.width, d.width);
            }
        }
    }
    pdfbuf_free(&buf);
    *pixp = pix;
    return PDF_OK;
}
