/*
  PDFRender - image XObject / inline image decoding.

  pdfimg_load (image XObjects) and pdfimg_inline (BI/ID/EI inline
  images) both reduce their dict - full key names for XObjects,
  either spelling for inline images - down to plain values (w, h,
  bpc, colourspace, mask flag/fill) plus a fully filter-decoded byte
  buffer, then hand that to expand_pixels(), the one shared pixel-
  expansion core.  A DCTDecode-terminated stream is passed through
  untouched for SpriteExtend's JPEG plotter; a JPXDecode-terminated
  one goes to c/pdfjpx (OpenJPEG) and comes back as pixels; a
  JBIG2Decode-terminated one goes to c/pdfjbig2 and comes back as the
  1-bit samples it codes, which the expansion core can take as they
  stand.  CCITTFax is refused.

  Copyright (c) RISC OS Technologies 2026.
  SPDX-License-Identifier: CDDL-1.0
  Licensed under the Common Development and Distribution License 1.0; see LICENSE.
*/

#include <stdlib.h>
#include <string.h>

#include "pdftypes.h"
#include "pdfobj.h"
#include "pdfflt.h"
#include "pdffile.h"
#include "pdfimg.h"
#include "pdfjpx.h"
#include "pdfjbig2.h"

enum { CS_GRAY = 0, CS_RGB, CS_CMYK, CS_INDEXED, CS_UNKNOWN };

/* --- decoded-image cache -------------------------------------------- */

#define IMGCACHE_SLOTS 6

typedef struct {
    PdfDoc *doc;                /* NULL = empty slot                  */
    u32 objnum;                 /* the image XObject                  */
    int maxw, maxh;             /* what it was decoded for            */
    int w, h;
    u32 *pix;
    u32 bytes;
    u32 tick;
} ImgCache;

static ImgCache img_cache[IMGCACHE_SLOTS];
static u32 img_tick;
static u32 img_bytes;
static u32 img_limit = 4u * 1024u * 1024u;      /* 4MB by default    */
static u32 img_hits, img_misses;

void
pdfimg_cache_stats(u32 *hits, u32 *misses)
{
    if (hits) {
        *hits = img_hits;
    }
    if (misses) {
        *misses = img_misses;
    }
}

void
pdfimg_cache_limit(u32 bytes)
{
    img_limit = bytes;
}

static void
cache_drop(int i)
{
    free(img_cache[i].pix);
    img_bytes -= img_cache[i].bytes;
    img_cache[i].pix = NULL;
    img_cache[i].doc = NULL;
    img_cache[i].bytes = 0;
}

void
pdfimg_cache_flush(PdfDoc *doc)
{
    int i;

    for (i = 0; i < IMGCACHE_SLOTS; i++) {
        if (img_cache[i].doc != NULL &&
            (doc == NULL || img_cache[i].doc == doc)) {
            cache_drop(i);
        }
    }
}

/* Look for a decoded copy good enough for this request: same object,
   and decoded for at least the size being asked for now.            */
static int
cache_find(PdfDoc *doc, u32 objnum, int maxw, int maxh)
{
    int i;

    if (objnum == 0) {
        return -1;
    }
    for (i = 0; i < IMGCACHE_SLOTS; i++) {
        if (img_cache[i].doc == doc && img_cache[i].objnum == objnum &&
            img_cache[i].pix != NULL &&
            img_cache[i].maxw == maxw && img_cache[i].maxh == maxh) {
            img_cache[i].tick = ++img_tick;
            img_hits++;
            return i;
        }
    }
    img_misses++;
    return -1;
}

static void
cache_put(PdfDoc *doc, u32 objnum, int maxw, int maxh,
          int w, int h, const u32 *pix)
{
    u32 bytes = (u32) w * (u32) h * 4;
    int i, slot = -1;
    u32 oldest = 0xffffffffu;

    if (objnum == 0 || bytes == 0 || bytes > img_limit) {
        return;                         /* never worth caching        */
    }
    while (img_bytes + bytes > img_limit) {
        int victim = -1;
        u32 old = 0xffffffffu;
        for (i = 0; i < IMGCACHE_SLOTS; i++) {
            if (img_cache[i].pix != NULL && img_cache[i].tick < old) {
                old = img_cache[i].tick;
                victim = i;
            }
        }
        if (victim < 0) {
            break;
        }
        cache_drop(victim);
    }
    for (i = 0; i < IMGCACHE_SLOTS; i++) {
        if (img_cache[i].pix == NULL) {
            slot = i;
            break;
        }
        if (img_cache[i].tick < oldest) {
            oldest = img_cache[i].tick;
            slot = i;
        }
    }
    if (slot < 0) {
        return;
    }
    if (img_cache[slot].pix != NULL) {
        cache_drop(slot);
    }
    img_cache[slot].pix = malloc(bytes);
    if (img_cache[slot].pix == NULL) {
        return;
    }
    memcpy(img_cache[slot].pix, pix, bytes);
    img_cache[slot].doc = doc;
    img_cache[slot].objnum = objnum;
    img_cache[slot].maxw = maxw;
    img_cache[slot].maxh = maxh;
    img_cache[slot].w = w;
    img_cache[slot].h = h;
    img_cache[slot].bytes = bytes;
    img_cache[slot].tick = ++img_tick;
    img_bytes += bytes;
}

/* --- small helpers ---------------------------------------------------- */

static int
num_nonzero(PdfObj *o)
{
    if (o == NULL) {
        return 0;
    }
    if (o->type == PDF_INT || o->type == PDF_BOOL) {
        return o->u.i != 0;
    }
    if (o->type == PDF_REAL) {
        return o->u.f != 0;
    }
    return 0;
}

/* Inline image dicts accept either spelling of every key. */
static PdfObj *
inline_get(PdfDoc *doc, PdfObj *dict, const char *full, const char *abbr)
{
    PdfObj *o = pdf_resolve(doc, pdf_dictget(dict, full));

    if (o == NULL) {
        o = pdf_resolve(doc, pdf_dictget(dict, abbr));
    }
    return o;
}

/* Extract sample idx (0-based, component-interleaved) from a tightly
   packed row: MSB-first bit order, first sample in the high bits.
   16-bit samples yield only the high byte, per the module's 8-bit
   pixel pipeline.                                                     */
static u32
img_sample(const u8 *row, u32 idx, int bpc)
{
    u32 bitpos, byteoff, bitoff, shift, mask;

    if (bpc == 8) {
        return row[idx];
    }
    if (bpc == 16) {
        return row[idx * 2];
    }
    bitpos = idx * (u32) bpc;
    byteoff = bitpos >> 3;
    bitoff = bitpos & 7u;
    shift = 8u - bitoff - (u32) bpc;
    mask = (1u << bpc) - 1u;
    return (row[byteoff] >> shift) & mask;
}

/* Scale a bpc-wide sample to 0..255 (identity for bpc 8, and for the
   16-bit high byte already extracted by img_sample).                  */
static u32
img_scale255(u32 v, int bpc)
{
    int eff = bpc == 16 ? 8 : bpc;
    u32 maxv = (1u << eff) - 1u;

    return maxv ? v * 255u / maxv : 0u;
}

/* --- colourspace classification ---------------------------------------- */

/* Classify a non-Indexed colourspace: DeviceGray/RGB/CMYK and their
   Cal-family/ICCBased/abbreviated-name equivalents.  A recognised-
   but-unsupported family (Lab, Separation, DeviceN, Pattern) is
   refused; an unrecognised bare name comes back as CS_UNKNOWN so the
   caller can guess RGB-vs-gray from how much data actually turned up. */
static int
plain_cs_kind(PdfDoc *doc, PdfObj *cs, int *kind, int *ncomp)
{
    const char *name;

    cs = pdf_resolve(doc, cs);
    if (cs == NULL) {
        return PDF_E_SYNTAX;
    }
    if (cs->type == PDF_NAME) {
        name = (const char *) cs->u.str.p;
        if (strcmp(name, "DeviceGray") == 0 || strcmp(name, "CalGray") == 0 ||
            strcmp(name, "G") == 0) {
            *kind = CS_GRAY;
            *ncomp = 1;
            return PDF_OK;
        }
        if (strcmp(name, "DeviceRGB") == 0 || strcmp(name, "CalRGB") == 0 ||
            strcmp(name, "RGB") == 0) {
            *kind = CS_RGB;
            *ncomp = 3;
            return PDF_OK;
        }
        if (strcmp(name, "DeviceCMYK") == 0 || strcmp(name, "CMYK") == 0) {
            *kind = CS_CMYK;
            *ncomp = 4;
            return PDF_OK;
        }
        *kind = CS_UNKNOWN;
        *ncomp = 0;
        return PDF_OK;
    }
    if (cs->type == PDF_ARRAY) {
        PdfObj *fam = pdf_resolve(doc, pdf_arrget(cs, 0));
        const char *fname;

        if (fam == NULL || fam->type != PDF_NAME) {
            return PDF_E_UNSUP;
        }
        fname = (const char *) fam->u.str.p;
        if (strcmp(fname, "ICCBased") == 0) {
            PdfObj *stm = pdf_resolve(doc, pdf_arrget(cs, 1));
            PdfObj *n = stm ? pdf_resolve(doc, pdf_dictget(stm, "N")) : NULL;
            s32 nv = n ? pdfobj_int_of(n) : 0;

            if (nv == 1) {
                *kind = CS_GRAY;
                *ncomp = 1;
                return PDF_OK;
            }
            if (nv == 3) {
                *kind = CS_RGB;
                *ncomp = 3;
                return PDF_OK;
            }
            if (nv == 4) {
                *kind = CS_CMYK;
                *ncomp = 4;
                return PDF_OK;
            }
            return PDF_E_UNSUP;
        }
        if (strcmp(fname, "CalGray") == 0) {
            *kind = CS_GRAY;
            *ncomp = 1;
            return PDF_OK;
        }
        if (strcmp(fname, "CalRGB") == 0) {
            *kind = CS_RGB;
            *ncomp = 3;
            return PDF_OK;
        }
    }
    return PDF_E_UNSUP;         /* Lab, Separation, DeviceN, Pattern, ... */
}

/* Classify a colourspace object, resolving /Indexed's base and lookup
   table.  lutbuf receives ownership of any stream-decoded lookup
   table; the caller frees it once done with *lut.                     */
static int
classify_cs(PdfDoc *doc, PdfObj *csobj, int *kind, int *ncomp,
            const u8 **lut, u32 *lutlen, s32 *hival, int *basencomp,
            PdfBuf *lutbuf)
{
    PdfObj *cs = pdf_resolve(doc, csobj);
    PdfObj *fam;

    *lut = NULL;
    *lutlen = 0;
    *hival = 0;
    *basencomp = 1;

    if (cs == NULL) {
        return PDF_E_SYNTAX;
    }
    fam = cs->type == PDF_ARRAY ? pdf_resolve(doc, pdf_arrget(cs, 0)) : NULL;
    if (fam && fam->type == PDF_NAME &&
        (strcmp((const char *) fam->u.str.p, "Indexed") == 0 ||
         strcmp((const char *) fam->u.str.p, "I") == 0)) {
        PdfObj *base = pdf_arrget(cs, 1);
        PdfObj *hv = pdf_resolve(doc, pdf_arrget(cs, 2));
        PdfObj *lookup = pdf_resolve(doc, pdf_arrget(cs, 3));
        int bkind, bncomp;
        int err = plain_cs_kind(doc, base, &bkind, &bncomp);

        if (err) {
            return err;
        }
        if (bkind == CS_UNKNOWN) {
            return PDF_E_UNSUP;
        }
        *basencomp = bncomp;
        *hival = hv ? pdfobj_int_of(hv) : 0;
        if (*hival < 0) {
            *hival = 0;
        }
        if (lookup && lookup->type == PDF_STRING) {
            *lut = lookup->u.str.p;
            *lutlen = lookup->u.str.len;
        } else if (lookup && lookup->type == PDF_STREAM) {
            int e2 = pdf_streamdata(doc, lookup, lutbuf, NULL);
            if (e2) {
                return e2;
            }
            *lut = lutbuf->p;
            *lutlen = lutbuf->len;
        }
        *kind = CS_INDEXED;
        *ncomp = 1;
        return PDF_OK;
    }
    return plain_cs_kind(doc, cs, kind, ncomp);
}

/* Combine already-extracted component samples into an 0x00BBGGRR
   word.  For CS_INDEXED, samp[0] is an unscaled table index (not a
   0..255 colour value) - see expand_pixels.                           */
static u32
combine_pixel(int kind, const u32 *samp, const u8 *lut, u32 lutlen,
              s32 hival, int basencomp)
{
    u32 r, g, b;

    if (kind == CS_GRAY) {
        r = g = b = samp[0];
    } else if (kind == CS_RGB) {
        r = samp[0];
        g = samp[1];
        b = samp[2];
    } else if (kind == CS_CMYK) {
        u32 rr = samp[0] + samp[3];
        u32 gg = samp[1] + samp[3];
        u32 bb = samp[2] + samp[3];

        r = 255u - (rr > 255u ? 255u : rr);
        g = 255u - (gg > 255u ? 255u : gg);
        b = 255u - (bb > 255u ? 255u : bb);
    } else if (kind == CS_INDEXED) {
        s32 idx = (s32) samp[0];
        u32 off;

        if (idx < 0) {
            idx = 0;
        }
        if (idx > hival) {
            idx = hival;
        }
        off = (u32) idx * (u32) basencomp;
        if (lut == NULL || basencomp <= 0 ||
            off + (u32) basencomp > lutlen) {
            r = g = b = 0;               /* missing/short table: black */
        } else if (basencomp == 1) {
            r = g = b = lut[off];
        } else if (basencomp == 3) {
            r = lut[off];
            g = lut[off + 1];
            b = lut[off + 2];
        } else if (basencomp == 4) {
            u32 c = lut[off], m = lut[off + 1];
            u32 yv = lut[off + 2], k = lut[off + 3];
            u32 rr = c + k, gg = m + k, bb = yv + k;

            r = 255u - (rr > 255u ? 255u : rr);
            g = 255u - (gg > 255u ? 255u : gg);
            b = 255u - (bb > 255u ? 255u : bb);
        } else {
            r = g = b = 0;
        }
    } else {
        r = g = b = 0;
    }
    return (b << 16) | (g << 8) | r;
}

/* --- shared pixel-expansion core ---------------------------------------- */

/* w, h, bpc, the colourspace object, the ImageMask/Decode-invert
   flags and fillrgb come from the caller's dict lookup (full names
   for XObjects, either spelling for inline images); data/datalen is
   the fully filter-decoded byte buffer.  Builds *outpix (malloc'd,
   w*h words, caller frees).                                           */
static int
expand_pixels(PdfDoc *doc, s32 w, s32 h, s32 bpc, int imagemask,
              int maskinvert, u32 fillrgb, PdfObj *csobj,
              const u8 *data, u32 datalen, u32 **outpix)
{
    u32 npix, stride, y;
    u32 *pix = NULL;
    int kind = CS_GRAY, ncomp = 1, basencomp = 1;
    const u8 *lut = NULL;
    u32 lutlen = 0;
    s32 hival = 0;
    PdfBuf lutbuf = { 0 };
    int err = PDF_OK;

    *outpix = NULL;
    if (w < 1 || w > 8192 || h < 1 || h > 8192) {
        return PDF_E_LIMIT;
    }
    npix = (u32) w * (u32) h;
    if (npix > 4194304u) {
        return PDF_E_LIMIT;
    }

    if (imagemask) {
        bpc = 1;
        ncomp = 1;
    } else {
        if (bpc != 1 && bpc != 2 && bpc != 4 && bpc != 8 && bpc != 16) {
            return PDF_E_UNSUP;
        }
        err = classify_cs(doc, csobj, &kind, &ncomp, &lut, &lutlen,
                          &hival, &basencomp, &lutbuf);
        if (err) {
            goto fail;
        }
        if (kind == CS_UNKNOWN) {
            /* Bare unrecognised colourspace name: guess RGB if the
               data is big enough to hold 3 components per pixel,
               otherwise fall back to gray.                            */
            u32 stride3 = ((u32) w * 3u * (u32) bpc + 7u) / 8u;
            u32 need3 = stride3 * (u32) h;

            if (need3 > 0 && datalen >= need3) {
                kind = CS_RGB;
                ncomp = 3;
            } else {
                kind = CS_GRAY;
                ncomp = 1;
            }
        }
    }

    /* w*h is capped at 4194304 above, so w*h*4 (the pix buffer size in
       bytes) cannot overflow u32.                                     */
    pix = malloc((size_t) npix * sizeof(u32));
    if (pix == NULL) {
        err = PDF_E_NOMEM;
        goto fail;
    }

    stride = ((u32) w * (u32) ncomp * (u32) bpc + 7u) / 8u;
    for (y = 0; y < (u32) h; y++) {
        u32 rowoff = y * stride;
        const u8 *row;
        s32 x;

        if (rowoff + stride > datalen) {
            /* Buffer ran out: fill this row and everything below it
               white, never reading past the buffer.                  */
            u32 fy, fx;

            for (fy = y; fy < (u32) h; fy++) {
                for (fx = 0; fx < (u32) w; fx++) {
                    pix[fy * (u32) w + fx] = 0x00ffffffu;
                }
            }
            break;
        }
        row = data + rowoff;
        for (x = 0; x < w; x++) {
            u32 word;

            if (imagemask) {
                u32 bit = img_sample(row, (u32) x, 1);
                int paint = (maskinvert ? (bit != 0) : (bit == 0));

                word = paint ? (fillrgb & 0x00ffffffu) : 0x00ffffffu;
            } else {
                u32 samp[4];
                int c;

                for (c = 0; c < ncomp && c < 4; c++) {
                    u32 raw = img_sample(row, (u32) x * (u32) ncomp +
                                         (u32) c, bpc);
                    samp[c] = kind == CS_INDEXED ? raw
                                                  : img_scale255(raw, bpc);
                }
                word = combine_pixel(kind, samp, lut, lutlen, hival,
                                     basencomp);
            }
            pix[y * (u32) w + x] = word;
        }
    }

    pdfbuf_free(&lutbuf);
    *outpix = pix;
    return PDF_OK;

fail:
    pdfbuf_free(&lutbuf);
    free(pix);
    return err;
}

/* --- inline image filter chain ------------------------------------------ */

/* Apply an inline image's own /F /DP filter chain to caller-supplied
   raw bytes (pdf_streamdata cannot be used here - the data does not
   live inside doc->buf).  Mirrors pdf_streamdata's structure: on an
   image-only stop filter, *isjpeg is set and out holds whatever bytes
   had been produced up to that point (the raw bytes themselves if
   DCT is the first/only filter).                                      */
static int
inline_filters(PdfDoc *doc, PdfObj *dict, const u8 *data, u32 dlen,
              PdfBuf *out, int *isjpeg, int *isjpx)
{
    PdfObj *filter = inline_get(doc, dict, "Filter", "F");
    PdfObj *parms = inline_get(doc, dict, "DecodeParms", "DP");
    PdfBuf tmp[2];
    const u8 *src = data;
    u32 srclen = dlen;
    int cur = -1;
    u32 nf, i;
    int err = PDF_OK;

    *isjpeg = 0;
    *isjpx = 0;
    memset(tmp, 0, sizeof tmp);
    nf = filter == NULL ? 0
       : filter->type == PDF_ARRAY ? pdf_arrlen(filter) : 1;

    for (i = 0; i < nf; i++) {
        PdfObj *f = filter->type == PDF_ARRAY
                    ? pdf_resolve(doc, pdf_arrget(filter, i)) : filter;
        PdfObj *pm = parms == NULL ? NULL
                   : parms->type == PDF_ARRAY
                     ? pdf_resolve(doc, pdf_arrget(parms, i)) : parms;
        const char *name;
        PdfBuf *dst = &tmp[cur == 0 ? 1 : 0];

        if (f == NULL || f->type != PDF_NAME) {
            err = PDF_E_SYNTAX;
            goto out;
        }
        name = (const char *) f->u.str.p;
        dst->len = 0;

        if (strcmp(name, "FlateDecode") == 0 || strcmp(name, "Fl") == 0) {
            err = pdf_inflate(src, srclen, dst);
        } else if (strcmp(name, "LZWDecode") == 0 ||
                   strcmp(name, "LZW") == 0) {
            int early = 1;
            PdfObj *ec = pdf_resolve(doc, pdf_dictget(pm, "EarlyChange"));

            if (ec) {
                early = pdfobj_int_of(ec);
            }
            err = pdf_lzw(src, srclen, early, dst);
        } else if (strcmp(name, "ASCII85Decode") == 0 ||
                   strcmp(name, "A85") == 0) {
            err = pdf_ascii85(src, srclen, dst);
        } else if (strcmp(name, "ASCIIHexDecode") == 0 ||
                   strcmp(name, "AHx") == 0) {
            err = pdf_asciihex(src, srclen, dst);
        } else if (strcmp(name, "RunLengthDecode") == 0 ||
                   strcmp(name, "RL") == 0) {
            err = pdf_rle(src, srclen, dst);
        } else if (strcmp(name, "DCTDecode") == 0 ||
                   strcmp(name, "DCT") == 0) {
            *isjpeg = 1;
            break;                       /* hand the caller what we have */
        } else if (strcmp(name, "JPXDecode") == 0) {
            *isjpx = 1;
            break;                       /* hand the caller what we have */
        } else if (strcmp(name, "CCITTFaxDecode") == 0 ||
                   strcmp(name, "CCF") == 0 ||
                   strcmp(name, "JBIG2Decode") == 0) {
            err = PDF_E_UNSUP;
            goto out;
        } else {
            err = PDF_E_UNSUP;
            goto out;
        }
        if (err) {
            goto out;
        }

        /* predictor applies to Flate and LZW output */
        if (pm && (strcmp(name, "FlateDecode") == 0 ||
                   strcmp(name, "Fl") == 0 ||
                   strcmp(name, "LZWDecode") == 0 ||
                   strcmp(name, "LZW") == 0)) {
            PdfObj *predobj = pdf_resolve(doc, pdf_dictget(pm, "Predictor"));
            int pred = pdfobj_int_of(predobj);

            if (pred > 1) {
                int colors = 1, bpc = 8, cols = 1;
                PdfObj *o;

                o = pdf_resolve(doc, pdf_dictget(pm, "Colors"));
                if (o) {
                    colors = pdfobj_int_of(o);
                }
                o = pdf_resolve(doc, pdf_dictget(pm, "BitsPerComponent"));
                if (o) {
                    bpc = pdfobj_int_of(o);
                }
                o = pdf_resolve(doc, pdf_dictget(pm, "Columns"));
                if (o) {
                    cols = pdfobj_int_of(o);
                }
                err = pdf_predict(dst->p, &dst->len, pred, colors, bpc,
                                  cols);
                if (err) {
                    goto out;
                }
            }
        }
        cur = cur == 0 ? 1 : 0;
        src = dst->p;
        srclen = dst->len;
    }

    err = pdfbuf_need(out, srclen);
    if (err == PDF_OK && srclen) {
        memcpy(out->p + out->len, src, srclen);
        out->len += srclen;
    }
out:
    pdfbuf_free(&tmp[0]);
    pdfbuf_free(&tmp[1]);
    return err;
}

/* --- public interface ---------------------------------------------------- */

/* The caller passes the XObject; we key the cache on the object
   number it came from, which pdf_objnum_of() recovers.              */

/* --- masks -----------------------------------------------------------

   Three ways a PDF says "part of this image is not there":

     /SMask     a greyscale image whose samples are the coverage
     /Mask      a 1-bit stencil, where a 1 sample means masked OUT
     /Mask      an array of colour ranges to treat as transparent

   All three end up as one byte of coverage per pixel of the base
   image, scaled up or down as needed - a soft mask is very often a
   different size from the image it applies to, which is the whole
   point of it being a separate image.                              */

/* Nearest-neighbour sample of a w x h byte plane at the position
   corresponding to (x, y) in a dw x dh image.                      */
static u8
plane_at(const u8 *p, int w, int h, int x, int y, int dw, int dh)
{
    int sx = dw > 0 ? (int) (((s64) x * w) / dw) : 0;
    int sy = dh > 0 ? (int) (((s64) y * h) / dh) : 0;

    if (sx < 0) sx = 0;
    if (sy < 0) sy = 0;
    if (sx >= w) sx = w - 1;
    if (sy >= h) sy = h - 1;
    return p[(u32) sy * (u32) w + (u32) sx];
}

/* Build the coverage plane straight from the mask's samples.

   A stencil is one bit a pixel at scan resolution, so it is routinely
   four times the size of the image it applies to - expanding it
   through the ordinary image path would cost a word a pixel, tens of
   megabytes, to carry one bit of information each.  Reading the
   samples here costs the packed rows and nothing else.

   Minifying is done by averaging the source footprint rather than
   picking one pixel out of it.  At a quarter scale a 300dpi glyph
   stroke is a fraction of a pixel wide, and nearest-neighbour
   sampling of it gives a scatter of dots; the average gives partial
   coverage, which is what makes the text legible when it is
   composited.                                                      */
static int
mask_plane_direct(PdfDoc *doc, PdfObj *mobj, int basew, int baseh,
                  int stencil, u8 **outp)
{
    PdfBuf buf = { 0 };
    char stopflt[16];
    PdfObj *o;
    s32 mw, mh, bpc;
    u32 rowbytes;
    u8 *plane;
    int *xmap = NULL, *ymap = NULL;
    int inv = 0, x, y, err;

    *outp = NULL;
    mw = pdfobj_int_of(pdf_resolve(doc, pdf_dictget(mobj, "Width")));
    mh = pdfobj_int_of(pdf_resolve(doc, pdf_dictget(mobj, "Height")));
    if (mw < 1 || mh < 1) {
        return PDF_E_SYNTAX;
    }
    if (num_nonzero(pdf_resolve(doc, pdf_dictget(mobj, "ImageMask")))) {
        bpc = 1;
    } else {
        bpc = pdfobj_int_of(pdf_resolve(doc, pdf_dictget(mobj,
                                                        "BitsPerComponent")));
        if (bpc != 1 && bpc != 8) {
            return PDF_E_UNSUP;         /* leave it to the pixel path  */
        }
        /* only a single-component mask can be read this way           */
        o = pdf_resolve(doc, pdf_dictget(mobj, "ColorSpace"));
        if (o != NULL) {
            int kind = CS_UNKNOWN, ncomp = 1;

            if (plain_cs_kind(doc, o, &kind, &ncomp) != PDF_OK || ncomp != 1) {
                return PDF_E_UNSUP;
            }
        }
    }
    o = pdf_resolve(doc, pdf_dictget(mobj, "Decode"));
    if (o != NULL && o->type == PDF_ARRAY && pdf_arrlen(o) >= 1) {
        inv = num_nonzero(pdf_resolve(doc, pdf_arrget(o, 0)));
    }

    err = pdf_streamdata(doc, mobj, &buf, stopflt);
    if (err != PDF_OK) {
        pdfbuf_free(&buf);
        return err;
    }
    if (stopflt[0] != 0) {
        if (strcmp(stopflt, "JBIG2Decode") != 0) {
            pdfbuf_free(&buf);
            return PDF_E_UNSUP;
        }
        {
            u8 *bits = NULL;
            u32 blen = 0;
            PdfBuf gbuf = { 0 };
            PdfObj *parms = pdf_resolve(doc, pdf_dictget(mobj, "DecodeParms"));
            PdfObj *g = NULL;

            if (parms != NULL && parms->type == PDF_DICT) {
                g = pdf_resolve(doc, pdf_dictget(parms, "JBIG2Globals"));
            }
            if (g != NULL && g->type == PDF_STREAM &&
                pdf_streamdata(doc, g, &gbuf, NULL) != PDF_OK) {
                pdfbuf_free(&gbuf);
            }
            err = pdfjbig2_decode(gbuf.p, gbuf.len, buf.p, buf.len,
                                  (int) mw, (int) mh, &bits, &blen);
            pdfbuf_free(&gbuf);
            pdfbuf_free(&buf);
            if (err != PDF_OK) {
                return err;
            }
            buf.p = bits;
            buf.len = blen;
            buf.cap = blen;
            bpc = 1;
        }
    }
    rowbytes = ((u32) mw * (u32) bpc + 7u) / 8u;
    if (buf.len < rowbytes * (u32) mh) {
        pdfbuf_free(&buf);
        return PDF_E_DATA;
    }
    plane = malloc((u32) basew * (u32) baseh);
    if (plane == NULL) {
        pdfbuf_free(&buf);
        return PDF_E_NOMEM;
    }
    /* Where each destination pixel's footprint starts, worked out
       once.  Doing it in the loop costs two 64-bit divisions per
       pixel, and a division on an ARM without one is a called
       routine: at a couple of million pixels that is most of the
       time this function takes.                                    */
    xmap = malloc(((u32) basew + 1) * sizeof *xmap);
    ymap = malloc(((u32) baseh + 1) * sizeof *ymap);
    if (xmap == NULL || ymap == NULL) {
        free(xmap);
        free(ymap);
        free(plane);
        pdfbuf_free(&buf);
        return PDF_E_NOMEM;
    }
    for (x = 0; x <= basew; x++) {
        xmap[x] = (int) (((s64) x * mw) / basew);
    }
    for (y = 0; y <= baseh; y++) {
        ymap[y] = (int) (((s64) y * mh) / baseh);
    }

    for (y = 0; y < baseh; y++) {
        int sy0 = ymap[y];
        int sy1 = ymap[y + 1];
        int ystep;

        if (sy1 <= sy0) {
            sy1 = sy0 + 1;
        }
        if (sy1 > mh) {
            sy1 = (int) mh;
        }
        ystep = (sy1 - sy0 + 7) / 8;    /* at most 8 rows sampled     */
        for (x = 0; x < basew; x++) {
            int sx0 = xmap[x];
            int sx1 = xmap[x + 1];
            u32 sum = 0, n = 0;
            int sx, sy, xstep;

            if (sx1 <= sx0) {
                sx1 = sx0 + 1;
            }
            if (sx1 > mw) {
                sx1 = (int) mw;
            }
            xstep = (sx1 - sx0 + 7) / 8;
            for (sy = sy0; sy < sy1; sy += ystep) {
                const u8 *row = buf.p + (u32) sy * rowbytes;

                for (sx = sx0; sx < sx1; sx += xstep) {
                    u32 v;

                    if (bpc == 1) {
                        v = (row[sx >> 3] >> (7 - (sx & 7))) & 1u;
                        if (inv) {
                            v ^= 1u;
                        }
                        /* a sample of 0 paints, and painted is the
                           part of the base image that is kept       */
                        sum += stencil ? (v ? 0u : 255u) : (v ? 255u : 0u);
                    } else {
                        v = row[sx];
                        if (inv) {
                            v = 255u - v;
                        }
                        sum += stencil ? (v < 128u ? 255u : 0u) : v;
                    }
                    n++;
                }
            }
            plane[(u32) y * (u32) basew + (u32) x] =
                (u8) (n ? sum / n : 0u);
        }
    }
    free(xmap);
    free(ymap);
    pdfbuf_free(&buf);
    *outp = plane;
    return PDF_OK;
}

/* Decode a mask image (soft or stencil) to a coverage plane the size
   of the base image.  stencil means 1-bit /ImageMask semantics.    */
static int
load_mask_plane(PdfDoc *doc, PdfObj *mobj, int basew, int baseh,
                int stencil, u8 **outp)
{
    PdfImg m;
    u8 *plane = NULL;
    u8 *src = NULL;
    int x, y, err;

    *outp = NULL;
    /* Ordinary masks are plain samples and are read as such; only a
       JPEG- or JPEG 2000-coded soft mask needs the pixel path.      */
    err = mask_plane_direct(doc, mobj, basew, baseh, stencil, outp);
    if (err == PDF_OK) {
        return PDF_OK;
    }
    if (err != PDF_E_UNSUP) {
        return err;
    }
    memset(&m, 0, sizeof m);
    /* A stencil mask is an ImageMask; loading it with a black fill
       gives 0 where it paints and white where it does not, which is
       all we need to tell the two apart.                           */
    err = pdfimg_load(doc, mobj, 0x000000u, &m);
    if (err != PDF_OK) {
        return err;
    }
    if (m.kind != PDFIMG_XRGB32 || m.pix == NULL || m.w < 1 || m.h < 1) {
        pdfimg_free(&m);
        return PDF_E_UNSUP;             /* a JPEG-coded mask: rare     */
    }
    src = malloc((u32) m.w * (u32) m.h);
    if (src == NULL) {
        pdfimg_free(&m);
        return PDF_E_NOMEM;
    }
    for (y = 0; y < m.h; y++) {
        for (x = 0; x < m.w; x++) {
            u32 p = m.pix[(u32) y * (u32) m.w + (u32) x];
            u32 lum = p & 0xFF;         /* grey, so any channel does  */

            /* A stencil paints where the sample is 0, and those are
               the pixels of the BASE image we must keep; where it
               did not paint, the base is masked out.  A soft mask is
               simply its own grey level.                           */
            src[(u32) y * (u32) m.w + (u32) x] =
                stencil ? (u8) (lum < 128 ? 255 : 0) : (u8) lum;
        }
    }
    plane = malloc((u32) basew * (u32) baseh);
    if (plane == NULL) {
        free(src);
        pdfimg_free(&m);
        return PDF_E_NOMEM;
    }
    for (y = 0; y < baseh; y++) {
        for (x = 0; x < basew; x++) {
            plane[(u32) y * (u32) basew + (u32) x] =
                plane_at(src, m.w, m.h, x, y, basew, baseh);
        }
    }
    free(src);
    pdfimg_free(&m);
    *outp = plane;
    return PDF_OK;
}

/* Colour-key masking: /Mask is an array of min/max pairs, one pair
   per colour component, in SOURCE sample values.  We only have the
   converted RGB by this point, so the ranges are applied to it -
   exact for the 8-bit device colour spaces this meets in practice. */
static int
colourkey_plane(PdfDoc *doc, PdfObj *arr, const u32 *pix, int w, int h,
                int bpc, u8 **outp)
{
    u32 n = pdf_arrlen(arr);
    s32 lo[3], hi[3];
    u8 *plane;
    int i, x, y;
    int maxv = (1 << bpc) - 1;

    *outp = NULL;
    if (n < 2 || n > 8 || (n & 1) != 0) {
        return PDF_E_UNSUP;
    }
    for (i = 0; i < 3; i++) {
        lo[i] = 0;
        hi[i] = -1;                     /* an impossible range        */
    }
    for (i = 0; i < (int) (n / 2) && i < 3; i++) {
        lo[i] = pdfobj_int_of(pdf_resolve(doc, pdf_arrget(arr, i * 2)));
        hi[i] = pdfobj_int_of(pdf_resolve(doc, pdf_arrget(arr, i * 2 + 1)));
        /* the ranges are in sample values; scale to 0..255           */
        if (maxv > 0 && maxv != 255) {
            lo[i] = lo[i] * 255 / maxv;
            hi[i] = hi[i] * 255 / maxv;
        }
    }
    plane = malloc((u32) w * (u32) h);
    if (plane == NULL) {
        return PDF_E_NOMEM;
    }
    for (y = 0; y < h; y++) {
        for (x = 0; x < w; x++) {
            u32 p = pix[(u32) y * (u32) w + (u32) x];
            s32 c[3];
            int inrange = 1;

            c[0] = (s32) (p & 0xFF);
            c[1] = (s32) ((p >> 8) & 0xFF);
            c[2] = (s32) ((p >> 16) & 0xFF);
            for (i = 0; i < 3; i++) {
                if (hi[i] < lo[i] || c[i] < lo[i] || c[i] > hi[i]) {
                    inrange = 0;
                    break;
                }
            }
            plane[(u32) y * (u32) w + (u32) x] = (u8) (inrange ? 0 : 255);
        }
    }
    *outp = plane;
    return PDF_OK;
}

/* Attach whatever mask the image dictionary asks for.  A failure to
   read the mask is not a failure to read the image: better a page
   with an opaque image on it than no page.                         */
static void
attach_mask(PdfDoc *doc, PdfObj *dict, PdfImg *img, int bpc)
{
    PdfObj *o;

    if (img->kind != PDFIMG_XRGB32 || img->pix == NULL) {
        return;                         /* JPEG passthrough: not ours */
    }
    o = pdf_resolve(doc, pdf_dictget(dict, "SMask"));
    if (o != NULL && o->type == PDF_STREAM) {
        u8 *plane = NULL;

        if (load_mask_plane(doc, o, img->w, img->h, 0, &plane) == PDF_OK) {
            img->alpha = plane;
        }
        return;
    }
    o = pdf_resolve(doc, pdf_dictget(dict, "Mask"));
    if (o == NULL) {
        return;
    }
    if (o->type == PDF_STREAM) {
        u8 *plane = NULL;

        if (load_mask_plane(doc, o, img->w, img->h, 1, &plane) == PDF_OK) {
            img->alpha = plane;
        }
    } else if (o->type == PDF_ARRAY) {
        u8 *plane = NULL;

        if (colourkey_plane(doc, o, img->pix, img->w, img->h, bpc,
                            &plane) == PDF_OK) {
            img->alpha = plane;
        }
    }
}

int
pdfimg_load(PdfDoc *doc, PdfObj *xobj, u32 fillrgb, PdfImg *img)
{
    PdfObj *wobj, *hobj, *bpcobj, *csobj, *imobj, *decobj;
    s32 w, h, bpc;
    int imagemask, maskinvert;
    char stopflt[16];
    PdfBuf buf = { 0 };
    int err;
    int hintw = img->maxw, hinth = img->maxh;

    memset(img, 0, sizeof *img);
    img->maxw = hintw;              /* set by the caller: keep it    */
    img->maxh = hinth;
    if (doc == NULL || xobj == NULL || xobj->type != PDF_STREAM) {
        return PDF_E_SYNTAX;
    }
    wobj   = pdf_resolve(doc, pdf_dictget(xobj, "Width"));
    hobj   = pdf_resolve(doc, pdf_dictget(xobj, "Height"));
    bpcobj = pdf_resolve(doc, pdf_dictget(xobj, "BitsPerComponent"));
    csobj  = pdf_resolve(doc, pdf_dictget(xobj, "ColorSpace"));
    imobj  = pdf_resolve(doc, pdf_dictget(xobj, "ImageMask"));
    decobj = pdf_resolve(doc, pdf_dictget(xobj, "Decode"));

    w = pdfobj_int_of(wobj);
    h = pdfobj_int_of(hobj);
    if (w < 1 || h < 1) {
        return PDF_E_SYNTAX;
    }
    imagemask = num_nonzero(imobj);
    bpc = imagemask ? 1 : pdfobj_int_of(bpcobj);
    if (!imagemask && bpc != 1 && bpc != 2 && bpc != 4 && bpc != 8 &&
        bpc != 16) {
        return PDF_E_UNSUP;
    }
    maskinvert = 0;
    if (imagemask && decobj && decobj->type == PDF_ARRAY &&
        pdf_arrlen(decobj) >= 1) {
        maskinvert = num_nonzero(pdf_arrget(decobj, 0));
    }

    /* Already decoded at this size?  The cache holds pixels only, so
       the mask is rebuilt here as well - it is cheap next to decoding
       the image, and returning cached pixels without it would make an
       image lose its transparency the second time it is drawn.

       The image is identified by where its stream sits in the file:
       always available, unique, and it does not depend on the resource
       entry being an indirect reference (it often is not, and the
       object number then comes back as zero).                      */
    {
        int slot = cache_find(doc, xobj->u.stm.off, hintw, hinth);

        if (slot >= 0) {
            u32 bytes = (u32) img_cache[slot].w *
                        (u32) img_cache[slot].h * 4;

            img->pix = malloc(bytes);
            if (img->pix != NULL) {
                memcpy(img->pix, img_cache[slot].pix, bytes);
                img->kind = PDFIMG_XRGB32;
                img->w = img_cache[slot].w;
                img->h = img_cache[slot].h;
                attach_mask(doc, xobj, img, (int) bpc);
                return PDF_OK;
            }
        }
    }

    err = pdf_streamdata(doc, xobj, &buf, stopflt);
    if (err) {
        pdfbuf_free(&buf);
        return err;
    }

    if (stopflt[0] != 0 && strcmp(stopflt, "JBIG2Decode") == 0) {
        /* JBIG2 is a whole codec, but its output is ordinary 1-bit
           image data, so decoding it here turns the stream back into
           something the expansion below can take.  A failure leaves
           stopflt set and falls into the refusal underneath.        */
        u8 *bits = NULL;
        u32 blen = 0;
        PdfBuf gbuf = { 0 };
        PdfObj *parms = pdf_resolve(doc, pdf_dictget(xobj, "DecodeParms"));
        PdfObj *g = NULL;

        if (parms != NULL && parms->type == PDF_ARRAY) {
            u32 i;

            for (i = 0; i < pdf_arrlen(parms) && g == NULL; i++) {
                PdfObj *e = pdf_resolve(doc, pdf_arrget(parms, i));

                if (e != NULL && e->type == PDF_DICT) {
                    g = pdf_resolve(doc, pdf_dictget(e, "JBIG2Globals"));
                }
            }
        } else if (parms != NULL) {
            g = pdf_resolve(doc, pdf_dictget(parms, "JBIG2Globals"));
        }
        if (g != NULL && g->type == PDF_STREAM) {
            if (pdf_streamdata(doc, g, &gbuf, NULL) != PDF_OK) {
                pdfbuf_free(&gbuf);
            }
        }
        err = pdfjbig2_decode(gbuf.p, gbuf.len, buf.p, buf.len,
                              (int) w, (int) h, &bits, &blen);
        pdfbuf_free(&gbuf);
        if (err == PDF_OK) {
            pdfbuf_free(&buf);
            buf.p = bits;
            buf.len = blen;
            buf.cap = blen;
            bpc = 1;
            stopflt[0] = 0;
        }
    }

    if (stopflt[0] != 0) {
        if (strcmp(stopflt, "DCTDecode") == 0) {
            /* Hand every JPEG to SpriteExtend.  MEASURED on an
               emulated StrongARM with a 2550x3300 scan: the OS takes
               ~19s, our own pdfjpg at quarter scale 26-33s - scaled
               decoding saves the IDCT and the colour conversion but
               not the Huffman pass, which dominates at that size and
               which SpriteExtend does in hand-written ARM.  It also
               handles CMYK and YCCK (1.88 restored the RGB
               approximation upstream libjpeg does not provide), so
               there is nothing left for us to add here.

               c/pdfjpg remains as the fallback when the OS refuses a
               file - see the backend, which tries JPEG_Info first.  */
            img->kind = PDFIMG_JPEG;
            img->w = w;
            img->h = h;
            img->jpegbuf = buf;          /* ownership moves to img */
            img->jpeg = img->jpegbuf.p;
            img->jpeglen = img->jpegbuf.len;
            return PDF_OK;
        }
        if (strcmp(stopflt, "JPXDecode") == 0) {
            /* JPEG 2000 carries its own geometry and colour space;
               the dict's /Width /Height /ColorSpace are advisory and
               may even be absent, so trust the codestream.          */
            int jw = 0, jh = 0;
            u32 *pix = NULL;

            err = pdfjpx_decode(buf.p, buf.len, img->maxw, img->maxh,
                                &jw, &jh, &pix);
            pdfbuf_free(&buf);
            if (err) {
                return err;
            }
            img->kind = PDFIMG_XRGB32;
            img->w = jw;
            img->h = jh;
            img->pix = pix;
            cache_put(doc, xobj->u.stm.off, hintw, hinth, jw, jh, pix);
            /* JPEG 2000 is what an MRC scan codes its foreground with,
               and that foreground is exactly the layer that carries a
               mask: attach it here too, not only on the plain path. */
            attach_mask(doc, xobj, img, 8);
            return PDF_OK;
        }
        pdfbuf_free(&buf);
        return PDF_E_UNSUP;
    }

    {
        u32 *pix = NULL;

        err = expand_pixels(doc, w, h, bpc, imagemask, maskinvert, fillrgb,
                            csobj, buf.p, buf.len, &pix);
        pdfbuf_free(&buf);
        if (err) {
            return err;
        }
        img->kind = PDFIMG_XRGB32;
        img->w = w;
        img->h = h;
        img->pix = pix;
        cache_put(doc, xobj->u.stm.off, hintw, hinth, (int) w, (int) h,
                  pix);
        /* the cache holds pixels only; the mask is rebuilt each time,
           which is cheap next to decoding the image itself         */
        attach_mask(doc, xobj, img, (int) bpc);
        return PDF_OK;
    }
}

int
pdfimg_inline(PdfDoc *doc, PdfObj *dict, const u8 *data, u32 dlen,
             u32 fillrgb, PdfImg *img)
{
    PdfObj *csobj, *decobj;
    s32 w, h, bpc;
    int imagemask, maskinvert, isjpeg, isjpx;
    PdfBuf buf = { 0 };
    int err;

    {
        int hw = img->maxw, hh = img->maxh;
        memset(img, 0, sizeof *img);
        img->maxw = hw;             /* set by the caller: keep it    */
        img->maxh = hh;
    }
    if (doc == NULL || dict == NULL) {
        return PDF_E_SYNTAX;
    }

    w = pdfobj_int_of(inline_get(doc, dict, "Width", "W"));
    h = pdfobj_int_of(inline_get(doc, dict, "Height", "H"));
    if (w < 1 || h < 1) {
        return PDF_E_SYNTAX;
    }
    imagemask = num_nonzero(inline_get(doc, dict, "ImageMask", "IM"));
    bpc = imagemask
        ? 1
        : pdfobj_int_of(inline_get(doc, dict, "BitsPerComponent", "BPC"));
    if (!imagemask && bpc != 1 && bpc != 2 && bpc != 4 && bpc != 8 &&
        bpc != 16) {
        return PDF_E_UNSUP;
    }
    csobj = inline_get(doc, dict, "ColorSpace", "CS");
    decobj = inline_get(doc, dict, "Decode", "D");

    maskinvert = 0;
    if (imagemask && decobj && decobj->type == PDF_ARRAY &&
        pdf_arrlen(decobj) >= 1) {
        maskinvert = num_nonzero(pdf_arrget(decobj, 0));
    }

    err = inline_filters(doc, dict, data, dlen, &buf, &isjpeg, &isjpx);
    if (err) {
        pdfbuf_free(&buf);
        return err;
    }

    if (isjpeg) {
        img->kind = PDFIMG_JPEG;
        img->w = w;
        img->h = h;
        img->jpegbuf = buf;              /* ownership moves to img */
        img->jpeg = img->jpegbuf.p;
        img->jpeglen = img->jpegbuf.len;
        return PDF_OK;
    }
    if (isjpx) {
        int jw = 0, jh = 0;
        u32 *pix = NULL;

        err = pdfjpx_decode(buf.p, buf.len, img->maxw, img->maxh,
                            &jw, &jh, &pix);
        pdfbuf_free(&buf);
        if (err) {
            return err;
        }
        img->kind = PDFIMG_XRGB32;
        img->w = jw;
        img->h = jh;
        img->pix = pix;
        return PDF_OK;
    }

    {
        u32 *pix = NULL;

        err = expand_pixels(doc, w, h, bpc, imagemask, maskinvert, fillrgb,
                            csobj, buf.p, buf.len, &pix);
        pdfbuf_free(&buf);
        if (err) {
            return err;
        }
        img->kind = PDFIMG_XRGB32;
        img->w = w;
        img->h = h;
        img->pix = pix;
        attach_mask(doc, dict, img, bpc);
        return PDF_OK;
    }
}

void
pdfimg_free(PdfImg *img)
{
    if (img == NULL) {
        return;
    }
    free(img->pix);
    free(img->alpha);
    pdfbuf_free(&img->jpegbuf);
    memset(img, 0, sizeof *img);
}
