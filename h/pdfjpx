#ifndef PDFJPX_H
#define PDFJPX_H

#include "pdftypes.h"

/* Decode a JP2- or raw-codestream-boxed JPEG 2000 image to XRGB32
   (red in bits 0-7, row 0 = top), matching PdfImg's pixel contract.
   wp and hp receive the dimensions, pixp a malloc'd w*h word buffer
   the caller owns.  Handles 1-component grey, 3-component RGB/YCC
   and 4-component CMYK, any bit depth (scaled to 8), subsampled
   components (replicated), and signed components (level-shifted).  */
int pdfjpx_decode(const u8 *src, u32 srclen, int *wp, int *hp,
                  u32 **pixp);

#endif
