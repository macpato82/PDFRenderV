  Licensed under the Common Development and Distribution License 1.0; see LICENSE.
*/

#ifndef PDFTIFF_H
#define PDFTIFF_H

#include "pdftypes.h"

/* Size of the first image, without decoding the pixels.             */
int pdftiff_size(const u8 *src, u32 len, int *w, int *h);

/* Decode the first image to a malloc'd XRGB32 buffer.               */
int pdftiff_decode(const u8 *src, u32 len, int *wp, int *hp, u32 **pixp);

#endif
