  Licensed under the Common Development and Distribution License 1.0; see LICENSE.
*/

#ifndef PDFPSD_H
#define PDFPSD_H

#include "pdftypes.h"

int pdfpsd_size(const u8 *src, u32 len, int *w, int *h);
int pdfpsd_decode(const u8 *src, u32 len, int *wp, int *hp, u32 **pixp);

#endif
