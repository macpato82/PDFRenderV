*/

#ifndef PDFBMP_H
#define PDFBMP_H

#include "pdftypes.h"

/* Width and height without decoding the pixels.                     */
int pdfbmp_size(const u8 *src, u32 len, int *w, int *h);

/* Decode to a malloc'd XRGB32 buffer the caller owns.               */
int pdfbmp_decode(const u8 *src, u32 len, int *wp, int *hp, u32 **pixp);

#endif
